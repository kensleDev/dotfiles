import { Hono } from 'hono';
import { streamSSE } from 'hono/streaming';
import { tryPromise } from '@julian-i/try-error';
import { createLogger } from '../lib/shared/utils/logger';
import { sseManager } from '../lib/shared/services/sse-manager';
import { eventBus } from '../lib/shared/services/event-bus';
import type {
	PrinterState,
	PrinterError,
	FilamentState
} from '../lib/printer/types/printer';
import type { Job } from '../lib/job/types/job';

const logger = createLogger('routes:events');
const app = new Hono();

// GET /api/events - SSE stream for real-time updates
app.get('/', async (c) => {
	return streamSSE(c, async (stream) => {
		const clientId = Math.random().toString(36).substring(2);
		let aborted = false;

		logger.info(`SSE client connected: ${clientId}`);

		// Add client to SSE manager
		sseManager.addClient(clientId, stream);

		// Send initial connection message
		await stream.writeSSE({
			event: 'connected',
			data: { clientId, timestamp: Date.now() }
		});

		// Set up abort handler
		stream.onAbort(() => {
			aborted = true;
			logger.info(`SSE client disconnected: ${clientId}`);
			sseManager.removeClient(clientId);
		});

		// Keep the stream alive with periodic ping messages
		// Using a shorter interval (10s) to prevent timeout
		while (!aborted) {
			await stream.writeSSE({
				event: 'ping',
				data: { timestamp: Date.now() }
			});
			// Wait 10 seconds before next ping or check for abort
			await new Promise((resolve) => setTimeout(resolve, 10000));
		}
	});
});

export default app;
