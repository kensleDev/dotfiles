const logger = createLogger('routes:jobs');
const app = new Hono();

// GET /api/jobs - List all jobs with optional filters
app.get('/', async (c) => {
  const status = c.req.query('status');
  const printer_id = c.req.query('printer_id');
  const limit = c.req.query('limit');
  const offset = c.req.query('offset');

  const filter: {
    status?: string | string[];
    printer_id?: number;
    limit?: number;
    offset?: number;
  } = {};

  if (status) {
    filter.status = status.includes(',') ? status.split(',') : status;
  }
  if (printer_id) {
    filter.printer_id = parseInt(printer_id);
  }
  if (limit) {
    filter.limit = parseInt(limit);
  }
  if (offset) {
    filter.offset = parseInt(offset);
  }

  const [result, error] = await tryPromise(getJobs(filter));

  if (error) {
    logger.error('Failed to get jobs', { error: error.message });
    return c.json({ error: 'Failed to get jobs', status: 'error' }, 500);
  }

  return c.json(result);
});

// GET /api/jobs/:id - Get single job
app.get('/:id', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid job ID', status: 'error' }, 400);
  }

  const [result, error] = await tryPromise(getJob(id));

  if (error) {
    logger.error('Failed to get job', { jobId: id, error: error.message });
    return c.json({ error: 'Failed to get job', status: 'error' }, 500);
  }

  if (!result) {
    return c.json({ error: 'Job not found', status: 'error' }, 404);
  }

  return c.json(result);
});

// POST /api/jobs - Create new job (multipart form upload)
app.post('/', async (c) => {
  const body = await c.req.parseBody();
  const file = body['file'] as File;

  if (!file) {
    return c.json({ error: 'No file provided', status: 'error' }, 400);
  }

  // Extract form fields
  const display_name = (body['display_name'] as string) || file.name;
  const assigned_printer = body['assigned_printer']
    ? parseInt(body['assigned_printer'] as string)
    : undefined;
  const loop_count = body['loop_count'] ? parseInt(body['loop_count'] as string) : undefined;
  const priority = body['priority'] ? parseInt(body['priority'] as string) : undefined;
  const clearing_method = (body['clearing_method'] as 'actuator' | 'gcode') || 'actuator';
  const cooldown_time = body['cooldown_time']
    ? parseInt(body['cooldown_time'] as string)
    : undefined;

  // TODO: Process the file and extract metadata
  // For now, create job with basic info

  const [result, error] = await tryPromise(
    createJob(
      {
        display_name,
        file_path: `/uploads/${file.name}`, // TODO: Save file properly
        assigned_printer: assigned_printer ?? null,
        loop_count: loop_count ?? 1,
        priority: priority ?? 5,
        clearing_method,
        cooldown_time: cooldown_time ?? null,
        processing_options: ['process_gcode']
      },
      {
        skipFilamentCheck: false
      }
    )
  );

  if (error) {
    logger.error('Failed to create job', { error: error.message });
    return c.json({ error: error.message, status: 'error' }, 500);
  }

  return c.json(result, 201);
});

// PUT /api/jobs/:id - Update job
const UpdateJobSchema = v.object({
  display_name: v.optional(v.string()),
  assigned_printer: v.optional(v.nullable(v.number())),
  status: v.optional(
    v.union([
      v.literal('pending'),
      v.literal('queued'),
      v.literal('uploading'),
      v.literal('printing'),
      v.literal('cooling'),
      v.literal('clearing'),
      v.literal('complete'),
      v.literal('failed'),
      v.literal('cancelled')
    ])
  ),
  loop_count: v.optional(v.number()),
  current_loop: v.optional(v.number()),
  priority: v.optional(v.number()),
  error_message: v.optional(v.nullable(v.string())),
  clearing_method: v.optional(v.union([v.literal('actuator'), v.literal('gcode')])),
  processing_options: v.optional(v.array(v.string())),
  cooldown_time: v.optional(v.nullable(v.number())),
  scheduled_at: v.optional(v.nullable(v.any()))
});

app.put('/:id', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid job ID', status: 'error' }, 400);
  }

  const body = await c.req.json();
  const [parsed, parseError] = v.safeParse(UpdateJobSchema, body);

  if (!parsed.success) {
    return c.json({ error: 'Invalid input', issues: parseError.issues, status: 'error' }, 400);
  }

  const input = parsed.output;

  // Parse scheduled_at if it's a string
  let scheduled_at: Date | null | undefined = undefined;
  if (input.scheduled_at !== undefined) {
    scheduled_at = input.scheduled_at ? new Date(input.scheduled_at) : null;
  }

  const [result, error] = await tryPromise(
    updateJob(id, {
      ...input,
      scheduled_at
    })
  );

  if (error) {
    logger.error('Failed to update job', { jobId: id, error: error.message });
    return c.json({ error: error.message || 'Failed to update job', status: 'error' }, 500);
  }

  if (!result) {
    return c.json({ error: 'Job not found', status: 'error' }, 404);
  }

  return c.json(result);
});

