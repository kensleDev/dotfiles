// POST /api/jobs/reorder - Reorder jobs
const ReorderSchema = v.object({
  jobIds: v.array(v.number())
});

app.post('/reorder', async (c) => {
  const body = await c.req.json();
  const [parsed, parseError] = v.safeParse(ReorderSchema, body);

  if (!parsed.success) {
    return c.json({ error: 'Invalid input', issues: parseError.issues, status: 'error' }, 400);
  }

  const [_, error] = await tryPromise(reorderJobs(parsed.output.jobIds));

  if (error) {
    logger.error('Failed to reorder jobs', { error: error.message });
    return c.json({ error: 'Failed to reorder jobs', status: 'error' }, 500);
  }

  return c.json({ success: true });
});

