/**
 * Scans GCode content for printer model metadata
 * Looks for "; printer_model = <name>" in CONFIG_BLOCK section
 *
 * @param gcode - GCode file content as string
 * @returns Detected printer type or null if not found
 */
export function detectPrinterTypeFromGcode(gcode: string): string | null {
	// Normalize line endings
	const normalizedGcode = gcode.replace(/\r\n/g, '\n').replace(/\r/g, '\n');

	// Look for CONFIG_BLOCK section
	const configMatch = normalizedGcode.match(/; CONFIG_BLOCK_START([\s\S]*?); CONFIG_BLOCK_END/);

	if (!configMatch) {
		return null;
	}

	const configBlock = configMatch[1];
	const printerModelMatch = configBlock.match(/; printer_model\s*=\s+(.+)/);

	if (!printerModelMatch) {
		return null;
	}

	// Extract printer name and normalize (handle case and spacing variations)
	let printerName = printerModelMatch[1].trim().toLowerCase();

	// First collapse multiple spaces to handle variations like "a1  mini"
	printerName = printerName.replace(/\s+/g, ' ').trim();

	// Map printer names to internal types
	const typeMap: Record<string, string> = {
		'bambu lab a1': 'A1',
		'bambu lab a1 mini': 'A1_MINI',
		'bambu lab p1s': 'P1S'
	};

	return typeMap[printerName] || null;
}

/**
 * Validates if a printer is compatible with a given printer type
 *
 * @param detectedType - The detected printer type from GCode
 * @param printerType - The printer's model_type
 * @returns true if compatible, false otherwise
 */
export function isPrinterCompatible(
	detectedType: string | null,
	printerType: string
): boolean {
	if (!detectedType) return true; // No detection = allow any printer
	return detectedType === printerType;
}
