import { createMutation, useQueryClient } from '@tanstack/svelte-query';
import { api } from '../client';
import type {
	Job,
	UpdateJobInput,
	ReorderJobsInput,
	BulkOperationResponse,
	SuccessResponse,
	DetectPrinterTypeInput,
	DetectPrinterTypeResponse
} from './types';

/**
 * Mutation hook for creating a new job via file upload
 */
export function useCreateJob() {
	const queryClient = useQueryClient();

	return createMutation(() => ({
		mutationFn: (formData: FormData) => api.postForm<Job>('/api/jobs', formData),
		onSuccess: () => {
			// Invalidate jobs list
			queryClient.invalidateQueries({ queryKey: ['jobs'] });
			// Invalidate queue status
			queryClient.invalidateQueries({ queryKey: ['queue'] });
			// Invalidate printers (printer status may change)
			queryClient.invalidateQueries({ queryKey: ['printers'] });
		}
	}));
}

/**
 * Mutation hook for updating a job
 */
export function useUpdateJob() {
	const queryClient = useQueryClient();

	return createMutation(() => ({
		mutationFn: (data: UpdateJobInput) => api.put<Job>(`/api/jobs/${data.id}`, data),
		onSuccess: (updatedJob) => {
			// Invalidate jobs list
			queryClient.invalidateQueries({ queryKey: ['jobs'] });
			// Update specific job cache
			queryClient.setQueryData(['jobs', updatedJob.id], updatedJob);
		}
	}));
}

/**
 * Mutation hook for deleting a job
 */
export function useDeleteJob() {
	const queryClient = useQueryClient();

	return createMutation(() => ({
		mutationFn: (id: number) => api.delete<SuccessResponse>(`/api/jobs/${id}`),
		onSuccess: (_, deletedId) => {
			// Invalidate jobs list
			queryClient.invalidateQueries({ queryKey: ['jobs'] });
			// Remove specific job from cache
			queryClient.removeQueries({ queryKey: ['jobs', deletedId] });
		}
	}));
}

/**
 * Mutation hook for cancelling a job
 */
export function useCancelJob() {
	const queryClient = useQueryClient();

	return createMutation(() => ({
		mutationFn: (id: number) => api.post<Job>(`/api/jobs/${id}/cancel`, {}),
		onSuccess: () => {
			// Invalidate jobs list
			queryClient.invalidateQueries({ queryKey: ['jobs'] });
			// Invalidate queue status
			queryClient.invalidateQueries({ queryKey: ['queue'] });
		}
	}));
}

/**
 * Mutation hook for reordering jobs
 */
export function useReorderJobs() {
	const queryClient = useQueryClient();

	return createMutation(() => ({
		mutationFn: (data: ReorderJobsInput) =>
			api.post<SuccessResponse>('/api/jobs/reorder', data),
		onSuccess: () => {
			// Invalidate jobs list to reflect new order
			queryClient.invalidateQueries({ queryKey: ['jobs'] });
		}
	}));
}

