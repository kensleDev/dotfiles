<script lang="ts">
	import PrinterCard from '../components/PrinterCard.svelte';
	import PrinterModal from '../components/PrinterModal.svelte';
	import { printersStore, type PrinterWithStatus } from '../stores/printers.svelte';
	import { IconPlus, IconTrash } from '@tabler/icons-svelte';
	import { onMount } from 'svelte';
	import { printers } from '@/api';
	import { createSseClient } from '@/api';
	import { createLogger } from '@/shared/utils/logger';

	const logger = createLogger('printers-page');

	let modalOpen = $state(false);
	let editingPrinter = $state<Record<string, unknown> | null>(null);
	let isLoading = $state(false);
	let error = $state('');

	// TanStack Query
	const printersQuery = printers.usePrinters(true);
	const deleteMutation = printers.useDeletePrinter();

	async function loadPrinters() {
		isLoading = true;
		error = '';
		try {
			const data = await printersQuery.refetch();
			printersStore.set(data.data || []);
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to load printers';
		} finally {
			isLoading = false;
		}
	}

	function openModal(printer = null) {
		editingPrinter = printer;
		modalOpen = true;
	}

	async function handleDeletePrinter(id: number) {
		if (!confirm('Are you sure you want to delete this printer?')) {
			return;
		}

		try {
			await deleteMutation.mutateAsync(id);
			printersStore.removePrinter(id);
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to delete printer';
		}
	}

	function setupEventSource() {
		const sseClient = createSseClient();

		sseClient.on('printer:connected', (data) => {
			printersStore.setConnected(data.printerId, true);
			printersStore.setConnecting(data.printerId, false);
		});

		sseClient.on('printer:disconnected', (data) => {
			printersStore.setConnected(data.printerId, false);
		});

		sseClient.on('printer:state', (data) => {
			printersStore.updatePrinterStatus(data.printerId, data);
		});

		sseClient.on('printer:filament', (data) => {
			printersStore.updateFilamentState(data.printerId, data);
		});

		sseClient.on('printer:error', (data) => {
			printersStore.setError(data.printerId, data.message);
		});

		return () => {
			sseClient.disconnect();
		};
	}

	onMount(() => {
		loadPrinters();
		setupEventSource();
	});
</script>

<svelte:head>
	<title>Printers - BambuFarm</title>
</svelte:head>

<div class="space-y-6">
	<div class="flex items-center justify-between">
		<div>
			<h1 class="text-3xl font-bold text-foreground">Printers</h1>
			<p class="mt-2 text-muted-foreground">
				Manage your Bambu Lab printers and monitor their status.
			</p>
		</div>
		<button
			onclick={() => openModal()}
			class="inline-flex items-center rounded-md border border-transparent bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background focus:outline-none"
		>
			<IconPlus size={18} class="mr-2" />
			Add Printer
		</button>
	</div>

	{#if error}
		<div class="rounded-md border border-destructive bg-destructive/10 p-4">
			<p class="text-sm font-medium text-destructive">{error}</p>
		</div>
	{/if}

	{#if isLoading}
		<div class="flex items-center justify-center py-12">
			<div class="h-8 w-8 animate-spin rounded-full border-4 border-border border-t-primary"></div>
		</div>
	{:else if printersStore.printers.length === 0}
		<div class="rounded-lg border border-dashed border-border bg-card p-8 text-center">
			<svg
				class="mx-auto h-12 w-12 text-muted-foreground"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
				></path>
			</svg>
			<h3 class="mt-2 text-sm font-medium text-foreground">No printers configured</h3>
			<p class="mt-1 text-sm text-muted-foreground">
				Add your Bambu Lab printers to get started with your print farm.
			</p>
		</div>
	{:else}
		<div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
			{#each printersStore.printers as printer (printer.id)}
				<div class="group relative">
					<PrinterCard {printer} />
					<button
						onclick={() => handleDeletePrinter(printer.id)}
						class="absolute top-2 right-2 rounded-md bg-card p-2 text-muted-foreground opacity-0 shadow-sm transition-opacity group-hover:opacity-100 hover:text-destructive"
						title="Delete printer"
					>
						<IconTrash size={18} />
					</button>
				</div>
			{/each}
		</div>
	{/if}

	<PrinterModal bind:open={modalOpen} bind:printer={editingPrinter} onSave={loadPrinters} />
</div>
