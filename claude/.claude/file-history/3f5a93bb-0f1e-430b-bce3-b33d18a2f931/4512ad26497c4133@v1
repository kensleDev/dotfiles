<script lang="ts">
	import { CameraFeed } from '@/shared';
	import {
		IconArrowLeft,
		IconLoader2,
		IconPlayerPause,
		IconPlayerPlay,
		IconPlayerStop
	} from '@tabler/icons-svelte';
	import { onMount } from 'svelte';
	import type { Printer, PrinterState } from '../types/printer';
	import type { Camera } from '@/types/camera';
	import { cameraSelectionStore } from '../stores/camera-selection.svelte';
	import { printers, cameras } from '@/api';
	import { createSseClient } from '@/api';
	import { createLogger } from '@/shared/utils/logger';

	const logger = createLogger('PrinterDetailPage');

	interface Props {
		printerId: number;
	}

	let { printerId }: Props = $props();

	let printer = $state<Printer | null>(null);
	let printerState = $state<PrinterState | null>(null);
	let isLoading = $state(true);
	let error = $state<string | null>(null);
	let gcodeInput = $state('');

	// Camera state
	let camerasList = $state<Camera[]>([]);
	let defaultCameraId = $state<number | null>(null);
	let selectedCameraId = $state<number | null>(null);
	let camerasLoaded = $state(false);

	// TanStack Query
	const printerQuery = printers.usePrinter(printerId);
	const camerasQuery = cameras.usePrinterCameras(printerId);
	const commandMutation = printers.useSendPrinterCommand();

	// Derived camera stream URL
	let streamUrl = $derived(() => {
		const apiBase = import.meta.env.VITE_HONO_API_URL || 'http://localhost:3000';
		if (selectedCameraId !== null) {
			return `${apiBase}/api/cameras/${selectedCameraId}/stream`;
		}
		// Fallback to old endpoint for backward compatibility
		return `${apiBase}/api/printers/${printerId}/camera`;
	});

	// Detect active print based on multiple indicators, not just status
	let hasActivePrint = $derived(
		printerState &&
			(printerState.status === 'PRINTING' ||
				printerState.status === 'PAUSED' ||
				printerState.status === 'PREPARE' ||
				(printerState.currentFile && (printerState.layerCount > 0 || printerState.progress > 0)))
	);

	onMount(async () => {
		await Promise.all([loadPrinter(), loadCameras()]);
		setupEventSource();
	});

	function setupEventSource() {
		const sseClient = createSseClient();

		sseClient.on('printer:state', (data) => {
			if (data.printerId === printerId) {
				printerState = data;
			}
		});

		sseClient.on('printer:filament', (data) => {
			if (data.printerId === printerId && printerState) {
				printerState = { ...printerState, filament: data };
			}
		});

		return () => {
			sseClient.disconnect();
		};
	}

	async function loadPrinter(): Promise<void> {
		isLoading = true;
		error = null;

		try {
			const data = await printerQuery.refetch();
			printer = data.data as Printer;
			printerState = (data.data?.status as PrinterState) || null;
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to load printer';
		} finally {
			isLoading = false;
		}
	}

	async function loadCameras(): Promise<void> {
		try {
			const data = await camerasQuery.refetch();
			camerasList = data.data?.cameras || [];
			defaultCameraId = data.data?.defaultCameraId || null;

			// Select camera using store logic (last-viewed > default > first)
			const cameraIds = camerasList.map((c) => c.id);
			const selected = cameraSelectionStore.getSelectedCamera(
				printerId,
				defaultCameraId,
				cameraIds
			);
			selectedCameraId = selected;

			camerasLoaded = true;
			logger.info('Loaded cameras', {
				cameraCount: camerasList.length,
				selectedCameraId
			});
		} catch (err) {
			logger.error('Failed to load cameras', {
				error: err instanceof Error ? err.message : String(err)
			});
			camerasLoaded = true;
		}
	}

	function handleCameraChange(cameraId: number): void {
		selectedCameraId = cameraId;
		cameraSelectionStore.selectCamera(printerId, cameraId);
		logger.info('Camera changed', { printerId, cameraId });
	}

	async function handleCommand(type: 'pause' | 'resume' | 'stop'): Promise<void> {
		try {
			await commandMutation.mutateAsync({ printerId, type });
			await loadPrinter();
		} catch (err) {
			logger.error('Failed to send command', { err, type });
		}
	}

	async function handleGcode(): Promise<void> {
		if (!gcodeInput.trim()) return;

		try {
			await commandMutation.mutateAsync({ printerId, type: 'gcode', gcode: gcodeInput });
			gcodeInput = '';
			await loadPrinter();
		} catch (err) {
			logger.error('Failed to send G-code', { err, gcode: gcodeInput });
		}
	}

	function getStatusColor(status: string): string {
		switch (status) {
			case 'PRINTING':
				return 'bg-green-500';
			case 'IDLE':
				return 'bg-yellow-500';
			case 'PAUSED':
				return 'bg-orange-500';
			case 'ERROR':
				return 'bg-red-500';
			case 'OFFLINE':
				return 'bg-muted-foreground';
			default:
				return 'bg-muted-foreground';
		}
	}

	function getStatusText(status: string): string {
		switch (status) {
			case 'PRINTING':
				return 'Printing';
			case 'IDLE':
				return 'Idle';
			case 'PAUSED':
				return 'Paused';
			case 'ERROR':
				return 'Error';
			case 'OFFLINE':
				return 'Offline';
			case 'PREPARE':
				return 'Preparing';
			case 'FINISH':
				return 'Finished';
			case 'STOP':
				return 'Stopped';
			default:
				return 'Unknown';
		}
	}

	function formatTime(seconds: number): string {
		const hours = Math.floor(seconds / 3600);
		const minutes = Math.floor((seconds % 3600) / 60);
		if (hours > 0) {
			return `${hours}h ${minutes}m`;
		}
		return `${minutes}m`;
	}
</script>

<div class="min-h-screen bg-background">
	<div class="mx-auto max-w-7xl px-4 py-8">
		{#if isLoading}
			<div class="flex items-center justify-center">
				<IconLoader2 class="h-12 w-12 animate-spin text-muted-foreground" />
			</div>
		{:else if error}
			<div class="rounded-md border border-destructive bg-destructive/10 p-4">
				<p class="text-destructive">{error}</p>
				<button
					onclick={loadPrinter}
					class="mt-4 rounded-md bg-destructive px-4 py-2 text-destructive-foreground hover:bg-destructive/90"
				>
					Retry
				</button>
			</div>
		{:else if printer}
			<div class="mb-6">
				<button
					onclick={() => {
						window.location.href = '/printers';
					}}
					class="inline-flex items-center space-x-2 text-sm text-muted-foreground hover:text-foreground"
				>
					<IconArrowLeft size={16} />
					<span>Back to Printers</span>
				</button>
			</div>

			<div class="mb-8">
				<div class="flex items-center justify-between">
					<div>
						<h1 class="text-3xl font-bold text-foreground">{printer.name}</h1>
						<p class="mt-1 text-muted-foreground">{printer.model_type} - {printer.ip}</p>
					</div>
					{#if printerState}
						<div class="flex items-center space-x-2">
							<span class="flex h-4 w-4">
								<span
									class="absolute inline-flex h-4 w-4 animate-ping rounded-full {getStatusColor(
										printerState.status
									)} opacity-75"
								></span>
								<span
									class="relative inline-flex h-4 w-4 rounded-full {getStatusColor(
										printerState.status
									)}"
								></span>
							</span>
							<span class="text-lg font-medium text-muted-foreground"
								>{getStatusText(printerState.status)}</span
							>
						</div>
					{/if}
				</div>
			</div>

			<div class="grid gap-6 lg:grid-cols-2">
				<div>
					<h2 class="mb-4 text-xl font-semibold text-foreground">Camera Feed</h2>
					<div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
						{#if camerasLoaded && camerasList.length > 0 && selectedCameraId !== null}
							<!-- Multi-camera mode -->
							<CameraFeed
								{printerId}
								streamUrl={streamUrl()}
								autoStart={true}
								showControls={true}
								className=""
								availableCameras={camerasList}
								{selectedCameraId}
								onCameraChange={handleCameraChange}
							/>
						{:else}
							<!-- Fallback to legacy single-camera mode -->
							<CameraFeed
								{printerId}
								streamUrl={`/api/printers/${printerId}/camera`}
								autoStart={true}
								showControls={true}
								className=""
							/>
						{/if}
					</div>
				</div>

				<div>
					<h2 class="mb-4 text-xl font-semibold text-foreground">Status</h2>
					<div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
						<div class="p-6">
							{#if printerState?.currentFile}
								<div class="mb-6">
									<p class="text-sm font-medium text-muted-foreground">Current File</p>
									<p class="mt-1 text-lg font-semibold text-foreground">
										{printerState.currentFile}
									</p>
								</div>
							{/if}

							{#if hasActivePrint && printerState}
								<div class="mb-6">
									<div class="flex items-center justify-between">
										<p class="text-sm font-medium text-muted-foreground">Progress</p>
										<p class="text-lg font-semibold text-foreground">
											{printerState.progress.toFixed(1)}%
										</p>
									</div>
									<div class="mt-3 h-4 w-full rounded-full bg-muted">
										<div
											class="h-4 rounded-full bg-primary transition-all duration-300"
											style="width: {printerState.progress}%"
										></div>
									</div>
									{#if printerState.remainingTime > 0}
										<p class="mt-2 text-muted-foreground">
											~{formatTime(printerState.remainingTime)} remaining
										</p>
									{/if}
								</div>
							{/if}

							<div class="grid grid-cols-3 gap-4 rounded-lg bg-muted/50 p-4">
								<div>
									<p class="text-sm font-medium text-muted-foreground">Bed</p>
									<p class="mt-1 text-lg font-semibold text-foreground">
										{printerState?.bedTemp.toFixed(0) ?? 0}C
										{#if printerState?.bedTargetTemp}
											<span class="text-muted-foreground"
												>/ {printerState.bedTargetTemp.toFixed(0)}C</span
											>
										{/if}
									</p>
								</div>
								<div>
									<p class="text-sm font-medium text-muted-foreground">Nozzle</p>
									<p class="mt-1 text-lg font-semibold text-foreground">
										{printerState?.nozzleTemp.toFixed(0) ?? 0}C
										{#if printerState?.nozzleTargetTemp}
											<span class="text-muted-foreground"
												>/ {printerState.nozzleTargetTemp.toFixed(0)}C</span
											>
										{/if}
									</p>
								</div>
								<div>
									<p class="text-sm font-medium text-muted-foreground">Chamber</p>
									<p class="mt-1 text-lg font-semibold text-foreground">
										{printerState?.chamberTemp.toFixed(0) ?? 0}C
										{#if printerState?.chamberTargetTemp}
											<span class="text-muted-foreground"
												>/ {printerState.chamberTargetTemp.toFixed(0)}C</span
											>
										{/if}
									</p>
								</div>
							</div>

							{#if printerState?.totalLayers && printerState.totalLayers > 0}
								<div class="mt-4 text-center">
									<p class="text-muted-foreground">
										Layer {printerState.layerCount ?? 0} / {printerState.totalLayers}
									</p>
								</div>
							{/if}
						</div>
					</div>

					<h2 class="mt-6 mb-4 text-xl font-semibold text-foreground">Controls</h2>
					<div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
						<div class="p-6">
							<div class="flex items-center space-x-2">
								{#if printerState?.status === 'PRINTING' || printerState?.status === 'PAUSED'}
									{#if printerState.status === 'PRINTING'}
										<button
											onclick={() => handleCommand('pause')}
											disabled={commandMutation.isPending}
											class="flex-1 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:bg-muted"
										>
											<div class="flex items-center justify-center space-x-2">
												<IconPlayerPause size={16} />
												<span>Pause</span>
											</div>
										</button>
									{:else}
										<button
											onclick={() => handleCommand('resume')}
											disabled={commandMutation.isPending}
											class="flex-1 rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-green-700 disabled:cursor-not-allowed disabled:bg-muted"
										>
											<div class="flex items-center justify-center space-x-2">
												<IconPlayerPlay size={16} />
												<span>Resume</span>
											</div>
										</button>
									{/if}
								{/if}
								{#if hasActivePrint || (printerState?.status !== 'IDLE' && printerState?.status !== 'OFFLINE')}
									<button
										onclick={() => handleCommand('stop')}
										disabled={commandMutation.isPending}
										class="flex-1 rounded-md bg-destructive px-4 py-2 text-sm font-medium text-destructive-foreground hover:bg-destructive/90 disabled:cursor-not-allowed disabled:bg-muted"
									>
										<div class="flex items-center justify-center space-x-2">
											<IconPlayerStop size={16} />
											<span>Stop</span>
										</div>
									</button>
								{/if}
							</div>
						</div>
					</div>

					<h2 class="mt-6 mb-4 text-xl font-semibold text-foreground">Manual G-code</h2>
					<div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
						<div class="p-6">
							<form
								onsubmit={(e) => {
									e.preventDefault();
									handleGcode();
								}}
							>
								<div class="flex space-x-2">
									<input
										type="text"
										bind:value={gcodeInput}
										placeholder="Enter G-code (e.g., G28 X Y)"
										class="flex-1 rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:ring-offset-background focus:outline-none"
										disabled={commandMutation.isPending}
									/>
									<button
										type="submit"
										disabled={commandMutation.isPending || !gcodeInput.trim()}
										class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-muted"
									>
										Send
									</button>
								</div>
							</form>
						</div>
					</div>

					<h2 class="mt-6 mb-4 text-xl font-semibold text-foreground">Actuator Test</h2>
					<div class="overflow-hidden rounded-lg border border-border bg-card p-6 shadow-sm">
						<p class="text-sm text-muted-foreground">
							Actuator testing controls will be available in Phase 4.
						</p>
					</div>
				</div>
			</div>
		{/if}
	</div>
</div>
