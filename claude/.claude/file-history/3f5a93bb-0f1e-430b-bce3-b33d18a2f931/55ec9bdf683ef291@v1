<script lang="ts">
	import PrinterCard from '../components/PrinterCard.svelte';
	import PrinterModal from '../components/PrinterModal.svelte';
	import { printers } from '@/api';
	import { createSseClient } from '@/api';
	import type { PrinterWithStatus } from '@/api/printers';
	import { onMount } from 'svelte';
	import { useQueryClient } from '@tanstack/svelte-query';
	import { createLogger } from '@/shared/utils/logger';

	const logger = createLogger('dashboard-page');

	// Use TanStack Query for fetching printers
	const printersQuery = printers.usePrinters(true);
	const queryClient = useQueryClient();

	let modalOpen = $state(false);
	let editingPrinter = $state<PrinterWithStatus | null>(null);
	let alertMessage = $state('');
	let alertType = $state<'info' | 'error'>('info');

	// Local reactive state derived from query data
	let printerList = $derived<PrinterWithStatus[]>(printersQuery.data ?? []);
	let isLoading = $derived(printersQuery.isLoading);
	let error = $derived(printersQuery.isError ? (printersQuery.error?.message ?? 'Failed to load printers') : '');

	// Computed counts
	let activeCount = $derived(
		printerList.filter((p) => p.status?.status === 'PRINTING').length
	);
	let idleCount = $derived(
		printerList.filter((p) => p.status?.status === 'IDLE').length
	);
	let errorCount = $derived(
		printerList.filter((p) => p.status?.status === 'ERROR').length
	);

	function openModal(printer: PrinterWithStatus | null = null) {
		editingPrinter = printer;
		modalOpen = true;
	}

	onMount(() => {
		// Setup SSE connection
		const sseClient = createSseClient('/api/events', {
			onPrinterConnected: (data) => {
				logger.info('Printer connected', { printerId: data.printerId });
				// Invalidate printers query to refresh data
				queryClient.invalidateQueries({ queryKey: ['printers'] });
				alertMessage = `Printer connected`;
				alertType = 'info';
				setTimeout(() => {
					alertMessage = '';
				}, 3000);
			},
			onPrinterDisconnected: (data) => {
				logger.info('Printer disconnected', { printerId: data.printerId });
				queryClient.invalidateQueries({ queryKey: ['printers'] });
				alertMessage = `Printer disconnected`;
				alertType = 'error';
				setTimeout(() => {
					alertMessage = '';
				}, 5000);
			},
			onPrinterState: (data) => {
				// Update printer status in cache
				queryClient.setQueryData(['printers', data.printerId], (existing: PrinterWithStatus | undefined) => {
					if (!existing) return existing;
					return {
						...existing,
						status: {
							status: data.status as any,
							progress: data.progress,
							remainingTime: data.remainingTime,
							currentFile: data.currentFile,
							bedTemp: data.bedTemp,
							bedTargetTemp: data.bedTargetTemp,
							nozzleTemp: data.nozzleTemp,
							nozzleTargetTemp: data.nozzleTargetTemp,
							chamberTemp: data.chamberTemp,
							chamberTargetTemp: data.chamberTargetTemp,
							layerCount: data.layerCount,
							totalLayers: data.totalLayers,
							errorCode: data.errorCode,
							errorMessage: data.errorMessage,
							lastUpdate: data.lastUpdate,
							filament: data.filament
						}
					};
				});
			},
			onPrinterError: (data) => {
				logger.error('Printer error', { printerId: data.printerId, error: data.errorMessage });
				alertMessage = `Printer error: ${data.errorMessage}`;
				alertType = 'error';
				setTimeout(() => {
					alertMessage = '';
				}, 5000);
			},
			onError: () => {
				logger.error('SSE connection error');
				alertMessage = 'Connection to server lost. Please refresh.';
				alertType = 'error';
			}
		});

		return () => {
			sseClient.close();
		};
	});
</script>

<svelte:head>
	<title>Dashboard - BambuFarm</title>
</svelte:head>

<div class="space-y-6">
	<div>
		<h1 class="text-3xl font-bold text-foreground">Dashboard</h1>
		<p class="mt-2 text-muted-foreground">
			Monitor your print farm status and manage your Bambu Lab printers.
		</p>
	</div>

	{#if alertMessage}
		<div
			class="rounded-md {alertType === 'error'
				? 'border border-destructive bg-destructive/10'
				: 'border border-primary bg-primary/10'} p-4"
			role="alert"
		>
			<p class="text-sm font-medium {alertType === 'error' ? 'text-destructive' : 'text-primary'}">
				{alertMessage}
			</p>
		</div>
	{/if}

	{#if error}
		<div class="rounded-md border border-destructive bg-destructive/10 p-4">
			<p class="text-sm font-medium text-destructive">{error}</p>
		</div>
	{/if}

	<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
		<div class="rounded-lg border border-border bg-card p-6 shadow-sm">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-muted-foreground">Active Prints</p>
					<p class="mt-1 text-3xl font-bold text-foreground">{activeCount}</p>
				</div>
				<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10">
					<svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
						></path>
					</svg>
				</div>
			</div>
		</div>

		<div class="rounded-lg border border-border bg-card p-6 shadow-sm">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-muted-foreground">Idle Printers</p>
					<p class="mt-1 text-3xl font-bold text-foreground">{idleCount}</p>
				</div>
				<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-muted">
					<svg
						class="h-6 w-6 text-foreground"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
						></path>
					</svg>
				</div>
			</div>
		</div>

		<div class="rounded-lg border border-border bg-card p-6 shadow-sm">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-muted-foreground">Errors</p>
					<p class="mt-1 text-3xl font-bold text-foreground">{errorCount}</p>
				</div>
				<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-destructive/10">
					<svg
						class="h-6 w-6 text-destructive"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
						></path>
					</svg>
				</div>
			</div>
		</div>

		<div class="rounded-lg border border-border bg-card p-6 shadow-sm">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-sm font-medium text-muted-foreground">Total Printers</p>
					<p class="mt-1 text-3xl font-bold text-foreground">{printerList.length}</p>
				</div>
				<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-accent">
					<svg
						class="h-6 w-6 text-accent-foreground"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
						></path>
					</svg>
				</div>
			</div>
		</div>
	</div>

	{#if isLoading}
		<div class="flex items-center justify-center py-12">
			<div class="h-8 w-8 animate-spin rounded-full border-4 border-border border-t-primary"></div>
		</div>
	{:else if printerList.length === 0}
		<div class="rounded-lg border border-dashed border-border bg-card p-8 text-center">
			<svg
				class="mx-auto h-12 w-12 text-muted-foreground"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
				></path>
			</svg>
			<h3 class="mt-2 text-sm font-medium text-foreground">No printers configured</h3>
			<p class="mt-1 text-sm text-muted-foreground">Get started by adding your first printer.</p>
			<button
				onclick={() => openModal()}
				class="mt-6 inline-flex items-center rounded-md border border-transparent bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background focus:outline-none"
			>
				Add Printer
			</button>
		</div>
	{:else}
		<div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
			{#each printerList as printer (printer.id)}
				<PrinterCard {printer} />
			{/each}
		</div>
	{/if}

	<PrinterModal bind:open={modalOpen} bind:printer={editingPrinter} />
</div>
