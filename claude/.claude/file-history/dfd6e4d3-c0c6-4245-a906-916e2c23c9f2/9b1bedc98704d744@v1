import { createLogger } from '../utils/logger';
import { mqttManager } from '../../printer/services/mqtt-manager';
import { queueProcessor } from '../../queue/services/queue-processor';
import { getDB, printers } from '../../db';
import { eq } from 'drizzle-orm';
import { tryPromise } from '@julian-i/try-error';

const logger = createLogger('service-initializer');

/**
 * Service initialization status
 */
export interface ServiceStatus {
	name: string;
	status: 'running' | 'stopped' | 'error';
	error?: string;
	startedAt?: Date;
}

/**
 * Initialize all services on application startup
 *
 * This function:
 * 1. Connects to all configured printers via MQTT
 * 2. Sets up event listeners for printer state changes
 * 3. Initializes the queue processor (when implemented)
 * 4. Prepares Home Assistant connection (when implemented)
 */
export async function initializeServices(): Promise<ServiceStatus[]> {
	const statuses: ServiceStatus[] = [];
	logger.info('Initializing services...');

	// Initialize MQTT Manager
	try {
		logger.info('Initializing MQTT manager...');

		// Get all configured printers from database
		const db = getDB();
		const [printerList, printerError] = await tryPromise(
			db.select().from(printers).where(eq(printers.enabled, true))
		);

		if (printerError) {
			throw printerError;
		}

		logger.info(`Found ${printerList.length} enabled printers`);

		// Connect to each printer
		let connectedCount = 0;
		for (const printer of printerList) {
			try {
				const success = await mqttManager.connectPrinter(printer);
				if (success) {
					connectedCount++;
					logger.info(`Connected to printer: ${printer.name} (${printer.id})`);
				} else {
					logger.warn(`Failed to connect to printer: ${printer.name} (${printer.id})`);
				}
			} catch (error) {
				logger.error(`Error connecting to printer ${printer.id}`, { error });
			}
		}

		statuses.push({
			name: 'mqtt-manager',
			status: 'running',
			startedAt: new Date()
		});

		logger.info(`MQTT manager initialized: ${connectedCount}/${printerList.length} printers connected`);
	} catch (error) {
		logger.error('Failed to initialize MQTT manager', { error });
		statuses.push({
			name: 'mqtt-manager',
			status: 'error',
			error: error instanceof Error ? error.message : 'Unknown error'
		});
	}

	// Initialize Queue Processor (stub - to be implemented)
	try {
		logger.info('Queue processor initialization not yet implemented');
		statuses.push({
			name: 'queue-processor',
			status: 'stopped',
			error: 'Not implemented'
		});
	} catch (error) {
		logger.error('Failed to initialize queue processor', { error });
		statuses.push({
			name: 'queue-processor',
			status: 'error',
			error: error instanceof Error ? error.message : 'Unknown error'
		});
	}

	// Initialize Home Assistant (stub - to be implemented)
	try {
		logger.info('Home Assistant initialization not yet implemented');
		statuses.push({
			name: 'homeassistant',
			status: 'stopped',
			error: 'Not implemented'
		});
	} catch (error) {
		logger.error('Failed to initialize Home Assistant', { error });
		statuses.push({
			name: 'homeassistant',
			status: 'error',
			error: error instanceof Error ? error.message : 'Unknown error'
		});
	}

	// Initialize Camera Proxy (stub - to be implemented)
	try {
		logger.info('Camera proxy initialization not yet implemented');
		statuses.push({
			name: 'camera-proxy',
			status: 'stopped',
			error: 'Not implemented'
		});
	} catch (error) {
		logger.error('Failed to initialize camera proxy', { error });
		statuses.push({
			name: 'camera-proxy',
			status: 'error',
			error: error instanceof Error ? error.message : 'Unknown error'
		});
	}

	return statuses;
}

/**
 * Shutdown all services gracefully
 */
export async function shutdownServices(): Promise<void> {
	logger.info('Shutting down services...');

	// Disconnect all MQTT connections
	try {
		const printerIds = mqttManager.getAllConnectedPrinters();
		logger.info(`Disconnecting ${printerIds.length} printers...`);

		for (const printerId of printerIds) {
			await mqttManager.disconnectPrinter(printerId);
		}

		logger.info('All printers disconnected');
	} catch (error) {
		logger.error('Error disconnecting printers', { error });
	}

	// Stop queue processor (when implemented)
	// Stop Home Assistant connection (when implemented)
	// Stop camera proxy (when implemented)

	logger.info('All services shut down');
}
