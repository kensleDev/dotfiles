/**
 * Home Assistant WebSocket client singleton
 * Manages WebSocket connection to Home Assistant for real-time device control
 */

import { createConnection, subscribeEntities } from 'home-assistant-js-websocket';
import { getEnv } from '../../../env';
import { createLogger } from '../../shared/utils/logger';
import { tryCatch, tryPromise } from '@julian-i/try-error';
import type { Connection } from 'home-assistant-js-websocket';
import type {
  UnsubscribeFunc,
  MessageBase,
  HassEntities,
  HassEntity
} from 'home-assistant-js-websocket';
import type { EntityState, ConnectionStatus } from '../types';

const logger = createLogger('homeassistant-client');

interface HAConnection {
  connection: Connection;
  entities: HassEntities;
  subscriptionUnsubscribe?: UnsubscribeFunc;
  connectionStatus: ConnectionStatus;
  reconnectAttempts: number;
  reconnectTimer?: NodeJS.Timeout;
}

class HomeAssistantClient {
  private connection: HAConnection | null = null;
  private readonly MAX_RECONNECT_ATTEMPTS = 10;
  private readonly INITIAL_RECONNECT_DELAY = 2000;

  /**
   * Connect to Home Assistant via WebSocket
   */
  async connect(): Promise<boolean> {
    const haUrl = getEnv().homeAssistantUrl;
    const haToken = getEnv().homeAssistantToken;

    if (!haUrl || !haToken) {
      logger.warn('Home Assistant URL or token not configured');
      return false;
    }

    if (this.connection) {
      logger.info('Already connected to Home Assistant, disconnecting first');
      this.disconnect();
    }

    logger.info('Connecting to Home Assistant', { url: haUrl });

    const connectionStatus: ConnectionStatus = {
      connected: false,
      connecting: true,
      lastError: null,
      lastConnected: null
    };

    // Create custom auth object for long-lived access token
    const auth = {
      type: 'long_lived_access_token',
      access_token: haToken,
      expiresIn: -1,
      // Add required auth properties
      async wsUrl() {
        return haUrl.replace('http', 'ws');
      },
      async accessToken() {
        return haToken;
      },
      async refreshAccessToken() {
        return haToken;
      },
      data: { haUrl, hassUrl: haUrl, clientId: 'print-farm', expires: 0, refresh_token: null },
      expired: false,
      revoke: () => {
        /* no-op */
      }
    } as unknown as import('home-assistant-js-websocket').Auth;

    const connectionPromise = createConnection({ auth });
    const [conn, connectError] = await tryPromise(connectionPromise);

    if (connectError) {
      logger.error('Failed to connect to Home Assistant', {
        error: connectError.message,
        stack: connectError.stack
      });
      connectionStatus.connecting = false;
      connectionStatus.lastError = connectError.message;
      return false;
    }

    if (!conn) {
      logger.error('Connection is null');
      connectionStatus.connecting = false;
      connectionStatus.lastError = 'Connection is null';
      return false;
    }

    this.connection = {
      connection: conn,
      entities: {},
      connectionStatus,
      reconnectAttempts: 0
    };

    // Subscribe to all entity updates
    this.subscribeToEntities();

    // Setup connection close handler
    conn.addEventListener('ready', () => {
      logger.info('Home Assistant connection ready');
      connectionStatus.connected = true;
      connectionStatus.connecting = false;
      connectionStatus.lastConnected = new Date();
      this.connection!.reconnectAttempts = 0;
    });

    conn.addEventListener('disconnected', () => {
      logger.info('Home Assistant connection disconnected');
      connectionStatus.connected = false;
      connectionStatus.connecting = false;
      this.scheduleReconnect();
    });

    logger.info('Successfully connected to Home Assistant');
    return true;
  }

  /**
   * Disconnect from Home Assistant
   */
  disconnect(): void {
    if (this.connection) {
      if (this.connection.reconnectTimer) {
        clearTimeout(this.connection.reconnectTimer);
      }
      if (this.connection.subscriptionUnsubscribe) {
        this.connection.subscriptionUnsubscribe();
      }
      this.connection.connection.close();
      this.connection = null;
      logger.info('Disconnected from Home Assistant');
    }
  }

  /**
   * Get connection status
   */
  getConnectionStatus(): ConnectionStatus {
    if (!this.connection) {
      return {
        connected: false,
        connecting: false,
        lastError: null,
        lastConnected: null
      };
    }
    return this.connection.connectionStatus;
  }

  /**
   * Check if connected
   */
  isConnected(): boolean {
    return this.connection?.connectionStatus.connected ?? false;
  }

  /**
   * Subscribe to all entity state changes
   */
  private subscribeToEntities(): void {
    if (!this.connection) return;

    const unsubscribe = subscribeEntities(this.connection.connection, (entities) => {
      this.connection!.entities = entities;
      logger.debug('Entity states updated', {
        entityCount: Object.keys(entities).length
      });
    });

    this.connection.subscriptionUnsubscribe = unsubscribe;
    logger.info('Subscribed to entity updates');
  }

  /**
   * Get current entity states
   */
  getEntities(): HassEntities {
    return this.connection?.entities ?? {};
  }

  /**
   * Get specific entity state
   */
  getEntityState(entityId: string): EntityState | null {
    const entities = this.getEntities();
    const entity = entities[entityId];
    if (!entity) return null;

    return {
      entity_id: entityId,
      state: entity.state,
      attributes: entity.attributes as EntityState['attributes'],
      last_changed: entity.last_changed,
      last_updated: entity.last_updated,
      context: entity.context as EntityState['context']
    };
  }

  /**
   * Call a Home Assistant service (e.g., turn on/off switch)
   */
  async callService(
    domain: string,
    service: string,
    serviceData?: {
      entity_id: string;
      [key: string]: unknown;
    }
  ): Promise<boolean> {
    if (!this.isConnected()) {
      logger.error('Not connected to Home Assistant');
      return false;
    }

    logger.info('Calling Home Assistant service', {
      domain,
      service,
      entityId: serviceData?.entity_id
    });

    const servicePromise = this.connection!.connection.sendMessagePromise<unknown>({
      type: 'call_service',
      domain,
      service,
      service_data: serviceData
    } as MessageBase);

    const [result, error] = await tryPromise(servicePromise);

    if (error) {
      logger.error('Service call failed', {
        error: error.message,
        stack: error.stack,
        domain,
        service,
        entityId: serviceData?.entity_id
      });
      return false;
    }

    logger.info('Service call successful', {
      domain,
      service,
      entityId: serviceData?.entity_id
    });
    return true;
  }

  /**
   * Turn on a switch
   */
  async turnOn(entityId: string): Promise<boolean> {
    return this.callService('switch', 'turn_on', { entity_id: entityId });
  }

  /**
   * Turn off a switch
   */
  async turnOff(entityId: string): Promise<boolean> {
    return this.callService('switch', 'turn_off', { entity_id: entityId });
  }

  /**
   * Toggle a switch
   */
  async toggle(entityId: string): Promise<boolean> {
    return this.callService('switch', 'toggle', { entity_id: entityId });
  }

  /**
   * Get all entity registry entries
   */
  async getEntityRegistry(): Promise<unknown[]> {
    if (!this.isConnected()) {
      throw new Error('Not connected to Home Assistant');
    }

    const promise = this.connection!.connection.sendMessagePromise<unknown[]>({
      type: 'config/entity_registry/list'
    } as MessageBase);

    const [result, error] = await tryPromise(promise);

    if (error) {
      logger.error('Failed to fetch entity registry', {
        error: error.message,
        stack: error.stack
      });
      throw error;
    }

    return (result as unknown[]) ?? [];
  }

  /**
   * Get all device registry entries
   */
  async getDeviceRegistry(): Promise<unknown[]> {
    if (!this.isConnected()) {
      throw new Error('Not connected to Home Assistant');
    }

    const promise = this.connection!.connection.sendMessagePromise<unknown[]>({
      type: 'config/device_registry/list'
    } as MessageBase);

    const [result, error] = await tryPromise(promise);

    if (error) {
      logger.error('Failed to fetch device registry', {
        error: error.message,
        stack: error.stack
      });
      throw error;
    }

    return (result as unknown[]) ?? [];
  }

  /**
   * Schedule reconnection with exponential backoff
   */
  private scheduleReconnect(): void {
    if (!this.connection) return;

    if (this.connection.reconnectAttempts >= this.MAX_RECONNECT_ATTEMPTS) {
      logger.warn('Max reconnect attempts reached for Home Assistant');
      return;
    }

    const delay = this.INITIAL_RECONNECT_DELAY * Math.pow(2, this.connection.reconnectAttempts);
    logger.info('Scheduling Home Assistant reconnect', {
      delayMs: delay,
      attempt: this.connection.reconnectAttempts + 1
    });

    this.connection.reconnectTimer = setTimeout(async () => {
      this.connection!.reconnectAttempts++;
      logger.info('Reconnecting to Home Assistant', {
        attempt: this.connection!.reconnectAttempts
      });

      const [_, error] = await tryPromise(() => this.connect());
      if (error) {
        logger.error('Home Assistant reconnect failed', {
          error: error.message,
          stack: error.stack
        });
      }
    }, delay);
  }
}

// Singleton instance
export const homeAssistantClient = new HomeAssistantClient();
