/**
 * Auto-shutdown service for Home Assistant integration
 * Handles automatic printer shutdown after job completion with safety checks
 */

import { homeAssistantClient } from './homeassistant-client';
import { deviceManager } from './device-manager';
import { eventBus } from '../../shared/services/event-bus';
import { mqttManager } from '../../printer/services/mqtt-manager';
import { createLogger } from '../../shared/utils/logger';
import { tryPromise } from '@julian-i/try-error';
import { getPrinterHAConfig } from '../database';
import type {
	ShutdownResult,
	AutoShutdownState,
	TemperatureThresholds
} from '../types';

const logger = createLogger('ha-auto-shutdown');

interface PrinterShutdownState {
	printerId: number;
	entityId: string;
	scheduledTime?: Date;
	timer?: NodeJS.Timeout;
}

class AutoShutdownService {
	private activeShutdowns = new Map<number, PrinterShutdownState>();
	private temperatureThresholds: TemperatureThresholds = {
		nozzle_max_temp: 50, // °C
		bed_max_temp: 40 // °C
	};

	constructor() {
		this.setupEventListeners();
	}

	/**
	 * Setup event listeners for job completion
	 */
	private setupEventListeners(): void {
		// Listen for job completion events
		eventBus.on('job:complete', async (data) => {
			logger.info('Job complete event received', { jobId: data.jobId });
			await this.handleJobComplete(data.jobId);
		});

		// Listen for external print completion
		eventBus.on('external-print:complete', async (data) => {
			logger.info('External print complete event received', {
				printerId: data.printerId
			});
			await this.handleExternalPrintComplete(data.printerId);
		});
	}

	/**
	 * Handle job completion event
	 */
	private async handleJobComplete(jobId: number): Promise<void> {
		// Get the printer from the job
		// This would require fetching job details from the database
		// For now, we'll skip as we need to integrate with the job module
		logger.info('Job complete - auto-shutdown not yet implemented for jobs', { jobId });
	}

	/**
	 * Handle external print completion
	 */
	private async handleExternalPrintComplete(printerId: number): Promise<void> {
		logger.info('External print complete - triggering auto-shutdown check', {
			printerId
		});
		await this.scheduleAutoShutdown(printerId);
	}

	/**
	 * Schedule auto-shutdown for a printer
	 */
	async scheduleAutoShutdown(printerId: number): Promise<ShutdownResult | null> {
		// Get printer configuration from database
		const printerConfig = await this.getPrinterConfig(printerId);

		if (!printerConfig) {
			logger.error('Printer not found', { printerId });
			return null;
		}

		// Check if auto-shutdown is enabled
		if (!printerConfig.auto_shutdown_enabled) {
			logger.info('Auto-shutdown disabled for printer', { printerId });
			return null;
		}

		// Check if entity is configured
		if (!printerConfig.home_assistant_entity_id) {
			logger.warn('No Home Assistant entity configured for printer', {
				printerId
			});
			return {
				success: false,
				message: 'No Home Assistant entity configured',
				timestamp: new Date(),
				printerId,
				reason: 'No entity configured'
			};
		}

		// Check if already scheduled
		if (this.activeShutdowns.has(printerId)) {
			logger.info('Auto-shutdown already scheduled for printer', { printerId });
			return null;
		}

		// Check if Home Assistant is connected
		if (!homeAssistantClient.isConnected()) {
			logger.error('Home Assistant not connected');
			return {
				success: false,
				message: 'Home Assistant not connected',
				timestamp: new Date(),
				printerId,
				reason: 'HA not connected'
			};
		}

		const delayMs = printerConfig.shutdown_delay_minutes * 60 * 1000;
		const scheduledTime = new Date(Date.now() + delayMs);

		logger.info('Scheduling auto-shutdown', {
			printerId,
			entityId: printerConfig.home_assistant_entity_id,
			delayMinutes: printerConfig.shutdown_delay_minutes,
			scheduledTime
		});

		// Schedule the shutdown
		const timer = setTimeout(async () => {
			await this.executeShutdown(printerId);
		}, delayMs);

		this.activeShutdowns.set(printerId, {
			printerId,
			entityId: printerConfig.home_assistant_entity_id,
			scheduledTime,
			timer
		});

		return {
			success: true,
			message: `Auto-shutdown scheduled for ${scheduledTime.toLocaleString()}`,
			timestamp: new Date(),
			printerId
		};
	}

	/**
	 * Cancel pending auto-shutdown
	 */
	cancelAutoShutdown(printerId: number): boolean {
		const shutdown = this.activeShutdowns.get(printerId);
		if (!shutdown) {
			return false;
		}

		if (shutdown.timer) {
			clearTimeout(shutdown.timer);
		}

		this.activeShutdowns.delete(printerId);
		logger.info('Auto-shutdown cancelled', { printerId });
		return true;
	}

	/**
	 * Execute shutdown with safety checks
	 */
	private async executeShutdown(printerId: number): Promise<ShutdownResult> {
		const shutdown = this.activeShutdowns.get(printerId);
		if (!shutdown) {
			return {
				success: false,
				message: 'No shutdown scheduled',
				timestamp: new Date(),
				printerId
			};
		}

		logger.info('Executing auto-shutdown', {
			printerId,
			entityId: shutdown.entityId
		});

		// Get printer config
		const printerConfig = await this.getPrinterConfig(printerId);
		if (!printerConfig) {
			this.activeShutdowns.delete(printerId);
			return {
				success: false,
				message: 'Printer configuration not found',
				timestamp: new Date(),
				printerId
			};
		}

		// Perform safety checks
		const safetyCheck = await this.performSafetyChecks(printerId, printerConfig);

		if (!safetyCheck.passed) {
			this.activeShutdowns.delete(printerId);
			return {
				success: false,
				message: `Safety check failed: ${safetyCheck.reason}`,
				timestamp: new Date(),
				printerId,
				reason: safetyCheck.reason
			};
		}

		// Turn off the switch
		const [success, error] = await tryPromise(
			homeAssistantClient.turnOff(shutdown.entityId)
		);

		this.activeShutdowns.delete(printerId);

		if (error || !success) {
			logger.error('Failed to turn off switch', {
				printerId,
				entityId: shutdown.entityId,
				error: error?.message
			});
			return {
				success: false,
				message: 'Failed to turn off switch',
				timestamp: new Date(),
				printerId,
				reason: error?.message
			};
		}

		logger.info('Auto-shutdown completed successfully', {
			printerId,
			entityId: shutdown.entityId
		});

		return {
			success: true,
			message: 'Printer turned off successfully',
			timestamp: new Date(),
			printerId
		};
	}

	/**
	 * Perform safety checks before shutdown
	 */
	private async performSafetyChecks(
		printerId: number,
		config: {
			power_threshold_watts: number;
			power_verification_seconds: number;
		}
	): Promise<{ passed: boolean; reason?: string }> {
		// Check 1: Temperature safety
		const tempCheck = await this.checkTemperatures(printerId);
		if (!tempCheck.passed) {
			return {
				passed: false,
				reason: `Temperature check failed: ${tempCheck.reason}`
			};
		}

		// Check 2: Power draw verification
		const printerConfig = await this.getPrinterConfig(printerId);
		if (!printerConfig?.home_assistant_entity_id) {
			return {
				passed: false,
				reason: 'No Home Assistant entity configured'
			};
		}

		logger.info('Starting power draw verification', {
			printerId,
			threshold: config.power_threshold_watts,
			duration: config.power_verification_seconds
		});

		const powerCheck = await deviceManager.monitorPowerDraw(
			printerConfig.home_assistant_entity_id,
			config.power_threshold_watts,
			config.power_verification_seconds
		);

		if (!powerCheck) {
			return {
				passed: false,
				reason: 'Power draw still above threshold'
			};
		}

		logger.info('All safety checks passed', { printerId });
		return { passed: true };
	}

	/**
	 * Check printer temperatures
	 */
	private async checkTemperatures(
		printerId: number
	): Promise<{ passed: boolean; reason?: string }> {
		const state = mqttManager.getPrinterStatus(printerId);

		if (!state) {
			logger.warn('Unable to get printer state for temperature check', {
				printerId
			});
			// If we can't get state, we'll skip this check
			return { passed: true };
		}

		logger.debug('Checking printer temperatures', {
			printerId,
			nozzleTemp: state.nozzleTemp,
			bedTemp: state.bedTemp
		});

		// Check nozzle temperature
		if (state.nozzleTemp > this.temperatureThresholds.nozzle_max_temp) {
			return {
				passed: false,
				reason: `Nozzle temperature too high: ${state.nozzleTemp}°C`
			};
		}

		// Check bed temperature
		if (state.bedTemp > this.temperatureThresholds.bed_max_temp) {
			return {
				passed: false,
				reason: `Bed temperature too high: ${state.bedTemp}°C`
			};
		}

		return { passed: true };
	}

	/**
	 * Get all active shutdown states
	 */
	getActiveShutdowns(): AutoShutdownState[] {
		return Array.from(this.activeShutdowns.values()).map((s) => ({
			printerId: s.printerId,
			pending: true,
			scheduledTime: s.scheduledTime
		}));
	}

	/**
	 * Get printer configuration from database
	 */
	private async getPrinterConfig(printerId: number): Promise<{
		home_assistant_entity_id: string | null;
		auto_shutdown_enabled: boolean;
		shutdown_delay_minutes: number;
		power_threshold_watts: number;
		power_verification_seconds: number;
	} | null> {
		return await getPrinterHAConfig(printerId);
	}

	/**
	 * Update temperature thresholds
	 */
	setTemperatureThresholds(thresholds: Partial<TemperatureThresholds>): void {
		this.temperatureThresholds = {
			...this.temperatureThresholds,
			...thresholds
		};
		logger.info('Temperature thresholds updated', {
			thresholds: this.temperatureThresholds
		});
	}
}

// Singleton instance
export const autoShutdownService = new AutoShutdownService();

// Alias for compatibility with existing imports
export const autoShutdown = autoShutdownService;

// Extend with additional aliases for route compatibility
(autoShutdown as any).cancelShutdown = (printerId: number) => autoShutdownService.cancelAutoShutdown(printerId);
