import { createLogger } from '../utils/logger';
import { mqttManager } from '../../printer/services/mqtt-manager';
import { queueProcessor } from '../../queue/services/queue-processor';
import { homeAssistantClient } from '../../homeassistant/client';
import { cameraProxyService } from './camera-proxy';
import { getDB, printers } from '../../db';
import { eq } from 'drizzle-orm';
import { tryPromise } from '@julian-i/try-error';
import type { Printer } from '../../printer/types/printer';

const logger = createLogger('service-initializer');

/**
 * Service initialization status
 */
export interface ServiceStatus {
	name: string;
	status: 'running' | 'stopped' | 'error';
	error?: string;
	startedAt?: Date;
}

/**
 * Initialize all services on application startup
 *
 * This function:
 * 1. Connects to all configured printers via MQTT
 * 2. Sets up event listeners for printer state changes
 * 3. Initializes the queue processor (when implemented)
 * 4. Prepares Home Assistant connection (when implemented)
 */
export async function initializeServices(): Promise<ServiceStatus[]> {
	const statuses: ServiceStatus[] = [];
	logger.info('Initializing services...');

	// Initialize MQTT Manager
	try {
		logger.info('Initializing MQTT manager...');

		// Get all configured printers from database
		const db = getDB();
		const [printerList, printerError] = await tryPromise(
			db.select().from(printers).where(eq(printers.enabled, true))
		);

		if (printerError) {
			throw printerError;
		}

		logger.info(`Found ${printerList.length} enabled printers`);

		// Connect to each printer
		let connectedCount = 0;
		for (const printer of printerList) {
			try {
				// Cast to Printer type - the database returns string for model_type
				// but the MQTT manager expects the Printer type with PrinterModelType
				const success = await mqttManager.connectPrinter(printer as unknown as Printer);
				if (success) {
					connectedCount++;
					logger.info(`Connected to printer: ${printer.name} (${printer.id})`);
				} else {
					logger.warn(`Failed to connect to printer: ${printer.name} (${printer.id})`);
				}
			} catch (error) {
				logger.error(`Error connecting to printer ${printer.id}`, { error });
			}
		}

		statuses.push({
			name: 'mqtt-manager',
			status: 'running',
			startedAt: new Date()
		});

		logger.info(`MQTT manager initialized: ${connectedCount}/${printerList.length} printers connected`);
	} catch (error) {
		logger.error('Failed to initialize MQTT manager', { error });
		statuses.push({
			name: 'mqtt-manager',
			status: 'error',
			error: error instanceof Error ? error.message : 'Unknown error'
		});
	}

	// Initialize Queue Processor
	try {
		logger.info('Initializing queue processor...');
		queueProcessor.start();
		statuses.push({
			name: 'queue-processor',
			status: 'running',
			startedAt: new Date()
		});
		logger.info('Queue processor initialized');
	} catch (error) {
		logger.error('Failed to initialize queue processor', { error });
		statuses.push({
			name: 'queue-processor',
			status: 'error',
			error: error instanceof Error ? error.message : 'Unknown error'
		});
	}

	// Initialize Home Assistant
	try {
		logger.info('Initializing Home Assistant client...');
		const [connected, connectError] = await tryPromise(homeAssistantClient.connect());

		if (connectError) {
			throw connectError;
		}

		if (connected) {
			statuses.push({
				name: 'homeassistant',
				status: 'running',
				startedAt: new Date()
			});
			logger.info('Home Assistant client initialized');
		} else {
			statuses.push({
				name: 'homeassistant',
				status: 'stopped',
				error: 'Not configured'
			});
			logger.info('Home Assistant client not configured');
		}
	} catch (error) {
		logger.error('Failed to initialize Home Assistant client', { error });
		statuses.push({
			name: 'homeassistant',
			status: 'error',
			error: error instanceof Error ? error.message : 'Unknown error'
		});
	}

	// Initialize Camera Proxy (stub - not fully implemented)
	try {
		logger.info('Camera proxy is a stub implementation');
		// Camera proxy is marked as stopped since it's not fully implemented
		statuses.push({
			name: 'camera-proxy',
			status: 'stopped',
			error: 'Not implemented'
		});
	} catch (error) {
		logger.error('Failed to initialize camera proxy', { error });
		statuses.push({
			name: 'camera-proxy',
			status: 'error',
			error: error instanceof Error ? error.message : 'Unknown error'
		});
	}

	return statuses;
}

/**
 * Shutdown all services gracefully
 */
export async function shutdownServices(): Promise<void> {
	logger.info('Shutting down services...');

	// Stop queue processor
	try {
		if (queueProcessor.isRunning()) {
			queueProcessor.stop();
			logger.info('Queue processor stopped');
		}
	} catch (error) {
		logger.error('Error stopping queue processor', { error });
	}

	// Disconnect all MQTT connections
	try {
		const printerStates = mqttManager.getAllConnectedPrinters();
		const printerIds = Array.from(printerStates.keys());
		logger.info(`Disconnecting ${printerIds.length} printers...`);

		for (const printerId of printerIds) {
			await mqttManager.disconnectPrinter(printerId);
		}

		logger.info('All printers disconnected');
	} catch (error) {
		logger.error('Error disconnecting printers', { error });
	}

	// Disconnect Home Assistant
	try {
		if (homeAssistantClient.isConnected()) {
			homeAssistantClient.disconnect();
			logger.info('Home Assistant client disconnected');
		}
	} catch (error) {
		logger.error('Error disconnecting Home Assistant', { error });
	}

	// Stop camera proxy
	try {
		if (cameraProxyService.isRunning()) {
			await cameraProxyService.stop();
			logger.info('Camera proxy stopped');
		}
	} catch (error) {
		logger.error('Error stopping camera proxy', { error });
	}

	logger.info('All services shut down');
}
