/**
 * Database connection module for the Print Farm API
 *
 * Uses Drizzle ORM with bun:sqlite for SQLite database access.
 */

import { Database } from 'bun:sqlite';
import { drizzle } from 'drizzle-orm/bun-sqlite';
import * as schema from './schema';

// Database connection singleton
let _db: ReturnType<typeof drizzle> | null = null;

/**
 * Get the database connection instance
 */
export function getDB() {
	if (!_db) {
		const databaseUrl = process.env.DATABASE_URL || 'file:../print-farm.db';
		const dbPath = databaseUrl.replace('file:', '');

		const sqlite = new Database(dbPath);
		_db = drizzle(sqlite, { schema });
	}

	return _db;
}

/**
 * Get the database connection instance (alias for convenience)
 * This exports the db instance directly for use in modules that prefer it
 */
export const db = new Proxy({} as ReturnType<typeof drizzle>, {
	get(_target, prop) {
		return getDB()[prop as keyof ReturnType<typeof drizzle>];
	}
});

/**
 * Schema exports
 */
export * from './schema';
export * from './schema-3mf';
