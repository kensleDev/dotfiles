import type { PrinterModelType, PrinterStatus } from '@/printer/types/printer';

/**
 * Printer entity from the API
 */
export interface Printer {
	id: number;
	name: string;
	serial: string;
	ip: string;
	access_code: string;
	model_type: PrinterModelType;
	actuator_id: number | null;
	custom_gcode: string | null;
	cooldown_time: number;
	enabled: boolean;
	// Home Assistant integration fields
	home_assistant_entity_id: string | null;
	auto_shutdown_enabled: boolean;
	shutdown_delay_minutes: number;
	power_threshold_watts: number;
	power_verification_seconds: number;
	created_at: string;
	updated_at: string;
}

/**
 * Printer with connection and status information
 */
export interface PrinterWithStatus extends Printer {
	connected: boolean;
	connecting: boolean;
	status: PrinterState | null;
	error: string | null;
}

/**
 * Filament state information
 */
export interface FilamentState {
	[type: string]: {
		color: string;
		type: string;
	} | null;
}

/**
 * Printer state information from MQTT
 */
export interface PrinterState {
	status: PrinterStatus;
	progress: number;
	remainingTime: number;
	currentFile: string | null;
	bedTemp: number;
	bedTargetTemp: number;
	nozzleTemp: number;
	nozzleTargetTemp: number;
	chamberTemp: number;
	chamberTargetTemp: number;
	layerCount: number;
	totalLayers: number;
	errorCode: string | null;
	errorMessage: string | null;
	lastUpdate: string;
	filament?: FilamentState;
}

/**
 * Input for creating a new printer
 */
export interface CreatePrinterInput {
	name: string;
	serial: string;
	ip: string;
	access_code: string;
	model_type: PrinterModelType;
	actuator_id?: number | null;
	custom_gcode?: string | null;
	cooldown_time?: number;
	enabled?: boolean;
	// Home Assistant integration fields
	home_assistant_entity_id?: string | null;
	auto_shutdown_enabled?: boolean;
	shutdown_delay_minutes?: number;
	power_threshold_watts?: number;
	power_verification_seconds?: number;
}

/**
 * Input for updating an existing printer
 */
export interface UpdatePrinterInput extends CreatePrinterInput {
	id: number;
}

/**
 * Command types for printer control
 */
export type PrinterCommandType = 'pause' | 'resume' | 'stop' | 'gcode';

/**
 * Input for sending a command to a printer
 */
export interface SendPrinterCommandInput {
	printerId: number;
	type: PrinterCommandType;
	gcode?: string;
}

/**
 * Input for testing printer connection
 */
export interface TestPrinterConnectionInput {
	serial: string;
	ip: string;
	access_code: string;
}

/**
 * Response from testing printer connection
 */
export interface TestPrinterConnectionResponse {
	success: boolean;
	message: string;
}

/**
 * Generic success response
 */
export interface SuccessResponse {
	success: boolean;
}
