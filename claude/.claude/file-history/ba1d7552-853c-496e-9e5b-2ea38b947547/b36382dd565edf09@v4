{
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); MODEL=$(echo \"$input\" | jq -r '.model.display_name'); PERCENT=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); MAX=$(echo \"$input\" | jq -r '.model.context_window // 200000'); [ -n \"$PERCENT\" ] && USED=$(echo \"scale=1; $MAX * $PERCENT / 100000\" | bc) && CTX=\"Context: ${USED}k/$(echo \"$MAX/1000\" | bc)k\" || CTX=\"Context: N/A\"; BRANCH=$(git -c core.fileMode=false rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'no git'); echo -e \"🤖 \\033[34m${MODEL}\\033[0m | 📊 \\033[33m${CTX}\\033[0m | 📁 \\033[36m$(basename \"$PWD\")\\033[0m | 🌿 \\033[32m${BRANCH}\\033[0m\"; echo -e \"\\033[90m═══════════════════════════════════════\\033[0m\""
  },
  "model": "sonnet",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  }
}
