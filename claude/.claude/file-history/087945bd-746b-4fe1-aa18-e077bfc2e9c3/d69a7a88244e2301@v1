/**
 * System Resource Monitoring Service
 *
 * Provides monitoring for system resources including:
 * - CPU usage percentage
 * - Memory usage percentage
 * - Disk usage (for database and storage)
 */

import { exec } from 'child_process';
import { promisify } from 'util';
import {
	systemCpuPercent,
	systemMemoryPercent,
	systemMemoryUsedBytes,
	systemMemoryTotalBytes,
	systemDiskUsagePercent,
	systemDiskAvailableBytes,
	systemDiskTotalBytes
} from './metrics';
import { createLogger } from '../../shared/utils/logger';
import { tryPromise } from '@julian-i/try-error';
import type { SystemResources } from '../types';

const execAsync = promisify(exec);
const logger = createLogger('system-resources');

// Previous CPU usage for calculation
let previousCpuUsage = process.cpuUsage();

/**
 * Update CPU usage metrics
 */
async function updateCPUMetrics(): Promise<void> {
	const currentCpuUsage = process.cpuUsage(previousCpuUsage);
	previousCpuUsage = process.cpuUsage();

	// Convert microseconds to seconds
	const userSeconds = currentCpuUsage.user / 1_000_000;
	const systemSeconds = currentCpuUsage.system / 1_000_000;

	// Calculate approximate CPU percentage over the last interval
	const totalUsage = userSeconds + systemSeconds;
	const cpuPercent = Math.min(totalUsage * 100, 100);

	systemCpuPercent.set(cpuPercent);
}

/**
 * Update memory usage metrics
 */
function updateMemoryMetrics(): void {
	const usage = process.memoryUsage();

	const usedBytes = usage.heapUsed;
	const totalBytes = usage.heapTotal;
	const percent = (usedBytes / totalBytes) * 100;

	systemMemoryUsedBytes.set(usedBytes);
	systemMemoryTotalBytes.set(totalBytes);
	systemMemoryPercent.set(percent);

	logger.debug('Memory metrics updated', {
		used: `${Math.round(usedBytes / 1024 / 1024)}MB`,
		total: `${Math.round(totalBytes / 1024 / 1024)}MB`,
		percent: `${percent.toFixed(1)}%`
	});
}

/**
 * Update disk usage metrics for a mount point
 */
async function updateDiskMetrics(mountPoint: string = '/'): Promise<void> {
	const [result, error] = await tryPromise(execAsync(`df -k "${mountPoint}" | tail -1`));

	if (error) {
		logger.error('Failed to get disk usage', {
			mountPoint,
			error: error.message
		});
		return;
	}

	// Parse df output:
	// Filesystem 1K-blocks Used Available Use% Mounted on
	// /dev/root   999320 456120   493200  48% /
	const parts = result.stdout.trim().split(/\s+/);
	if (parts.length < 5) {
		logger.error('Failed to parse df output', { output: result.stdout });
		return;
	}

	const totalKB = parseInt(parts[1], 10);
	const availableKB = parseInt(parts[3], 10);
	const usagePercent = parseFloat(parts[4]);

	if (isNaN(totalKB) || isNaN(availableKB) || isNaN(usagePercent)) {
		logger.error('Failed to parse disk values', { parts });
		return;
	}

	const totalBytes = totalKB * 1024;
	const availableBytes = availableKB * 1024;

	systemDiskTotalBytes.labels(mountPoint).set(totalBytes);
	systemDiskAvailableBytes.labels(mountPoint).set(availableBytes);
	systemDiskUsagePercent.labels(mountPoint).set(usagePercent);

	logger.debug('Disk metrics updated', {
		mountPoint,
		usagePercent: `${usagePercent}%`,
		available: `${Math.round(availableBytes / 1024 / 1024 / 1024)}GB`,
		total: `${Math.round(totalBytes / 1024 / 1024 / 1024)}GB`
	});
}

/**
 * Update all system resource metrics
 */
async function updateSystemMetrics(): Promise<void> {
	updateCPUMetrics();
	updateMemoryMetrics();
	await updateDiskMetrics('/');

	logger.debug('System metrics updated');
}

/**
 * System Resources Service Class
 */
class SystemResourcesService {
	private updateInterval: NodeJS.Timeout | null = null;

	/**
	 * Start periodic system metrics collection
	 */
	startMonitoring(intervalMs: number = 15000): void {
		logger.info('Starting system metrics collection', { intervalMs });

		// Run immediately
		updateSystemMetrics().catch((error) => {
			logger.error('Error updating system metrics', {
				error: error instanceof Error ? error.message : 'Unknown error'
			});
		});

		// Run periodically
		this.updateInterval = setInterval(() => {
			updateSystemMetrics().catch((error) => {
				logger.error('Error updating system metrics', {
					error: error instanceof Error ? error.message : 'Unknown error'
				});
			});
		}, intervalMs);
	}

	/**
	 * Stop system metrics collection
	 */
	stopMonitoring(): void {
		if (this.updateInterval) {
			clearInterval(this.updateInterval);
			this.updateInterval = null;
			logger.info('System metrics collection stopped');
		}
	}

	/**
	 * Get current system resource snapshot
	 */
	async getResources(): Promise<SystemResources> {
		const usage = process.memoryUsage();
		const memoryPercent = (usage.heapUsed / usage.heapTotal) * 100;

		// Get disk usage
		const [result, diskError] = await tryPromise(execAsync('df -k / | tail -1'));
		let disk = { total: 0, available: 0, percent: 0 };

		if (!diskError) {
			const parts = result.stdout.trim().split(/\s+/);
			if (parts.length >= 5) {
				disk = {
					total: parseInt(parts[1], 10) * 1024,
					available: parseInt(parts[3], 10) * 1024,
					percent: parseFloat(parts[4])
				};
			}
		}

		// Get CPU (approximation based on process CPU usage)
		const cpuUsage = process.cpuUsage();
		const totalCpu = (cpuUsage.user + cpuUsage.system) / 1_000_000;
		const cpuPercent = Math.min(totalCpu * 10, 100); // Approximate

		return {
			cpu: cpuPercent,
			memory: {
				used: usage.heapUsed,
				total: usage.heapTotal,
				percent: memoryPercent
			},
			disk
		};
	}
}

// Export singleton instance
export const systemResourcesService = new SystemResourcesService();
