import * as fs from 'fs';
import * as path from 'path';
import { injectLoops, extractPrintInfo } from '../../../shared/utils/gcode-parser';
import { extractGcodeFrom3mf, create3mfFromGcode } from '../../../shared/utils/zip-utils';
import { createLogger } from '../../../shared/utils/logger';
import { tryCatch } from '@julian-i/try-error';
import type { Job } from '../../../job/types/job';

const logger = createLogger('gcode-processor');

// Markers for Bambu Lab purge line section
const PURGE_LINE_START_MARKER = ';===== nozzle load line ===============================';
const PURGE_LINE_END_PATTERN = /^;===== for /;

/**
 * Removes the purge line section from G-code by commenting out all non-comment G-code commands.
 * The purge line is a nozzle priming section that draws a line from X18 to X240 and back,
 * which is unnecessary for automated workflows where printers are already primed.
 *
 * @param gcode - The original G-code string
 * @returns The modified G-code with purge line commands commented out
 */
export function removePurgeLine(gcode: string): string {
	const lines = gcode.split('\n');
	const startIndex = lines.findIndex((line) => line.trim() === PURGE_LINE_START_MARKER);

	// If no start marker found, return unchanged
	if (startIndex === -1) {
		return gcode;
	}

	// Find end marker after start
	let endIndex = -1;
	for (let i = startIndex + 1; i < lines.length; i++) {
		if (PURGE_LINE_END_PATTERN.test(lines[i].trim())) {
			endIndex = i;
			break;
		}
	}

	// If no end marker found, return unchanged
	if (endIndex === -1) {
		return gcode;
	}

	// Process lines between start and end markers (exclusive of markers themselves)
	const result: string[] = [];

	for (let i = 0; i < lines.length; i++) {
		const line = lines[i];
		const trimmedLine = line.trim();

		// Lines within the purge section (between start and end markers, exclusive)
		if (i > startIndex && i < endIndex) {
			// If it's already a comment or empty, leave it unchanged
			if (trimmedLine === '' || trimmedLine.startsWith(';')) {
				result.push(line);
			} else {
				// Comment out the G-code command
				result.push(`; REMOVED_PURGE: ${line}`);
			}
		} else {
			// Lines outside the purge section remain unchanged
			result.push(line);
		}
	}

	return result.join('\n');
}

const PROCESSED_DIR = path.join(process.cwd(), 'processed');

const [_, mkdirError] = tryCatch(() => {
	if (!fs.existsSync(PROCESSED_DIR)) {
		fs.mkdirSync(PROCESSED_DIR, { recursive: true });
	}
});
if (mkdirError) {
	logger.error('Failed to create processed directory', {
		error: mkdirError.message,
		stack: mkdirError.stack,
		path: PROCESSED_DIR
	});
}

export interface GcodeProcessResult {
	filePath: string;
	layerCount?: number;
	printTime?: number;
}

export class GcodeProcessor {
	async processJob(job: Job, processingOptions?: string[]): Promise<GcodeProcessResult> {
		const originalPath = job.file_path;
		const ext = path.extname(originalPath);

		if (ext !== '.3mf' && ext !== '.gcode') {
			throw new Error('Only .3mf and .gcode files are supported');
		}

		// Determine processing options from parameter or job
		const options = processingOptions ?? job.processing_options ?? ['process_gcode'];
		const shouldProcessGcode = options.includes('process_gcode');

		// Log processing options
		logger.info(`Processing job ${job.id} with options: ${options.join(', ')}`, {
			jobId: job.id,
			processingOptions: options,
			shouldProcessGcode
		});

		// If no processing needed or loop_count is 1, return original path
		if (!shouldProcessGcode || job.loop_count <= 1) {
			logger.info(`Skipping gcode processing for job ${job.id}`, {
				jobId: job.id,
				reason: !shouldProcessGcode ? 'process_gcode not in options' : 'loop_count <= 1',
				loopCount: job.loop_count
			});
			return {
				filePath: originalPath
			};
		}

		let gcode: string;

		if (ext === '.3mf') {
			const buffer = fs.readFileSync(originalPath);
			const extractedGcode = extractGcodeFrom3mf(buffer);

			if (!extractedGcode) {
				throw new Error('Failed to extract G-code from 3MF file');
			}

			gcode = extractedGcode;
		} else {
			gcode = fs.readFileSync(originalPath, 'utf-8');
		}

		const info = extractPrintInfo(gcode);

		const bedTemp = 60;
		const nozzleTemp = 200;
		const cooldownTime = (job.cooldown_time ?? 60) as number;
		const clearingGcode = this.getClearingGcode(job);

		const processedGcode = injectLoops(
			gcode,
			job.loop_count,
			clearingGcode,
			cooldownTime,
			bedTemp,
			nozzleTemp
		);

		const processedFileName = `looped_${path.basename(originalPath)}`;
		const processedPath = path.join(PROCESSED_DIR, processedFileName);

		if (ext === '.3mf') {
			const originalBuffer = fs.readFileSync(originalPath);
			const processedBuffer = create3mfFromGcode(processedGcode, originalBuffer);
			fs.writeFileSync(processedPath, processedBuffer);
		} else {
			fs.writeFileSync(processedPath, processedGcode, 'utf-8');
		}

		logger.info(`Processed job ${job.id} with ${job.loop_count} loops → ${processedPath}`, {
			jobId: job.id,
			loopCount: job.loop_count,
			processedPath,
			originalPath,
			extension: ext
		});

		return {
			filePath: processedPath,
			layerCount: info.layerCount,
			printTime: info.printTime
		};
	}

	private getClearingGcode(job: Job): string {
		return job.clearing_method === 'gcode'
			? this.getDefaultClearingGcode()
			: this.getDefaultClearingGcode();
	}

	private getDefaultClearingGcode(): string {
		return `
; Clearing sequence
G1 Z20 F3000
G1 X150 Y150 F3000
G1 Z0.2 F600
G4 S5
G1 Z5 F600
G1 X0 Y0 F3000
`;
	}

	cleanupOldFiles(maxAgeMs: number = 7 * 24 * 60 * 60 * 1000): void {
		const [files, readdirError] = tryCatch(() => fs.readdirSync(PROCESSED_DIR));
		if (readdirError) {
			logger.error('Error reading processed directory for cleanup', {
				error: readdirError.message,
				stack: readdirError.stack,
				processedDir: PROCESSED_DIR
			});
			return;
		}

		const now = Date.now();
		for (const file of files) {
			const filePath = path.join(PROCESSED_DIR, file);
			const [stats, statError] = tryCatch(() => fs.statSync(filePath));
			if (statError) {
				logger.warn('Error stating file during cleanup', {
					file,
					error: statError.message
				});
				continue;
			}

			if (stats && now - stats.mtimeMs > maxAgeMs) {
				const [_, unlinkError] = tryCatch(() => fs.unlinkSync(filePath));
				if (unlinkError) {
					logger.warn('Error deleting old file', {
						file,
						error: unlinkError.message
					});
				} else {
					logger.info(`Cleaned up old file: ${file}`, {
						filePath: filePath,
						originalFileName: file,
						deletedAt: new Date().toISOString()
					});
				}
			}
		}
	}
}

export const gcodeProcessor = new GcodeProcessor();
