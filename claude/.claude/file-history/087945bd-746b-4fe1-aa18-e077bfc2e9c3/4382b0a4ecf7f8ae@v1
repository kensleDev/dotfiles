/**
 * Metrics Service
 *
 * Provides Prometheus metrics collection using prom-client.
 * This is a singleton service that collects metrics for:
 * - HTTP requests
 * - Database queries
 * - MQTT connections
 * - SSE connections
 * - Jobs and queue processing
 * - Printer status
 * - System resources
 */

import promClient from 'prom-client';
import { createLogger } from '../../shared/utils/logger';

const logger = createLogger('metrics');

// Create a Registry for our metrics
const register = new promClient.Registry();

// Add default metrics (CPU, memory, etc.)
promClient.collectDefaultMetrics({
	register,
	prefix: 'print_farm_',
	gcDurationBuckets: [0.001, 0.01, 0.1, 1, 2, 5]
});

// HTTP Request Metrics
export const httpRequestDuration = new promClient.Histogram({
	name: 'print_farm_http_request_duration_seconds',
	help: 'Duration of HTTP requests in seconds',
	labelNames: ['method', 'route', 'status_code'],
	buckets: [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10]
});

export const httpRequestsTotal = new promClient.Counter({
	name: 'print_farm_http_requests_total',
	help: 'Total number of HTTP requests',
	labelNames: ['method', 'route', 'status_code']
});

// Database Metrics
export const dbQueryDuration = new promClient.Histogram({
	name: 'print_farm_db_query_duration_seconds',
	help: 'Duration of database queries in seconds',
	labelNames: ['operation', 'table'],
	buckets: [0.001, 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1]
});

export const dbQueryErrors = new promClient.Counter({
	name: 'print_farm_db_query_errors_total',
	help: 'Total number of database query errors',
	labelNames: ['operation', 'table']
});

export const dbHealthStatus = new promClient.Gauge({
	name: 'print_farm_db_healthy',
	help: 'Database health status (1=healthy, 0=unhealthy)'
});

// MQTT Metrics
export const mqttConnections = new promClient.Gauge({
	name: 'print_farm_mqtt_connections',
	help: 'Number of connected MQTT clients',
	labelNames: ['printer_id', 'printer_name']
});

export const mqttMessagesReceived = new promClient.Counter({
	name: 'print_farm_mqtt_messages_received_total',
	help: 'Total MQTT messages received',
	labelNames: ['printer_id', 'printer_name']
});

export const mqttMessagesSent = new promClient.Counter({
	name: 'print_farm_mqtt_messages_sent_total',
	help: 'Total MQTT messages sent',
	labelNames: ['printer_id', 'printer_name', 'command_type']
});

export const mqttErrors = new promClient.Counter({
	name: 'print_farm_mqtt_errors_total',
	help: 'Total MQTT errors',
	labelNames: ['printer_id', 'error_type']
});

export const mqttReconnects = new promClient.Counter({
	name: 'print_farm_mqtt_reconnects_total',
	help: 'Total MQTT reconnection attempts',
	labelNames: ['printer_id']
});

// SSE Metrics
export const sseActiveConnections = new promClient.Gauge({
	name: 'print_farm_sse_active_connections',
	help: 'Number of active SSE connections'
});

export const sseConnectionsTotal = new promClient.Counter({
	name: 'print_farm_sse_connections_total',
	help: 'Total SSE connections established'
});

export const sseDisconnectionsTotal = new promClient.Counter({
	name: 'print_farm_sse_disconnections_total',
	help: 'Total SSE disconnections'
});

export const sseMessagesSent = new promClient.Counter({
	name: 'print_farm_sse_messages_sent_total',
	help: 'Total SSE messages sent',
	labelNames: ['event_type']
});

export const sseSendErrors = new promClient.Counter({
	name: 'print_farm_sse_send_errors_total',
	help: 'Total SSE send errors'
});

// Job/Queue Metrics
export const jobsTotal = new promClient.Gauge({
	name: 'print_farm_jobs_total',
	help: 'Total number of jobs',
	labelNames: ['status']
});

export const jobsCompleted = new promClient.Counter({
	name: 'print_farm_jobs_completed_total',
	help: 'Total number of jobs completed'
});

export const jobsFailed = new promClient.Counter({
	name: 'print_farm_jobs_failed_total',
	help: 'Total number of jobs failed',
	labelNames: ['error_type']
});

export const jobsRetryCount = new promClient.Histogram({
	name: 'print_farm_job_retry_count',
	help: 'Distribution of job retry counts',
	buckets: [0, 1, 2, 3, 4, 5]
});

export const jobDuration = new promClient.Histogram({
	name: 'print_farm_job_duration_seconds',
	help: 'Duration of jobs in seconds',
	buckets: [60, 300, 600, 1800, 3600, 7200, 14400, 28800]
});

export const activeJobs = new promClient.Gauge({
	name: 'print_farm_active_jobs',
	help: 'Number of currently active jobs'
});

// Printer Metrics
export const printerStatus = new promClient.Gauge({
	name: 'print_farm_printer_status',
	help: 'Printer status (0=unknown, 1=idle, 2=preparing, 3=printing, 4=paused, 5=finish, 6=stop, 7=error)',
	labelNames: ['printer_id', 'printer_name']
});

export const printerTemperature = new promClient.Gauge({
	name: 'print_farm_printer_temperature',
	help: 'Printer temperatures in Celsius',
	labelNames: ['printer_id', 'printer_name', 'type']
});

export const printerProgress = new promClient.Gauge({
	name: 'print_farm_printer_progress',
	help: 'Printer progress percentage',
	labelNames: ['printer_id', 'printer_name']
});

// System Resource Metrics
export const systemCpuPercent = new promClient.Gauge({
	name: 'print_farm_system_cpu_percent',
	help: 'System CPU usage percentage (0-100)'
});

export const systemMemoryPercent = new promClient.Gauge({
	name: 'print_farm_system_memory_percent',
	help: 'System memory (heap) usage percentage (0-100)'
});

export const systemMemoryUsedBytes = new promClient.Gauge({
	name: 'print_farm_system_memory_used_bytes',
	help: 'System memory used in bytes'
});

export const systemMemoryTotalBytes = new promClient.Gauge({
	name: 'print_farm_system_memory_total_bytes',
	help: 'System memory total in bytes'
});

export const systemDiskUsagePercent = new promClient.Gauge({
	name: 'print_farm_system_disk_usage_percent',
	help: 'System disk usage percentage (0-100)',
	labelNames: ['mount_point']
});

export const systemDiskAvailableBytes = new promClient.Gauge({
	name: 'print_farm_system_disk_available_bytes',
	help: 'System disk available bytes',
	labelNames: ['mount_point']
});

export const systemDiskTotalBytes = new promClient.Gauge({
	name: 'print_farm_system_disk_total_bytes',
	help: 'System disk total bytes',
	labelNames: ['mount_point']
});

// Register all metrics
register.registerMetric(httpRequestDuration);
register.registerMetric(httpRequestsTotal);
register.registerMetric(dbQueryDuration);
register.registerMetric(dbQueryErrors);
register.registerMetric(dbHealthStatus);
register.registerMetric(mqttConnections);
register.registerMetric(mqttMessagesReceived);
register.registerMetric(mqttMessagesSent);
register.registerMetric(mqttErrors);
register.registerMetric(mqttReconnects);
register.registerMetric(sseActiveConnections);
register.registerMetric(sseConnectionsTotal);
register.registerMetric(sseDisconnectionsTotal);
register.registerMetric(sseMessagesSent);
register.registerMetric(sseSendErrors);
register.registerMetric(jobsTotal);
register.registerMetric(jobsCompleted);
register.registerMetric(jobsFailed);
register.registerMetric(jobsRetryCount);
register.registerMetric(jobDuration);
register.registerMetric(activeJobs);
register.registerMetric(printerStatus);
register.registerMetric(printerTemperature);
register.registerMetric(printerProgress);
register.registerMetric(systemCpuPercent);
register.registerMetric(systemMemoryPercent);
register.registerMetric(systemMemoryUsedBytes);
register.registerMetric(systemMemoryTotalBytes);
register.registerMetric(systemDiskUsagePercent);
register.registerMetric(systemDiskAvailableBytes);
register.registerMetric(systemDiskTotalBytes);

/**
 * Metrics Service Class
 */
class MetricsService {
	/**
	 * Get metrics in Prometheus format
	 */
	getPrometheusMetrics(): string {
		return register.metrics();
	}

	/**
	 * Get the content type for metrics endpoint
	 */
	getContentType(): string {
		return register.contentType;
	}

	/**
	 * Reset all metrics (useful for testing)
	 */
	resetMetrics(): void {
		register.resetMetrics();
	}

	/**
	 * Get metric values for health check
	 */
	getMetricValues() {
		return {
			mqttConnections,
			sseActiveConnections,
			activeJobs
		};
	}
}

// Export singleton instance
export const metricsService = new MetricsService();

logger.info('Metrics initialized');
