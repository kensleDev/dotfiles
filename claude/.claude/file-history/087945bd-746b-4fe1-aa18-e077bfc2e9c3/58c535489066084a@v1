import { sqliteTable, text, integer, real } from 'drizzle-orm/sqlite-core';
import { sql } from 'drizzle-orm';

export const printers = sqliteTable('printers', {
	id: integer('id').primaryKey({ autoIncrement: true }),
	name: text('name').notNull(),
	serial: text('serial').notNull().unique(),
	ip: text('ip').notNull(),
	access_code: text('access_code').notNull(),
	model_type: text('model_type').notNull(),
	actuator_id: integer('actuator_id'),
	custom_gcode: text('custom_gcode'),
	cooldown_time: integer('cooldown_time').notNull().default(300),
	enabled: integer('enabled', { mode: 'boolean' }).notNull().default(true),
	// Home Assistant integration
	home_assistant_entity_id: text('home_assistant_entity_id'),
	auto_shutdown_enabled: integer('auto_shutdown_enabled', { mode: 'boolean' }).default(
		false
	),
	shutdown_delay_minutes: integer('shutdown_delay_minutes').default(5),
	power_threshold_watts: integer('power_threshold_watts').default(15),
	power_verification_seconds: integer('power_verification_seconds').default(30),
	created_at: integer('created_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`),
	updated_at: integer('updated_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`)
});

export const jobs = sqliteTable('jobs', {
	id: integer('id').primaryKey({ autoIncrement: true }),
	display_name: text('display_name').notNull(),
	file_path: text('file_path').notNull(),
	assigned_printer: integer('assigned_printer').references(() => printers.id),
	status: text('status').notNull().default('pending'), // pending, running, paused, completed, failed, cancelled
	loop_count: integer('loop_count').notNull().default(1),
	current_loop: integer('current_loop').notNull().default(0),
	priority: integer('priority').notNull().default(5), // 1-10, lower is higher priority
	error_message: text('error_message'),
	retry_count: integer('retry_count').notNull().default(0),
	thumbnail: text('thumbnail'), // Base64 encoded thumbnail from 3MF
	file_size: integer('file_size'), // File size in bytes
	print_time_estimate: integer('print_time_estimate'), // Estimated print time in seconds
	clearing_method: text('clearing_method').default('actuator'), // 'actuator' or 'gcode'
	processing_options: text('processing_options').default(JSON.stringify(['process_gcode'])), // JSON array of processing option strings
	cooldown_time: integer('cooldown_time'), // Override per-job cooldown time
	scheduled_at: integer('scheduled_at', { mode: 'timestamp' }), // Optional scheduled start time
	created_at: integer('created_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`),
	updated_at: integer('updated_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`),
	started_at: integer('started_at', { mode: 'timestamp' }),
	completed_at: integer('completed_at', { mode: 'timestamp' })
});

export const printHistory = sqliteTable('print_history', {
	id: integer('id').primaryKey({ autoIncrement: true }),
	job_id: integer('job_id')
		.notNull()
		.references(() => jobs.id),
	printer_id: integer('printer_id')
		.notNull()
		.references(() => printers.id),
	loop_number: integer('loop_number').notNull(),
	status: text('status').notNull(),
	duration: integer('duration'), // Duration in seconds
	timestamp: integer('timestamp', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`)
});

export const settings = sqliteTable('settings', {
	key: text('key').primaryKey(),
	value: text('value').notNull(),
	updated_at: integer('updated_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`)
});

// Camera type enum values
export type CameraType = 'builtin' | 'tapo_c110' | 'rtsp_generic';

export const cameras = sqliteTable('cameras', {
	id: integer('id').primaryKey({ autoIncrement: true }),
	printer_id: integer('printer_id')
		.notNull()
		.references(() => printers.id, { onDelete: 'cascade' }),
	name: text('name').notNull(),
	type: text('type').notNull().$type<CameraType>().default('builtin'),
	ip_address: text('ip_address'),
	stream_url: text('stream_url'),
	camera_account_username: text('camera_account_username'),
	camera_account_password: text('camera_account_password'),
	is_default: integer('is_default', { mode: 'boolean' }).notNull().default(false),
	enabled: integer('enabled', { mode: 'boolean' }).notNull().default(true),
	created_at: integer('created_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`),
	updated_at: integer('updated_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`)
});

export const externalPrints = sqliteTable('external_prints', {
	// Primary key
	id: integer('id').primaryKey({ autoIncrement: true }),

	// Foreign key to printers table
	printer_id: integer('printer_id')
		.notNull()
		.references(() => printers.id, { onDelete: 'cascade' }),

	// Duplicate prevention hash (unique constraint)
	print_hash: text('print_hash').notNull().unique(),

	// Basic print information
	file_name: text('file_name'),
	status: text('status').notNull(), // 'printing', 'complete', 'stopped', 'error'

	// Progress tracking
	progress: integer('progress'), // mc_percent (0-100)
	remaining_time: integer('remaining_time'), // seconds
	layer_num: integer('layer_num'),
	total_layers: integer('total_layers'),

	// Temperatures
	bed_temp: real('bed_temp'),
	bed_target_temp: real('bed_target_temp'),
	nozzle_temp: real('nozzle_temp'),
	nozzle_target_temp: real('nozzle_target_temp'),
	chamber_temp: real('chamber_temp'),

	// Fan speeds (stored as strings from MQTT, e.g., "40%")
	heatbreak_fan_speed: text('heatbreak_fan_speed'),
	cooling_fan_speed: text('cooling_fan_speed'),
	big_fan1_speed: text('big_fan1_speed'),
	big_fan2_speed: text('big_fan2_speed'),

	// Speed settings
	spd_mag: integer('spd_mag'),
	spd_lvl: integer('spd_lvl'),

	// Hardware info
	wifi_signal: text('wifi_signal'),
	print_error: integer('print_error'),

	// Timing information
	started_at: integer('started_at', { mode: 'timestamp' }).notNull(),
	completed_at: integer('completed_at', { mode: 'timestamp' }),
	duration: integer('duration'), // seconds

	// Metadata
	created_at: integer('created_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`),
	updated_at: integer('updated_at', { mode: 'timestamp' })
		.notNull()
		.default(sql`(unixepoch())`)
});
