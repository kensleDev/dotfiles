/**
 * Health Check Service
 *
 * Provides health monitoring for the print-farm API including:
 * - Database connectivity
 * - MQTT connections
 * - SSE connections
 * - Queue processor status
 * - Camera health (delegated to camera-health service)
 */

import { mqttManager } from '../../printer/services/mqtt-manager';
import { sseManager } from '../../shared/services/sse-manager';
import { queueProcessor } from '../../queue/services/queue-processor';
import { checkAllCamerasHealth } from './camera-health';
import { dbHealthStatus, mqttConnections, sseActiveConnections } from './metrics';
import type {
	DatabaseHealth,
	MQTTHealth,
	SSEHealth,
	QueueProcessorHealth,
	CameraHealth,
	HealthCheckResponse,
	LivenessResponse,
	ReadinessResponse
} from '../types';
import { tryPromise } from '@julian-i/try-error';
import { createLogger } from '../../shared/utils/logger';
import { getDB, printers } from '../../db';

const logger = createLogger('health-monitor');

// Cached health status
let cachedHealthStatus: HealthCheckResponse = {
	status: 'unhealthy',
	timestamp: new Date(),
	uptime: 0,
	checks: {
		database: {
			healthy: false,
			lastCheck: new Date()
		},
		mqtt: {
			healthy: false,
			lastCheck: new Date(),
			connectedPrinters: 0,
			totalPrinters: 0,
			errors: {}
		},
		sse: {
			healthy: false,
			lastCheck: new Date(),
			activeConnections: 0
		},
		queueProcessor: {
			healthy: false,
			lastCheck: new Date(),
			isRunning: false,
			activeJobs: 0
		},
		cameras: {}
	}
};

// Application start time
const appStartTime = Date.now();

/**
 * Check database health
 */
async function checkDatabaseHealth(): Promise<DatabaseHealth> {
	const startTime = Date.now();

	const db = getDB();
	const [result, error] = await tryPromise(db.session.run('SELECT 1 as result'));

	const responseTime = Date.now() - startTime;
	const healthy = !error && result?.length > 0;

	// Update metric
	dbHealthStatus.set(healthy ? 1 : 0);

	if (error) {
		logger.error('Database health check failed', {
			error: error.message,
			stack: error.stack
		});
		return {
			healthy: false,
			lastCheck: new Date(),
			error: error.message,
			responseTime
		};
	}

	return {
		healthy: true,
		lastCheck: new Date(),
		responseTime
	};
}

/**
 * Check MQTT health
 */
async function checkMQTTHealth(): Promise<MQTTHealth> {
	try {
		// Get all printers from database
		const db = getDB();
		const [allPrinters, dbError] = await tryPromise(
			db.select().from(printers).where(eq(printers.enabled, 1))
		);

		if (dbError) {
			logger.error('Failed to fetch printers for MQTT health check', {
				error: dbError.message
			});
			return {
				healthy: false,
				lastCheck: new Date(),
				connectedPrinters: 0,
				totalPrinters: 0,
				errors: {}
			};
		}

		const totalPrinters = allPrinters?.length ?? 0;
		const errors: Record<number, string> = {};
		let connectedPrinters = 0;

		// Check each printer's connection status
		for (const printer of allPrinters ?? []) {
			const isConnected = mqttManager.isConnected(printer.id);

			// Update metric
			mqttConnections.set(
				{
					printer_id: printer.id.toString(),
					printer_name: printer.name
				},
				isConnected ? 1 : 0
			);

			if (isConnected) {
				connectedPrinters++;
			} else {
				const connectionError = mqttManager.getConnectionError(printer.id);
				if (connectionError) {
					errors[printer.id] = connectionError;
				}
			}
		}

		// MQTT is healthy if at least one printer is connected OR no printers exist
		const healthy = totalPrinters === 0 || connectedPrinters > 0;

		return {
			healthy,
			lastCheck: new Date(),
			connectedPrinters,
			totalPrinters,
			errors
		};
	} catch (error) {
		logger.error('MQTT health check error', {
			error: error instanceof Error ? error.message : 'Unknown error'
		});
		return {
			healthy: false,
			lastCheck: new Date(),
			connectedPrinters: 0,
			totalPrinters: 0,
			errors: {}
		};
	}
}

/**
 * Check SSE health
 */
async function checkSSEHealth(): Promise<SSEHealth> {
	try {
		// Get active SSE connection count
		const activeConnections = sseManager.getConnectionCount();

		// Update metric
		sseActiveConnections.set(activeConnections);

		return {
			healthy: true,
			lastCheck: new Date(),
			activeConnections
		};
	} catch (error) {
		logger.error('SSE health check error', {
			error: error instanceof Error ? error.message : 'Unknown error'
		});
		return {
			healthy: false,
			lastCheck: new Date(),
			activeConnections: 0
		};
	}
}

/**
 * Check queue processor health
 */
async function checkQueueProcessorHealth(): Promise<QueueProcessorHealth> {
	try {
		const isRunning = queueProcessor.isRunning();
		const activeJobs = queueProcessor.getActiveJobs();

		// Queue processor is healthy if it's running
		const healthy = isRunning;

		return {
			healthy,
			lastCheck: new Date(),
			isRunning,
			activeJobs: activeJobs.length
		};
	} catch (error) {
		logger.error('Queue processor health check error', {
			error: error instanceof Error ? error.message : 'Unknown error'
		});
		return {
			healthy: false,
			lastCheck: new Date(),
			isRunning: false,
			activeJobs: 0
		};
	}
}

/**
 * Update cached health status
 */
async function updateHealthStatus(): Promise<void> {
	const [dbHealth, mqttHealth, sseHealth, queueHealth, cameraHealth] = await Promise.all([
		checkDatabaseHealth(),
		checkMQTTHealth(),
		checkSSEHealth(),
		checkQueueProcessorHealth(),
		checkAllCamerasHealth()
	]);

	// Determine overall health status
	let status: 'healthy' | 'unhealthy' | 'degraded' = 'healthy';

	// Critical components: database must be healthy
	if (!dbHealth.healthy) {
		status = 'unhealthy';
	} else if (!mqttHealth.healthy || !sseHealth.healthy) {
		// Degraded if MQTT or SSE have issues (but not critical)
		status = 'degraded';
	}

	// Check camera health for degradation (but not critical)
	const healthyCameras = Object.values(cameraHealth).filter((c) => c.healthy).length;
	const totalCameras = Object.keys(cameraHealth).length;
	if (totalCameras > 0 && healthyCameras < totalCameras) {
		if (status === 'healthy') {
			status = 'degraded';
		}
	}

	cachedHealthStatus = {
		status,
		timestamp: new Date(),
		uptime: Math.floor((Date.now() - appStartTime) / 1000),
		checks: {
			database: dbHealth,
			mqtt: mqttHealth,
			sse: sseHealth,
			queueProcessor: queueHealth,
			cameras: cameraHealth
		}
	};

	logger.debug('Health status updated', {
		status,
		db: dbHealth.healthy,
		mqtt: mqttHealth.healthy,
		sse: sseHealth.healthy,
		queue: queueHealth.healthy,
		cameras: `${healthyCameras}/${totalCameras} healthy`
	});
}

/**
 * Health Service Class
 */
class HealthService {
	private updateInterval: NodeJS.Timeout | null = null;

	/**
	 * Start background health monitoring loop
	 */
	startMonitoring(intervalMs: number = 30000): void {
		logger.info('Starting health monitoring', { intervalMs });

		// Run immediately on start
		updateHealthStatus();

		// Run periodically
		this.updateInterval = setInterval(() => {
			updateHealthStatus();
		}, intervalMs);
	}

	/**
	 * Stop health monitoring
	 */
	stopMonitoring(): void {
		if (this.updateInterval) {
			clearInterval(this.updateInterval);
			this.updateInterval = null;
			logger.info('Health monitoring stopped');
		}
	}

	/**
	 * Get liveness probe response
	 */
	async checkLiveness(): Promise<boolean> {
		return true; // Process is alive if this code runs
	}

	/**
	 * Get readiness probe response
	 */
	async checkReadiness(): Promise<boolean> {
		const { database, mqtt } = cachedHealthStatus.checks;
		return database.healthy && mqtt.healthy;
	}

	/**
	 * Get full health check response
	 */
	async checkHealth(): Promise<HealthCheckResponse> {
		// Update health status before returning
		await updateHealthStatus();
		return cachedHealthStatus;
	}

	/**
	 * Manually trigger health check update
	 */
	async triggerHealthCheck(): Promise<HealthCheckResponse> {
		await updateHealthStatus();
		return cachedHealthStatus;
	}
}

// Export singleton instance
export const healthService = new HealthService();
