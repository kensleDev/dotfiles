// ============================================
// KEYBOARD PLATE
// 3x5 Ortholinear Grid
// ============================================

// --- PARAMETERS (like TypeScript constants) ---
key_unit = 19.05;           // 1U key spacing (standard)
switch_cutout = 14;         // MX+Alps switch cutout size
plate_thickness = 1.5;      // Plate thickness in mm
corner_radius = 0.5;        // Rounded corners for cutouts

// Main grid dimensions
cols = 3;                   // 3 columns
rows = 5;                   // 5 rows

// Plate dimensions (calculated from layout)
plate_width = cols * key_unit + 4;  // 3 columns + 2mm edge each side
plate_height = rows * key_unit + 4; // 5 rows + 2mm edge each side

// --- MODULES (like functions/components) ---

// Module to create a single switch cutout (2D shape)
module switch_cutout_2d() {
    offset(r=corner_radius) {
        offset(r=-corner_radius) {
            square([switch_cutout, switch_cutout], center=true);
        }
    }
}

// 3D switch cutout (extruded through the plate)
module switch_cutout_3d() {
    linear_extrude(height=plate_thickness) {
        switch_cutout_2d();
    }
}

// Module to create the main grid of switches
// Positioned starting at (2, 2) for 2mm edge margin
module main_grid() {
    start_x = 2;
    start_y = 2;

    for (col = [0:cols-1]) {
        for (row = [0:rows-1]) {
            translate([
                start_x + col * key_unit,
                start_y + row * key_unit,
                0
            ]) {
                switch_cutout_3d();
            }
        }
    }
}

// Base plate with rounded corners
module base_plate() {
    linear_extrude(height=plate_thickness) {
        offset(r=3) {
            offset(r=-3) {
                square([plate_width, plate_height]);
            }
        }
    }
}

// --- MAIN ASSEMBLY ---
// difference() = base plate MINUS switch cutouts

difference() {
    base_plate();

    union() {
        main_grid();
    }
}

