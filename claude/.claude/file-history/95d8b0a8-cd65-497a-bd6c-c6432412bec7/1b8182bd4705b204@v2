include <keyboard_config.scad>

// Pivot point used for rotation
pivot_x = plate_width;
pivot_y = plate_height;
center_y = pivot_y + bridge_length / 2;

// Left half footprint positioned and rotated
module left_half_footprint() {
    translate([pivot_x, pivot_y, 0])
    rotate([0, 0, -z_tilt_angle])
    translate([-pivot_x, -pivot_y, 0])
    cube([plate_width, plate_height, case_height]);
}

// Right half footprint - mirror of left
module right_half_footprint() {
    translate([0, 2 * center_y, 0])
    mirror([0, 1, 0])
    left_half_footprint();
}

// Left half insert posts - positioned and rotated with the half
module left_half_posts() {
    translate([pivot_x, pivot_y, 0])
    rotate([0, 0, -z_tilt_angle])
    translate([-pivot_x, -pivot_y, 0])
    for (pos = screw_positions) {
        difference() {
            // Post cylinder
            translate([pos[0], pos[1], 0])
            cylinder(h = insert_post_height, d = insert_post_diameter, $fn = 32);

            // Insert hole
            translate([pos[0], pos[1], insert_post_height - insert_depth])
            cylinder(h = insert_depth + 0.1, d = insert_hole_diameter, $fn = 32);
        }
    }
}

// Right half insert posts - mirrored
module right_half_posts() {
    translate([0, 2 * center_y, 0])
    mirror([0, 1, 0])
    left_half_posts();
}

// All posts combined
module all_posts() {
    left_half_posts();
    right_half_posts();
}

// Left half insert holes - positioned and rotated with the half
module left_half_insert_holes() {
    translate([pivot_x, pivot_y, 0])
    rotate([0, 0, -z_tilt_angle])
    translate([-pivot_x, -pivot_y, 0])
    for (pos = screw_positions) {
        translate([pos[0], pos[1], insert_post_height - insert_depth])
        cylinder(h = insert_depth + 0.1, d = insert_hole_diameter, $fn = 32);
    }
}

// Right half insert holes - mirrored
module right_half_insert_holes() {
    translate([0, 2 * center_y, 0])
    mirror([0, 1, 0])
    left_half_insert_holes();
}

// All insert holes combined
module all_insert_holes() {
    left_half_insert_holes();
    right_half_insert_holes();
}

// Left half inner skirt - positioned and rotated with the half
module left_half_skirt() {
    translate([pivot_x, pivot_y, 0])
    rotate([0, 0, -z_tilt_angle])
    translate([-pivot_x, -pivot_y, 0])
    linear_extrude(height = insert_post_height)
    difference() {
        offset(r = skirt_thickness / 2)
        union() {
            square([plate_width, plate_height]);
            offset(r = plate_gap)
            square([plate_width, plate_height]);
        }
        offset(r = -skirt_thickness / 2)
        union() {
            square([plate_width, plate_height]);
            offset(r = plate_gap)
            square([plate_width, plate_height]);
        }
        translate([-100, plate_height - skirt_thickness, 0])
        square([plate_width + 200, 100]);
    }
}

// Right half inner skirt - mirrored
module right_half_skirt() {
    translate([0, 2 * center_y, 0])
    mirror([0, 1, 0])
    left_half_skirt();
}

// Bridge skirts
module bridge_inner_skirt() {
    a = z_tilt_angle;

    // Left edge stop point
    lx1 = plate_width;
    ly1 = plate_height;
    lx2 = plate_width * (1 - cos(a));
    ly2 = plate_height + plate_width * sin(a);
    edge_length_left = sqrt(pow(lx2 - lx1, 2) + pow(ly2 - ly1, 2));
    stop_distance = 35;
    t_left = 1 - (stop_distance / edge_length_left);
    lx_stop = lx2 + t_left * (lx1 - lx2);
    ly_stop = ly2 + t_left * (ly1 - ly2);

    // Right edge stop point
    rx1 = plate_width;
    ry1 = plate_height + bridge_length;
    rx2 = plate_width * (1 - cos(a));
    ry2 = plate_height + bridge_length - plate_width * sin(a);
    edge_length_right = sqrt(pow(rx2 - rx1, 2) + pow(ry2 - ry1, 2));
    t_right = 1 - (stop_distance / edge_length_right);
    rx_stop = rx2 + t_right * (rx1 - rx2);
    ry_stop = ry2 + t_right * (ry1 - ry2);

    // Calculate midpoint (intersection with cross skirt)
    mid_y = (ly_stop + ry_stop) / 2;

    linear_extrude(height = insert_post_height) {
        // Bottom section: from bottom to midpoint
        translate([plate_width - skirt_thickness, plate_height, 0])
        square([skirt_thickness, mid_y - plate_height]);
        // Top section: from midpoint to top
        translate([plate_width - skirt_thickness, mid_y, 0])
        square([skirt_thickness, plate_height + bridge_length - mid_y]);
    }
}

module bridge_left_edge_skirt() {
    a = z_tilt_angle;

    // Left edge corners
    lx1 = plate_width;
    ly1 = plate_height;
    lx2 = plate_width * (1 - cos(a));
    ly2 = plate_height + plate_width * sin(a);

    // Calculate edge length
    edge_length = sqrt(pow(lx2 - lx1, 2) + pow(ly2 - ly1, 2));

    // Stop 3.5 cm from top
    stop_distance = 35;
    t = 1 - (stop_distance / edge_length);

    // Intermediate point (stop point)
    lx_stop = lx2 + t * (lx1 - lx2);
    ly_stop = ly2 + t * (ly1 - ly2);

    linear_extrude(height = insert_post_height)
    polygon(points = [
        [lx1, ly1],
        [lx_stop, ly_stop],
        [lx_stop - skirt_thickness, ly_stop - skirt_thickness],
        [lx1 - skirt_thickness, ly1 - skirt_thickness]
    ]);
}

module bridge_right_edge_skirt() {
    a = z_tilt_angle;

    // Right edge corners
    rx1 = plate_width;
    ry1 = plate_height + bridge_length;
    rx2 = plate_width * (1 - cos(a));
    ry2 = plate_height + bridge_length - plate_width * sin(a);

    // Calculate edge length
    edge_length = sqrt(pow(rx2 - rx1, 2) + pow(ry2 - ry1, 2));

    // Stop 3.5 cm from top
    stop_distance = 35;
    t = 1 - (stop_distance / edge_length);

    // Intermediate point (stop point)
    rx_stop = rx2 + t * (rx1 - rx2);
    ry_stop = ry2 + t * (ry1 - ry2);

    linear_extrude(height = insert_post_height)
    polygon(points = [
        [rx1, ry1],
        [rx_stop, ry_stop],
        [rx_stop + skirt_thickness, ry_stop + skirt_thickness],
        [rx1 + skirt_thickness, ry1 + skirt_thickness]
    ]);
}

// Bridge cross skirt - connects left and right edge skirts in middle
module bridge_cross_skirt() {
    a = z_tilt_angle;

    // Left edge stop point
    lx1 = plate_width;
    ly1 = plate_height;
    lx2 = plate_width * (1 - cos(a));
    ly2 = plate_height + plate_width * sin(a);
    edge_length_left = sqrt(pow(lx2 - lx1, 2) + pow(ly2 - ly1, 2));
    stop_distance = 35;
    t = 1 - (stop_distance / edge_length_left);
    lx_stop = lx2 + t * (lx1 - lx2);
    ly_stop = ly2 + t * (ly1 - ly2);

    // Right edge stop point
    rx1 = plate_width;
    ry1 = plate_height + bridge_length;
    rx2 = plate_width * (1 - cos(a));
    ry2 = plate_height + bridge_length - plate_width * sin(a);
    edge_length_right = sqrt(pow(rx2 - rx1, 2) + pow(ry2 - ry1, 2));
    t_right = 1 - (stop_distance / edge_length_right);
    rx_stop = rx2 + t_right * (rx1 - rx2);
    ry_stop = ry2 + t_right * (ry1 - ry2);

    // Calculate midpoint
    mid_x = (lx_stop + rx_stop) / 2;
    mid_y = (ly_stop + ry_stop) / 2;

    // Calculate perpendicular vector for skirt thickness
    dx = rx_stop - lx_stop;
    dy = ry_stop - ly_stop;
    length = sqrt(dx * dx + dy * dy);
    perp_x = (dy / length) * skirt_thickness;
    perp_y = (-dx / length) * skirt_thickness;

    linear_extrude(height = insert_post_height)
    polygon(points = [
        [lx_stop, ly_stop],
        [rx_stop, ry_stop],
        [rx_stop + perp_x, ry_stop + perp_y],
        [lx_stop + perp_x, ly_stop + perp_y]
    ]);
}

// All skirts combined
module all_skirts() {
    if (skirt_enabled) {
        left_half_skirt();
        right_half_skirt();
        bridge_inner_skirt();
        bridge_left_edge_skirt();
        bridge_right_edge_skirt();
        bridge_cross_skirt();
    }
}

// Bridge using explicit corner positions
module case_bridge() {
    a = z_tilt_angle;

    // Simplified: left edge corners
    lx1 = plate_width;                          // inner corner x
    ly1 = plate_height;                         // inner corner y
    lx2 = plate_width * (1 - cos(a));           // outer corner x
    ly2 = plate_height + plate_width * sin(a);  // outer corner y

    // Right edge corners (mirrored angles)
    rx1 = plate_width;                          // inner corner x
    ry1 = plate_height + bridge_length;         // inner corner y
    rx2 = plate_width * (1 - cos(a));           // outer corner x
    ry2 = plate_height + bridge_length - plate_width * sin(a);  // outer corner y

    // Create bridge as linear extrusion of polygon
    linear_extrude(height = case_height) {
        polygon(points = [
            [lx1, ly1],  // left inner
            [lx2, ly2],  // left outer
            [rx2, ry2],  // right outer
            [rx1, ry1]   // right inner
        ]);
    }
}

// Thumb dip shape - Vertical ledge from top edge with slanted sides
module thumb_dip_shape() {
    smooth_radius = 2;

    // Calculate horizontal offset from slant angle
    side_offset = tan(thumb_dip_slant_angle) * thumb_dip_depth;

    // Create trapezoid shape, then rotate 90 degrees on horizontal axis
    translate([-2 * thumb_dip_length, 0, 0])
    rotate([90, 0, 0])
    rotate([0, 90, 0])
    translate([0, -smooth_radius, 0])
    linear_extrude(height = 2 * thumb_dip_length, center = false)
    if (thumb_dip_smooth) {
        minkowski() {
            polygon(points = [
                [-thumb_dip_width / 2, -smooth_radius],
                [thumb_dip_width / 2, -smooth_radius],
                [thumb_dip_width / 2 - side_offset, -thumb_dip_depth],
                [-thumb_dip_width / 2 + side_offset, -thumb_dip_depth]
            ]);
            circle(r = smooth_radius, $fn = 16);
        }
    } else {
        polygon(points = [
            [-thumb_dip_width / 2, 0],                           // Top left
            [thumb_dip_width / 2, 0],                            // Top right
            [thumb_dip_width / 2 - side_offset, -thumb_dip_depth], // Bottom right (slanted)
            [-thumb_dip_width / 2 + side_offset, -thumb_dip_depth] // Bottom left (slanted)
        ]);
    }
}

// Left half thumb dip - Under thumb cluster keys on inner edge
module left_half_thumb_dip() {
    // Calculate diagonal offset toward bridge (accounting for rotation)
    angle = z_tilt_angle;
    toward_bridge_x = -sin(angle) * thumb_dip_toward_bridge;
    toward_bridge_y = cos(angle) * thumb_dip_toward_bridge;

    translate([pivot_x, pivot_y, 0])
    rotate([0, 0, -z_tilt_angle])
    translate([-pivot_x, -pivot_y, 0])
    // Position centered on thumb cluster row 3, with slant offsets
    translate([plate_width + case_wall_thickness + plate_gap + 1 + thumb_dip_start_x + toward_bridge_x,
               edge_margin + 3 * key_spacing + toward_bridge_y,
               case_height + case_wall_multiplier * case_wall_thickness + plate_gap])
    thumb_dip_shape();
}

// Right half thumb dip - V-groove on outer edge (Y = 0)
module right_half_thumb_dip() {
    translate([0, 2 * center_y, 0])
    mirror([0, 1, 0])
    left_half_thumb_dip();
}

// USB port cutout - access for Pro Micro USB connector
module bridge_usb_cutout() {
    a = z_tilt_angle;

    // Bridge outer face X position (back wall)
    outer_x = plate_width * (1 - cos(a));

    // USB cutout dimensions (from config)
    cutout_width = usb_cutout_width;
    cutout_height = usb_cutout_height;
    cutout_depth = usb_cutout_depth;

    // Position cutout at back wall, centered on bridge
    // X: cut through wall (start at outer_x, extend inward)
    // Y: centered on bridge at center_y
    // Z: centered at configured Z position from bottom
    translate([outer_x - cutout_depth, center_y - cutout_width / 2, usb_cutout_z_position - cutout_height / 2])
    cube([cutout_depth, cutout_width, cutout_height]);
}

// USB connector recess - cavity in back wall for USB connector to extend into
module bridge_usb_recess() {
    a = z_tilt_angle;

    // Bridge outer face X position (back wall)
    outer_x = plate_width * (1 - cos(a));

    // Recess dimensions - slightly larger than USB connector
    recess_width = usb_connector_width + 2;      // mm, width across wall
    recess_depth = usb_connector_height + 1.5;   // mm, depth into wall from back
    recess_height = usb_connector_height + 1;    // mm, height (up/down)

    // Position recess at back wall, centered on bridge
    // X: recess into wall from outer_x
    // Y: centered on bridge at center_y
    // Z: aligned with USB cutout (pcb sits on tray at case_wall_thickness + tray_height)
    pcb_z = case_wall_thickness + pro_micro_tray_height;
    recess_z = pcb_z;  // recess starts at PCB level

    translate([outer_x - recess_depth, center_y - recess_width / 2, recess_z])
    cube([recess_depth, recess_width, recess_height]);
}

// Pro Micro tray - parallel to bridge, USB connector facing back wall
module bridge_pro_micro_tray() {
    a = z_tilt_angle;

    // Bridge outer face X position (back wall)
    outer_x = plate_width * (1 - cos(a));

    // Tray position: parallel to bridge, centered on bridge Y (center_y)
    // USB connector faces back wall (at outer_x)
    // Tray width (13mm) is along X axis, length (35mm) is along Y axis
    // X: tray back edge near wall, offset inward for wall thickness
    // Y: centered on bridge
    // Z: on case floor
    tray_inset_from_wall = 5;  // mm, distance from back wall to tray
    tray_x = outer_x - tray_inset_from_wall - pro_micro_tray_width;
    tray_y = center_y - pro_micro_tray_length / 2;

    translate([tray_x, tray_y, case_wall_thickness])
    cube([pro_micro_tray_width, pro_micro_tray_length, pro_micro_tray_height]);
}

// Combined footprint (no posts - added separately to avoid minkowski smoothing)
module full_footprint() {
    left_half_footprint();
    right_half_footprint();
    case_bridge();
}

// Final case assembly
union() {
    difference() {
        // Outer shell (no posts - add separately)
        minkowski() {
            full_footprint();
            cylinder(r = plate_gap + case_wall_multiplier * case_wall_thickness, h = 0.01, $fn = 32);
        }

        // Hollow out interior
        translate([0, 0, case_wall_thickness])
        minkowski() {
            full_footprint();
            cylinder(r = plate_gap, h = 0.01, $fn = 32);
        }

        // Subtract thumb dips if enabled
        if (thumb_dip_enabled) {
            left_half_thumb_dip();
            right_half_thumb_dip();
        }

        // Subtract USB cutout if enabled
        if (usb_cutout_enabled) {
            bridge_usb_cutout();
        }

        // Subtract USB recess if enabled (cavity for connector)
        if (usb_cutout_enabled) {
            // bridge_usb_recess();
        }
    }

    // Add Pro Micro tray if enabled
    if (pro_micro_tray_enabled) {
        bridge_pro_micro_tray();
    }

    // Add posts separately (no minkowski smoothing)
    all_posts();

    // Add inner skirt for structural rigidity
    all_skirts();
}

// Debug mode: show dip shapes in red
if (thumb_dip_debug) {
    color("red", alpha = 0.5)
    left_half_thumb_dip();
    right_half_thumb_dip();
}

// Debug mode: show USB cutout in red
if (usb_cutout_debug) {
    color("red", alpha = 0.5)
    bridge_usb_cutout();
    color("orange", alpha = 0.5)
    bridge_usb_recess();
}
