#!/usr/bin/env bash

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cheats"
CACHE_FILE="$CACHE_DIR/cheatsheet_index.txt"
PID_FILE="$CACHE_DIR/.refresh_pid"

# Search paths for normal refresh
SEARCH_PATHS=("$HOME/.config" "$HOME/.kd")

# Create cache dir if it doesn't exist
mkdir -p "$CACHE_DIR"

# Show spinner during refresh
spinner() {
	local pid=$1
	local message=$2
	local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
	local i=0

	printf "\r%s " "$message"

	while kill -0 "$pid" 2>/dev/null; do
		printf "\r%s %s" "$message" "${frames:i++%${#frames}:1}"
		sleep 0.08
	done

	printf "\r%s \n" "$message"
}

# Async refresh in background
async_refresh() {
	# Check if already running
	if [[ -f "$PID_FILE" ]]; then
		old_pid=$(cat "$PID_FILE")
		if kill -0 "$old_pid" 2>/dev/null; then
			return  # Already running
		fi
	fi

	echo $$ > "$PID_FILE"

	new_files=$(find -L "${SEARCH_PATHS[@]}" -maxdepth 4 -name "CHEATSHEET.md" 2>/dev/null | sort)

	# Only update if different
	if ! diff -q "$CACHE_FILE" <(echo "$new_files") >/dev/null 2>&1; then
		echo "$new_files" > "$CACHE_FILE"
	fi

	rm -f "$PID_FILE"
}

# Sync refresh with spinner (for --refresh/--all flags)
sync_refresh() {
	local search_target="$1"

	if [[ "$search_target" == "all" ]]; then
		local paths=("$HOME")
		local msg="Re-indexing cheatsheets (full home)..."
	else
		local paths=("${SEARCH_PATHS[@]}")
		local msg="Re-indexing cheatsheets..."
	fi

	(
		new_files=$(find -L "${paths[@]}" -maxdepth 6 -name "CHEATSHEET.md" 2>/dev/null | sort)
		echo "$new_files" > "$CACHE_FILE"
	) &
	local refresh_pid=$!
	spinner $refresh_pid "  $msg"
	wait $refresh_pid
}

# Handle flags
case "$1" in
	--all)
		sync_refresh "all"
		;;
	--refresh)
		sync_refresh "normal"
		;;
	*)
		# Ensure cache exists for immediate load
		if [[ ! -f "$CACHE_FILE" ]]; then
			find -L "${SEARCH_PATHS[@]}" -maxdepth 4 -name "CHEATSHEET.md" 2>/dev/null | sort > "$CACHE_FILE"
		fi

		# Start async refresh in background
		async_refresh &
		;;
esac

# Load immediately from cache (skip if no cache on first run)
if [[ -f "$CACHE_FILE" ]]; then
	selected=$(cat "$CACHE_FILE" | fzf --preview 'bat --color=always {}' --preview-window=right:70%)

	if [[ -n "$selected" ]]; then
		bat "$selected"
	fi
fi
