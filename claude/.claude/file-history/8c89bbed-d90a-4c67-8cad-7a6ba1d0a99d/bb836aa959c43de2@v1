import { DirectoryScanner } from "../../core/scanner.js";
import { FileMover } from "../../core/mover.js";
import { TaskRunner, type TaskContext, type Task, detectVerbosity, StatisticsCollector, formatSummary } from "../../progress/index.js";
import { Logger } from "../../utils/logger.js";
import { loadConfig } from "../../config/loader.js";
import { Categorizer } from "../../core/categorizer.js";
import path from "node:path";
