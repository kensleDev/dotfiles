import { getDB, modelFiles } from '../../db';
import { eq, desc, like, or, and } from 'drizzle-orm';
import { tryPromise, tryCatch } from '@julian-i/try-error';
import { createLogger } from '../../shared/utils/logger';
import type {
  ModelFile,
  CreateModelFileInput,
  UpdateModelFileInput,
  ModelFileFilter
} from '../types/model';
import { deleteModelFile, metadataToDb, process3MFFile, saveModelFile } from './model-file-handler';

const logger = createLogger('model-manager');

/**
 * Get all model files with optional filtering
 */
export async function getModelFiles(filter: ModelFileFilter = {}): Promise<ModelFile[]> {
  const { limit, offset, search } = filter;

  // Apply search filter
  if (search) {
    const baseQuery = getDB()
      .select()
      .from(modelFiles)
      .where(
        or(
          like(modelFiles.file_name, `%${search}%`),
          like(modelFiles.title, `%${search}%`),
          like(modelFiles.description, `%${search}%`)
        )
      )
      .orderBy(desc(modelFiles.uploaded_at));

    const query = limit !== undefined ? baseQuery.limit(limit) : baseQuery;
    const finalQuery = offset !== undefined ? query.offset(offset) : query;

    const [result, error] = await tryPromise(finalQuery);

    if (error) {
      logger.error('Failed to fetch model files with search', {
        search,
        error: error.message,
        stack: error.stack
      });
      return [];
    }
    return result;
  }

  // No search filter - build with all options at once
  const baseQuery = getDB().select().from(modelFiles).orderBy(desc(modelFiles.uploaded_at));

  const query = limit !== undefined ? baseQuery.limit(limit) : baseQuery;
  const finalQuery = offset !== undefined ? query.offset(offset) : query;

  const [result, error] = await tryPromise(finalQuery);

  if (error) {
    logger.error('Failed to fetch model files', {
      error: error.message,
      stack: error.stack
    });
    return [];
  }

  return result;
}

/**
 * Get a single model file by ID
 */
export async function getModelFile(id: number): Promise<ModelFile | null> {
  const [result, error] = await tryPromise(
    getDB().select().from(modelFiles).where(eq(modelFiles.id, id))
  );
  if (error) {
    logger.error('Failed to fetch model file by ID', {
      fileId: id,
      error: error.message,
      stack: error.stack
    });
    return null;
  }
  const [file] = result;
  return file || null;
}

/**
 * Get a model file by file path
 */
export async function getModelFileByPath(filePath: string): Promise<ModelFile | null> {
  const [result, error] = await tryPromise(
    getDB().select().from(modelFiles).where(eq(modelFiles.file_path, filePath))
  );
  if (error) {
    logger.error('Failed to fetch model file by path', {
      filePath,
      error: error.message,
      stack: error.stack
    });
    return null;
  }
  const [file] = result;
  return file || null;
}

/**
 * Create a new model file
 */
export async function createModelFile(input: CreateModelFileInput): Promise<ModelFile> {
  const [result, error] = await tryPromise(getDB().insert(modelFiles).values(input).returning());
  if (error) {
    logger.error('Failed to create model file', {
      fileName: input.file_name,
      error: error.message,
      stack: error.stack
    });
    throw new Error('Failed to create model file in database');
  }
  const [file] = result;
  return file;
}

/**
 * Upload and process a 3MF file
 */
export async function uploadModelFile(file: File): Promise<{
  file: ModelFile;
  thumbnail?: string;
}> {
  // Validate file
  const validation = await validate3MFFile(file);
  if (!validation.valid) {
    throw new Error(validation.error);
  }

  // Read file content
  const arrayBuffer = await file.arrayBuffer();
  const buffer = Buffer.from(arrayBuffer);

  // Process 3MF file to extract metadata and thumbnail
  const fileData = process3MFFile(buffer, file.name);

  // Save file to disk
  const { filePath, thumbnailPath, thumbnailData } = saveModelFile(fileData);

  // Convert metadata to database format
  const dbMetadata = metadataToDb(fileData.metadata);

  // Create database record
  const modelFile = await createModelFile({
    file_name: file.name,
    file_path: filePath,
    file_size: file.size,
    thumbnail_path: thumbnailPath,
    thumbnail_data: thumbnailData,
    mime_type: 'model/3mf',
    ...dbMetadata
  });

  return {
    file: modelFile,
    thumbnail: thumbnailData || undefined
  };
}

/**
 * Validate a 3MF file for upload
 */
async function validate3MFFile(file: File): Promise<{
  valid: boolean;
  error?: string;
}> {
  const MAX_SIZE = 50 * 1024 * 1024; // 50MB

  if (!file.name.toLowerCase().endsWith('.3mf')) {
    return { valid: false, error: 'File must be a .3mf file' };
  }

  if (file.size > MAX_SIZE) {
    return {
      valid: false,
      error: `File size exceeds maximum of ${MAX_SIZE / 1024 / 1024}MB`
    };
  }

  return { valid: true };
}

/**
 * Update a model file
 */
export async function updateModelFile(
  id: number,
  input: UpdateModelFileInput
): Promise<ModelFile | null> {
  const [result, error] = await tryPromise(
    getDB()
      .update(modelFiles)
      .set({
        ...input,
        updated_at: new Date()
      })
      .where(eq(modelFiles.id, id))
      .returning()
  );

  if (error) {
    logger.error('Failed to update model file', {
      fileId: id,
      error: error.message,
      stack: error.stack
    });
    return null;
  }

  const [file] = result;
  return file || null;
}

/**
 * Delete a model file
 */
export async function deleteModelFileById(id: number): Promise<boolean> {
  // Get file data first
  const file = await getModelFile(id);

  if (!file) {
    return false;
  }

  // Delete from disk - best effort
  const [_, diskError] = tryCatch(() => deleteModelFile(file.file_path, file.thumbnail_path));
  if (diskError) {
    logger.warn('Failed to delete model file from disk', {
      filePath: file.file_path,
      error: diskError.message,
      stack: diskError.stack
    });
  }

  // Delete from database
  const [__, dbError] = await tryPromise(getDB().delete(modelFiles).where(eq(modelFiles.id, id)));
  if (dbError) {
    logger.error('Failed to delete model file from database', {
      fileId: id,
      error: dbError.message,
      stack: dbError.stack
    });
    return false;
  }

  return true;
}

/**
 * Get file statistics
 */
export async function getModelFileStats(): Promise<{
  totalCount: number;
  totalSize: number;
  averageSize: number;
}> {
  const files = await getModelFiles();

  const totalCount = files.length;
  const totalSize = files.reduce((sum, f) => sum + f.file_size, 0);
  const averageSize = totalCount > 0 ? totalSize / totalCount : 0;

  return {
    totalCount,
    totalSize,
    averageSize
  };
}

/**
 * Search model files by multiple criteria
 */
export async function searchModelFiles(filters: {
  title?: string;
  author?: string;
  materialType?: string;
  minSize?: number;
  maxSize?: number;
}): Promise<ModelFile[]> {
  type Condition = ReturnType<typeof like> | ReturnType<typeof eq>;
  const conditions: Condition[] = [];

  if (filters.title) {
    conditions.push(like(modelFiles.title, `%${filters.title}%`));
  }

  if (filters.author) {
    conditions.push(like(modelFiles.author, `%${filters.author}%`));
  }

  if (filters.materialType) {
    conditions.push(eq(modelFiles.material_type, filters.materialType));
  }

  const [result, error] = await tryPromise(
    conditions.length > 0
      ? getDB()
          .select()
          .from(modelFiles)
          .where(and(...conditions))
          .orderBy(desc(modelFiles.uploaded_at))
      : getDB().select().from(modelFiles).orderBy(desc(modelFiles.uploaded_at))
  );

  if (error) {
    logger.error('Failed to search model files', {
      filters,
      error: error.message,
      stack: error.stack
    });
    return [];
  }

  return result;
}

// Model manager object for route handlers
export const modelManager = {
  getModelFile,
  getModelFiles,
  getModelFileByPath,
  createModelFile,
  uploadModelFile,
  updateModelFile,
  deleteModelFile: deleteModelFileById,
  getModelFileStats,
  searchModelFiles
};
