/**
 * Auto power-on service for Home Assistant integration
 * Handles automatic printer power-on when jobs are assigned
 */

import { homeAssistantClient } from './homeassistant-client';
import { deviceManager } from './device-manager';
import { eventBus } from '../../shared/services/event-bus';
import { mqttManager } from '../../printer/services/mqtt-manager';
import { createLogger } from '../../shared/utils/logger';
import { tryPromise } from '@julian-i/try-error';
import { getPrinterHAConfig } from '../database';
import type { PrinterState, PrinterStatus } from '../../printer/types/printer';

const logger = createLogger('ha-auto-power-on');

interface PowerOnState {
	printerId: number;
	entityId: string;
	startedAt: Date;
}

class AutoPowerOnService {
	private activePowerOns = new Map<number, PowerOnState>();
	private readonly PRINTER_READY_TIMEOUT = 120000; // 2 minutes
	private readonly READY_CHECK_INTERVAL = 3000; // Check every 3 seconds

	constructor() {
		this.setupEventListeners();
	}

	/**
	 * Setup event listeners
	 */
	private setupEventListeners(): void {
		// Listen for job assignment events
		eventBus.on('job:updated', async (data) => {
			if (data.assigned_printer) {
				logger.info('Job updated with printer assignment', {
					jobId: data.id,
					printerId: data.assigned_printer
				});
				await this.handleJobAssigned(data.id, data.assigned_printer);
			}
		});

		// Listen for printer state changes to detect ready state
		eventBus.on('printer:state', (state: PrinterState) => {
			this.checkPrinterReady(state);
		});
	}

	/**
	 * Handle job assignment event
	 */
	private async handleJobAssigned(jobId: number, printerId: number): Promise<void> {
		// Check if already power-on in progress
		if (this.activePowerOns.has(printerId)) {
			logger.info('Power-on already in progress for printer', { printerId });
			return;
		}

		// Get printer configuration
		const printerConfig = await this.getPrinterConfig(printerId);

		if (!printerConfig) {
			logger.error('Printer not found', { printerId });
			return;
		}

		// Check if entity is configured
		if (!printerConfig.home_assistant_entity_id) {
			logger.info('No Home Assistant entity configured for printer', {
				printerId
			});
			return;
		}

		// Check if printer is already connected
		if (mqttManager.isConnected(printerId)) {
			logger.info('Printer already connected, skipping power-on', { printerId });
			return;
		}

		// Check Home Assistant connection
		if (!homeAssistantClient.isConnected()) {
			logger.error('Home Assistant not connected');
			return;
		}

		// Check current switch state
		const entityState = homeAssistantClient.getEntityState(
			printerConfig.home_assistant_entity_id
		);

		if (!entityState) {
			logger.error('Entity not found in Home Assistant', {
				entityId: printerConfig.home_assistant_entity_id
			});
			return;
		}

		const isAlreadyOn = entityState.state === 'on';
		if (isAlreadyOn) {
			logger.info('Switch already on, waiting for printer connection', {
				printerId,
				entityId: printerConfig.home_assistant_entity_id
			});
			// Still wait for printer to be ready
			this.waitForPrinterReady(printerId);
			return;
		}

		// Turn on the switch
		logger.info('Turning on printer switch', {
			printerId,
			entityId: printerConfig.home_assistant_entity_id
		});

		const [success, error] = await tryPromise(
			homeAssistantClient.turnOn(printerConfig.home_assistant_entity_id)
		);

		if (error || !success) {
			logger.error('Failed to turn on switch', {
				printerId,
				entityId: printerConfig.home_assistant_entity_id,
				error: error?.message
			});
			return;
		}

		logger.info('Printer switch turned on successfully', {
			printerId,
			entityId: printerConfig.home_assistant_entity_id
		});

		// Wait for printer to be ready
		this.waitForPrinterReady(printerId);
	}

	/**
	 * Wait for printer to be ready after power-on
	 */
	private waitForPrinterReady(printerId: number): void {
		logger.info('Waiting for printer to be ready', { printerId });

		const powerOnState: PowerOnState = {
			printerId,
			entityId: '', // Will be filled in when we have config
			startedAt: new Date()
		};

		this.activePowerOns.set(printerId, powerOnState);

		// Set timeout for printer readiness
		setTimeout(() => {
			if (this.activePowerOns.has(printerId)) {
				logger.warn('Printer ready timeout exceeded', { printerId });
				this.activePowerOns.delete(printerId);
			}
		}, this.PRINTER_READY_TIMEOUT);
	}

	/**
	 * Check if printer is ready based on state updates
	 */
	private checkPrinterReady(state: PrinterState): void {
		const powerOn = this.activePowerOns.get(state.printerId);
		if (!powerOn) return;

		// Check if printer is connected and in IDLE or READY state
		const isConnected = mqttManager.isConnected(state.printerId);
		const isReady =
			state.status === 'IDLE' ||
			state.status === 'PREPARE' ||
			state.status === 'UNKNOWN';

		if (isConnected && isReady) {
			logger.info('Printer is ready after power-on', {
				printerId: state.printerId,
				status: state.status,
				timeToReady: Date.now() - powerOn.startedAt.getTime()
			});

			this.activePowerOns.delete(state.printerId);

			// Emit event that printer is ready
			eventBus.emit('printer:ready', {
				printerId: state.printerId
			});
		}
	}

	/**
	 * Cancel power-on wait
	 */
	cancelPowerOn(printerId: number): boolean {
		const cancelled = this.activePowerOns.delete(printerId);
		if (cancelled) {
			logger.info('Power-on cancelled', { printerId });
		}
		return cancelled;
	}

	/**
	 * Get all active power-on states
	 */
	getActivePowerOns(): { printerId: number; startedAt: Date }[] {
		return Array.from(this.activePowerOns.values()).map((s) => ({
			printerId: s.printerId,
			startedAt: s.startedAt
		}));
	}

	/**
	 * Get printer configuration from database
	 */
	private async getPrinterConfig(printerId: number): Promise<{
		home_assistant_entity_id: string | null;
		auto_shutdown_enabled: boolean;
		shutdown_delay_minutes: number;
		power_threshold_watts: number;
		power_verification_seconds: number;
	} | null> {
		return await getPrinterHAConfig(printerId);
	}
}

// Singleton instance
export const autoPowerOnService = new AutoPowerOnService();

// Alias for compatibility with existing imports
export const autoPowerOn = autoPowerOnService;
