<script lang="ts">
	import { EditDescription, FileUpload } from '@/shared';
	import Model3DViewer from '../components/Model3DViewer.svelte';
	import ModelFileCard from '../components/ModelFileCard.svelte';
	import ModelFileModal from '../components/ModelFileModal.svelte';
	import { modelFiles, printers, library } from '@/api';
	import type { ModelFile } from '../types/model';
	import JobModal from '@/job/components/JobModal.svelte';
	import type { Printer } from '@/types/printer';
	import {
		IconArrowDown,
		IconArrowUp,
		IconEdit,
		IconGridDots,
		IconList,
		IconPrinter,
		IconRefresh,
		IconSearch,
		IconUpload
	} from '@tabler/icons-svelte';
	import { createLogger } from '@/shared/utils/logger';
	import { useQueryClient } from '@tanstack/svelte-query';

	const logger = createLogger('model.library-page');

	interface Props {
		data?: Record<string, unknown>;
	}

	let { data }: Props = $props();

	// View mode: 'grid' or 'list'
	let viewMode = $state<'grid' | 'list'>('grid');

	// Search and filter
	let searchQuery = $state('');

	// Sorting
	let sortBy = $state<'name' | 'date' | 'size'>('date');
	let sortOrder = $state<'asc' | 'desc'>('desc');

	// Modals
	let uploadModalOpen = $state(false);
	let selectedFile: ModelFile | null = $state(null);
	let detailModalOpen = $state(false);
	let viewerModalOpen = $state(false);
	let editModalOpen = $state(false);
	let selectedFileIdForViewer: number | null = $state(null);

	// Upload file
	let uploadFile: File | null = $state(null);

	// Job modal state
	let showJobModal = $state(false);
	let preselectedModelFile = $state<ModelFile | null>(null);

	// TanStack Query
	const queryClient = useQueryClient();
	const modelFilesQuery = modelFiles.useModelFiles();
	const printersQuery = printers.usePrinters();

	// Upload mutation
	const uploadMutation = modelFiles.useUploadModelFile();
	const updateMutation = modelFiles.useUpdateModelFile();
	const deleteMutation = modelFiles.useDeleteModelFile();

	// Handle add job from library
	function handleAddJob(file: ModelFile) {
		preselectedModelFile = file;
		showJobModal = true;
	}

	// Handle job success
	function handleJobSuccess() {
		showJobModal = false;
		preselectedModelFile = null;
		// Invalidate jobs query to refresh the queue
		queryClient.invalidateQueries({ queryKey: ['jobs'] });
	}

	function handleView3D(fileId: number) {
		logger.info('handleView3D called with fileId:', { fileId });
		selectedFileIdForViewer = fileId;
		logger.info('selectedFileIdForViewer set to:', { selectedFileIdForViewer });
		viewerModalOpen = true;
	}

	function handleEdit(file: ModelFile) {
		selectedFile = file;
		editModalOpen = true;
	}

	async function handleSaveDescription(id: number, data: { title: string; description: string }) {
		try {
			const updatedFile = await updateMutation.mutateAsync({
				id,
				title: data.title,
				description: data.description
			});

			// Update selected file if it's open
			if (selectedFile && selectedFile.id === id) {
				selectedFile = updatedFile;
			}
		} catch (error) {
			logger.error('Failed to save description:', {
				error: error instanceof Error ? error.message : String(error),
				stack: error instanceof Error ? error.stack : undefined
			});
			throw error;
		}
	}

	async function handleDelete(id: number) {
		if (!confirm('Are you sure you want to delete this model file?')) return;

		try {
			await deleteMutation.mutateAsync(id);
			if (selectedFile && selectedFile.id === id) {
				detailModalOpen = false;
				selectedFile = null;
			}
		} catch (error) {
			logger.error('Delete failed:', {
				error: error instanceof Error ? error.message : String(error),
				stack: error instanceof Error ? error.stack : undefined
			});
		}
	}

	async function handleUpload() {
		if (!uploadFile) return;

		try {
			await uploadMutation.mutateAsync({ file: uploadFile });
			uploadFile = null;
			uploadModalOpen = false;
		} catch (error) {
			logger.error('Upload failed:', {
				error: error instanceof Error ? error.message : String(error),
				stack: error instanceof Error ? error.stack : undefined
			});
		}
	}

	function handleRefresh() {
		modelFilesQuery.refetch();
	}

	// Sort and filter files - done via query, but we can apply client-side sorting if needed
	function getSortedAndFilteredFiles() {
		return modelFilesQuery.data || [];
	}
</script>

<div class="space-y-6">
	<!-- Header -->
	<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<div>
			<h1 class="text-3xl font-bold text-foreground">3D Model Library</h1>
			<p class="mt-1 text-muted-foreground">Manage and view your 3MF model files</p>
		</div>

		<div class="flex items-center space-x-3">
			<button
				type="button"
				onclick={handleRefresh}
				class="rounded-lg bg-secondary px-4 py-2 font-medium text-secondary-foreground transition-colors hover:bg-secondary/80"
				aria-label="Refresh models"
			>
				<IconRefresh size={20} />
			</button>
			<button
				type="button"
				onclick={() => (uploadModalOpen = true)}
				class="flex items-center space-x-2 rounded-lg bg-primary px-4 py-2 font-medium text-primary-foreground transition-colors hover:bg-primary/90"
			>
				<IconUpload size={20} />
				<span>Upload Model</span>
			</button>
		</div>
	</div>

	<!-- Stats -->
	<div class="grid gap-4 sm:grid-cols-3">
		<div class="rounded-lg bg-card p-4">
			<p class="text-sm text-muted-foreground">Total Models</p>
			<p class="mt-1 text-2xl font-bold text-foreground">{modelFilesQuery.data?.length || 0}</p>
		</div>
		<div class="rounded-lg bg-card p-4">
			<p class="text-sm text-muted-foreground">Total Size</p>
			<p class="mt-1 text-2xl font-bold text-foreground">
				{(
					(modelFilesQuery.data?.reduce((acc, f) => acc + f.file_size, 0) || 0) /
					1024 /
					1024
				).toFixed(1)} MB
			</p>
		</div>
		<div class="rounded-lg bg-card p-4">
			<p class="text-sm text-muted-foreground">Average Size</p>
			<p class="mt-1 text-2xl font-bold text-foreground">
				{modelFilesQuery.data && modelFilesQuery.data.length > 0
					? (
							(modelFilesQuery.data.reduce((acc, f) => acc + f.file_size, 0) /
								modelFilesQuery.data.length) /
							1024 /
							1024
						).toFixed(1)
					: '0.0'} MB
			</p>
		</div>
	</div>

	<!-- Search and Filters -->
	<div class="flex flex-col gap-4 sm:flex-row">
		<div class="relative flex-1">
			<IconSearch class="absolute top-1/2 left-3 h-5 w-5 -translate-y-1/2 text-muted-foreground" />
			<input
				type="text"
				bind:value={searchQuery}
				placeholder="Search models by name, title, or description..."
				class="w-full rounded-lg border border-input bg-background py-2 pr-4 pl-10 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none"
			/>
		</div>

		<div class="flex items-center space-x-2">
			<!-- Sort By -->
			<select
				bind:value={sortBy}
				class="rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none"
			>
				<option value="date">Sort by Date</option>
				<option value="name">Sort by Name</option>
				<option value="size">Sort by Size</option>
			</select>

			<!-- Sort Order -->
			<button
				type="button"
				onclick={() => (sortOrder = sortOrder === 'asc' ? 'desc' : 'asc')}
				class="rounded-lg bg-secondary p-2 text-secondary-foreground transition-colors hover:bg-secondary/80"
				aria-label={`Sort ${sortOrder === 'asc' ? 'descending' : 'ascending'}`}
			>
				{#if sortOrder === 'asc'}
					<IconArrowUp size={20} />
				{:else}
					<IconArrowDown size={20} />
				{/if}
			</button>

			<!-- View Mode -->
			<button
				type="button"
				onclick={() => (viewMode = viewMode === 'grid' ? 'list' : 'grid')}
				class="rounded-lg bg-secondary p-2 text-secondary-foreground transition-colors hover:bg-secondary/80"
				aria-label={viewMode === 'grid' ? 'Switch to list view' : 'Switch to grid view'}
			>
				{#if viewMode === 'grid'}
					<IconGridDots size={20} />
				{:else}
					<IconList size={20} />
				{/if}
			</button>
		</div>
	</div>

	<!-- Loading State -->
	{#if modelFilesQuery.isLoading}
		<div class="flex items-center justify-center py-12">
			<div class="text-center">
				<div
					class="mb-4 h-12 w-12 animate-spin rounded-full border-4 border-primary border-t-transparent"
				></div>
				<p class="text-muted-foreground">Loading models...</p>
			</div>
		</div>
	{:else if modelFilesQuery.error}
		<div class="rounded-lg border border-destructive bg-destructive/10 p-4">
			<p class="text-destructive">{modelFilesQuery.error.message}</p>
			<button
				type="button"
				onclick={() => modelFilesQuery.refetch()}
				class="mt-2 text-sm text-destructive underline hover:text-destructive/80"
			>
				Retry
			</button>
		</div>
	{:else if getSortedAndFilteredFiles().length === 0}
		<div
			class="flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-border py-12"
		>
			<svg
				class="mb-4 h-16 w-16 text-muted-foreground"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
				/>
			</svg>
			<h3 class="text-lg font-medium text-foreground">No models found</h3>
			<p class="mt-1 text-muted-foreground">
				{#if searchQuery}
					Try a different search term
				{:else}
					Upload your first 3MF model to get started
				{/if}
			</p>
			{#if !searchQuery}
				<button
					type="button"
					onclick={() => (uploadModalOpen = true)}
					class="mt-4 flex items-center space-x-2 rounded-lg bg-primary px-4 py-2 font-medium text-primary-foreground transition-colors hover:bg-primary/90"
				>
					<IconUpload size={20} />
					<span>Upload Model</span>
				</button>
			{/if}
		</div>
	{:else}
		<!-- Grid View -->
		{#if viewMode === 'grid'}
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{#each getSortedAndFilteredFiles() as file (file.id)}
					<ModelFileCard
						{file}
						onView={(id) => handleView3D(id)}
						onDelete={handleDelete}
						onEdit={() => handleEdit(file)}
						onAddJob={handleAddJob}
					/>
				{/each}
			</div>
			<!-- List View -->
		{:else}
			<div class="overflow-hidden rounded-lg border border-border bg-card">
				<table class="min-w-full divide-y divide-border">
					<thead class="bg-muted/50">
						<tr>
							<th
								class="px-6 py-3 text-left text-xs font-medium tracking-wider text-muted-foreground uppercase"
							>
								Model
							</th>
							<th
								class="px-6 py-3 text-left text-xs font-medium tracking-wider text-muted-foreground uppercase"
							>
								Size
							</th>
							<th
								class="px-6 py-3 text-left text-xs font-medium tracking-wider text-muted-foreground uppercase"
							>
								Dimensions
							</th>
							<th
								class="px-6 py-3 text-left text-xs font-medium tracking-wider text-muted-foreground uppercase"
							>
								Print Time
							</th>
							<th
								class="px-6 py-3 text-left text-xs font-medium tracking-wider text-muted-foreground uppercase"
							>
								Uploaded
							</th>
							<th
								class="px-6 py-3 text-right text-xs font-medium tracking-wider text-muted-foreground uppercase"
							>
								Actions
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						{#each getSortedAndFilteredFiles() as file (file.id)}
							<tr class="transition-colors hover:bg-muted/50">
								<td class="px-6 py-4">
									<div class="flex items-center">
										{#if file.thumbnail_data}
											<img
												src={file.thumbnail_data}
												alt={file.title || file.file_name}
												class="mr-4 h-12 w-12 rounded bg-muted object-cover"
											/>
										{:else}
											<div class="mr-4 flex h-12 w-12 items-center justify-center rounded bg-muted">
												<svg
													class="h-6 w-6 text-muted-foreground"
													fill="none"
													viewBox="0 0 24 24"
													stroke="currentColor"
												>
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
													/>
												</svg>
											</div>
										{/if}
										<div>
											<div class="text-sm font-medium text-foreground">
												{file.title || file.file_name}
											</div>
											{#if file.description}
												<div class="line-clamp-1 text-xs text-muted-foreground">
													{file.description}
												</div>
											{/if}
										</div>
									</div>
								</td>
								<td class="px-6 py-4 text-sm text-muted-foreground">
									{(file.file_size / 1024 / 1024).toFixed(2)} MB
								</td>
								<td class="px-6 py-4 text-sm text-muted-foreground">
									{#if file.width && file.height && file.depth}
										{file.width.toFixed(1)} × {file.height.toFixed(1)} × {file.depth.toFixed(1)} mm
									{:else}
										N/A
									{/if}
								</td>
								<td class="px-6 py-4 text-sm text-muted-foreground">
									{file.print_time_estimate
										? `${Math.round(file.print_time_estimate / 60)} min`
										: 'N/A'}
								</td>
								<td class="px-6 py-4 text-sm text-muted-foreground">
									{new Date(file.uploaded_at).toLocaleDateString()}
								</td>
								<td class="px-6 py-4 text-right">
									<div class="flex justify-end space-x-2">
										<button
											type="button"
											onclick={() => handleEdit(file)}
											class="rounded-md bg-secondary p-2 text-secondary-foreground transition-colors hover:bg-primary"
											aria-label="Edit description"
										>
											<IconEdit size={16} />
										</button>
										<button
											type="button"
											onclick={() => handleView3D(file.id)}
											class="rounded-md bg-secondary p-2 text-secondary-foreground transition-colors hover:bg-primary"
											aria-label="View 3D"
										>
											<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
												/>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
												/>
											</svg>
										</button>
										<button
											type="button"
											onclick={() => handleAddJob(file)}
											class="rounded-md bg-secondary p-2 text-secondary-foreground transition-colors hover:bg-green-600"
											aria-label="Add to print queue"
										>
											<IconPrinter size={16} />
										</button>
										<a
											href={`/api/model-files/${file.id}/download`}
											download
											class="rounded-md bg-secondary p-2 text-secondary-foreground transition-colors hover:bg-primary"
											aria-label="Download"
										>
											<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
												/>
											</svg>
										</a>
										<button
											type="button"
											onclick={() => handleDelete(file.id)}
											class="rounded-md bg-secondary p-2 text-secondary-foreground transition-colors hover:bg-destructive"
											aria-label="Delete"
										>
											<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
												/>
											</svg>
										</button>
									</div>
								</td>
							</tr>
						{/each}
					</tbody>
				</table>
			</div>
		{/if}
	{/if}
</div>

<!-- Upload Modal -->
{#if uploadModalOpen}
	<div
		class="fixed inset-0 z-50 flex items-center justify-center bg-background/80 backdrop-blur-sm"
		role="dialog"
		aria-modal="true"
		aria-labelledby="upload-modal-title"
	>
		<div class="mx-4 w-full max-w-lg rounded-lg bg-card p-6 shadow-2xl">
			<div class="mb-4 flex items-center justify-between">
				<h2 id="upload-modal-title" class="text-xl font-bold text-foreground">Upload 3MF Model</h2>
				<button
					type="button"
					onclick={() => (uploadModalOpen = false)}
					class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
					aria-label="Close upload modal"
				>
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M6 18L18 6M6 6l12 12"
						/>
					</svg>
				</button>
			</div>

			<div class="space-y-4">
				<FileUpload bind:file={uploadFile} name="file" />

				{#if uploadMutation.error}
					<div class="rounded-md border border-destructive bg-destructive/10 p-3">
						<p class="text-sm text-destructive">{uploadMutation.error.message}</p>
					</div>
				{/if}

				<div class="flex justify-end space-x-3">
					<button
						type="button"
						onclick={() => (uploadModalOpen = false)}
						class="rounded-lg bg-secondary px-4 py-2 font-medium text-secondary-foreground transition-colors hover:bg-secondary/80"
					>
						Cancel
					</button>
					<button
						type="button"
						onclick={handleUpload}
						disabled={!uploadFile || uploadMutation.isPending}
						class="rounded-lg bg-primary px-4 py-2 font-medium text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50"
					>
						{uploadMutation.isPending ? 'Uploading...' : 'Upload'}
					</button>
				</div>
			</div>
		</div>
	</div>
{/if}

<!-- Edit Description Modal -->
{#if selectedFile}
	<EditDescription
		bind:open={editModalOpen}
		fileId={selectedFile.id}
		fileName={selectedFile.file_name}
		currentTitle={selectedFile.title}
		currentDescription={selectedFile.description}
		onSave={handleSaveDescription}
	/>
{/if}

<!-- Detail Modal -->
{#if selectedFile}
	<ModelFileModal
		bind:open={detailModalOpen}
		file={selectedFile}
		onDelete={() => handleDelete(selectedFile!.id)}
	/>
{/if}

<!-- 3D Viewer Modal -->
<Model3DViewer
	bind:open={viewerModalOpen}
	fileId={selectedFileIdForViewer}
	fileName={selectedFile?.file_name ?? 'Model'}
	thumbnail={selectedFile?.thumbnail_data ?? null}
/>

<!-- Job Modal -->
<JobModal
	bind:open={showJobModal}
	printers={printersQuery.data || []}
	preselectedFile={preselectedModelFile}
	onsuccess={handleJobSuccess}
/>
