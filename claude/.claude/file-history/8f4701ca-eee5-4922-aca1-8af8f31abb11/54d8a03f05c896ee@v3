// Configuration shared between plate and case
switch_cutout_size = 14;
key_spacing = 19.05;
plate_thickness = 1.5;
edge_margin = 2;

rows = 5;
cols = 3;

// Calculate plate dimensions
plate_width = ((cols + 1) * key_spacing) + (2 * edge_margin);
plate_height = (rows * key_spacing) + (2 * edge_margin);

// Bridge configuration
is_full_height = true;
user_height = 20;

bridge_length = 55;  // Distance between the two halves
bridge_height = is_full_height ? (plate_height - key_spacing) : user_height;

// X-axis tilt configuration (tilt forward/back on Y-axis rotation)
x_tilt_enabled = false;
x_tilt_angle = 10;  // Angle in degrees (0-20) for X-axis tilt

// Z-axis tilt configuration (rotate inward from top view)
z_tilt_enabled = true;
z_tilt_angle = 15;  // Angle in degrees (0-45) for Z-axis rotation inward
