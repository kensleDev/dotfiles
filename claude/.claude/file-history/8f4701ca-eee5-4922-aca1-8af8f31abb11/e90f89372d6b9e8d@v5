include <keyboard_config.scad>

// Module for one half of the keyboard
module keyboard_half() {
    difference() {
        // Base plate - simple square
        cube([plate_width, plate_height, plate_thickness]);

        // Main 3x5 grid cutouts
        for (row = [0:rows-1]) {
            for (col = [0:cols-1]) {
                translate([
                    edge_margin + (col * key_spacing) + (key_spacing/2) - (switch_cutout_size/2),
                    edge_margin + (row * key_spacing) + (key_spacing/2) - (switch_cutout_size/2),
                    -0.1
                ])
                cube([switch_cutout_size, switch_cutout_size, plate_thickness + 0.2]);
            }
        }

        // Thumb cluster
        for (thumb_row = [2:4]) {
            translate([
                edge_margin + (cols * key_spacing) + (key_spacing/2) - (switch_cutout_size/2),
                edge_margin + (thumb_row * key_spacing) + (key_spacing/2) - (switch_cutout_size/2),
                -0.1
            ])
            cube([switch_cutout_size, switch_cutout_size, plate_thickness + 0.2]);
        }
    }
}

// X-axis bridge (tilt forward/back) - sloped top
module x_tilt_bridge_piece() {
    front_width = bridge_height;
    back_width = bridge_height;
    top_front_width = bridge_height * cos(x_tilt_angle);
    top_back_width = bridge_height * cos(x_tilt_angle);

    hull() {
        // Front face
        translate([0, 0, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([front_width, 0, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([(bridge_height - top_front_width) / 2, 0, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([(bridge_height + top_front_width) / 2, 0, 0])
        cylinder(r=0.01, h=plate_thickness);

        // Back face
        translate([0, bridge_length, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([back_width, bridge_length, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([(bridge_height - top_back_width) / 2, bridge_length, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([(bridge_height + top_back_width) / 2, bridge_length, 0])
        cylinder(r=0.01, h=plate_thickness);
    }
}

// Z-axis bridge (rotate inward) - trapezoid connecting angled halves
module z_tilt_bridge_piece() {
    // Left half rotates clockwise, so its inner edge angles back-right
    // Right half rotates clockwise, so its inner edge angles back-right (from mirror perspective)
    // Bridge needs to connect these angled edges

    // Offsets for where the rotated corners end up
    left_offset = plate_height * sin(z_tilt_angle);
    right_offset = plate_height * sin(z_tilt_angle);

    hull() {
        // Front of bridge (y=0, at plate_height)
        // Left corners - offset to match left half's angled inner edge
        translate([-left_offset, 0, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([bridge_height - left_offset, 0, 0])
        cylinder(r=0.01, h=plate_thickness);

        // Right corners - offset to match right half's angled inner edge
        translate([right_offset, 0, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([bridge_height + right_offset, 0, 0])
        cylinder(r=0.01, h=plate_thickness);

        // Back of bridge (y=bridge_length)
        // Left corners
        translate([-left_offset, bridge_length, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([bridge_height - left_offset, bridge_length, 0])
        cylinder(r=0.01, h=plate_thickness);

        // Right corners
        translate([right_offset, bridge_length, 0])
        cylinder(r=0.01, h=plate_thickness);
        translate([bridge_height + right_offset, bridge_length, 0])
        cylinder(r=0.01, h=plate_thickness);
    }
}

// Bridge module - handles all tilt combinations
module bridge_piece() {
    if (z_tilt_enabled) {
        z_tilt_bridge_piece();
    } else if (x_tilt_enabled) {
        x_tilt_bridge_piece();
    } else {
        // Rectangular bridge for no tilt
        cube([bridge_height, bridge_length, plate_thickness]);
    }
}

// Assemble the full keyboard
module keyboard_plate() {
    union() {
        // Left half
        translate([0, plate_height, 0]) {
            if (z_tilt_enabled) {
                // Z-axis tilt (inward rotation) - clockwise around inner-right corner
                translate([plate_width, 0, 0])
                rotate([0, 0, -z_tilt_angle])
                translate([-plate_width, -plate_height, 0])
                keyboard_half();
            } else if (x_tilt_enabled) {
                // X-axis tilt (forward/back on Y-axis rotation)
                rotate([x_tilt_angle, 0, 0])
                translate([0, -plate_height, 0])
                keyboard_half();
            } else {
                keyboard_half();
            }
        }

        // Bridge piece
        translate([(plate_width - bridge_height) / 2, plate_height, 0])
        bridge_piece();

        // Right half (mirrored)
        translate([0, plate_height + bridge_length + plate_height, 0]) {
            if (z_tilt_enabled) {
                // Z-axis tilt (inward rotation) - clockwise around inner-left corner
                mirror([0, 1, 0])
                translate([0, plate_height, 0])
                translate([0, 0, 0])
                rotate([0, 0, -z_tilt_angle])
                translate([0, -plate_height, 0])
                keyboard_half();
            } else if (x_tilt_enabled) {
                // X-axis tilt (forward/back on Y-axis rotation)
                mirror([0, 1, 0])
                translate([0, plate_height, 0])
                rotate([x_tilt_angle, 0, 0])
                translate([0, -plate_height, 0])
                keyboard_half();
            } else {
                mirror([0, 1, 0])
                keyboard_half();
            }
        }
    }
}

// Render the plate by default
keyboard_plate();
