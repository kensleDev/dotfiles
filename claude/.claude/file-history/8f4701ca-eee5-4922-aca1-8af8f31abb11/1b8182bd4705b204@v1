include <keyboard_config.scad>

// Case configuration
plate_gap = 0.2;  // Gap around the plate
case_wall_thickness = 2;  // Thickness of case walls
case_height = 10;  // Height of the case

// Bridge module matching the plate bridge geometry
module case_bridge_piece() {
    if (tilt_enabled) {
        // Trapezoidal bridge for tilted halves
        front_width = bridge_height;
        back_width = bridge_height;
        top_front_width = bridge_height * cos(tilt_angle);
        top_back_width = bridge_height * cos(tilt_angle);

        // Create a prism with sloped sides
        hull() {
            // Front face (at Y = plate_height)
            // Bottom corners
            translate([0, 0, 0])
            cylinder(r=0.01, h=case_height);
            translate([front_width, 0, 0])
            cylinder(r=0.01, h=case_height);
            // Top corners (narrower due to tilt)
            translate([(bridge_height - top_front_width) / 2, 0, 0])
            cylinder(r=0.01, h=case_height);
            translate([(bridge_height + top_front_width) / 2, 0, 0])
            cylinder(r=0.01, h=case_height);

            // Back face (at Y = plate_height + bridge_length)
            // Bottom corners
            translate([0, bridge_length, 0])
            cylinder(r=0.01, h=case_height);
            translate([back_width, bridge_length, 0])
            cylinder(r=0.01, h=case_height);
            // Top corners (narrower due to tilt)
            translate([(bridge_height - top_back_width) / 2, bridge_length, 0])
            cylinder(r=0.01, h=case_height);
            translate([(bridge_height + top_back_width) / 2, bridge_length, 0])
            cylinder(r=0.01, h=case_height);
        }
    } else {
        // Rectangular bridge for no tilt
        cube([bridge_height, bridge_length, case_height]);
    }
}

// Case (follows plate shape with gap)
difference() {
    // Outer case shell
    minkowski() {
        // Base shape matching the plate outline
        union() {
            // Left half footprint - tilted if enabled
            if (tilt_enabled) {
                translate([0, plate_height, 0])
                rotate([tilt_angle, 0, 0])
                translate([0, -plate_height, 0])
                cube([plate_width, plate_height, case_height]);
            } else {
                cube([plate_width, plate_height, case_height]);
            }

            // Bridge footprint
            translate([(plate_width - bridge_height) / 2, plate_height, 0])
            case_bridge_piece();

            // Right half footprint - tilted if enabled
            if (tilt_enabled) {
                translate([0, plate_height + bridge_length + plate_height, 0])
                mirror([0, 1, 0])
                translate([0, plate_height, 0])
                rotate([tilt_angle, 0, 0])
                translate([0, -plate_height, 0])
                cube([plate_width, plate_height, case_height]);
            } else {
                translate([0, plate_height + bridge_length, 0])
                cube([plate_width, plate_height, case_height]);
            }
        }

        // Add gap + wall thickness around entire shape
        sphere(r = plate_gap + case_wall_thickness);
    }

    // Hollow out interior (plate gap only) - side walls
    translate([0, 0, case_wall_thickness])
    minkowski() {
        union() {
            // Left half cutout - tilted if enabled
            if (tilt_enabled) {
                translate([0, plate_height, 0])
                rotate([tilt_angle, 0, 0])
                translate([0, -plate_height, 0])
                cube([plate_width, plate_height, case_height - case_wall_thickness]);
            } else {
                cube([plate_width, plate_height, case_height - case_wall_thickness]);
            }

            // Bridge cutout
            translate([(plate_width - bridge_height) / 2, plate_height, 0])
            case_bridge_piece();

            // Right half cutout - tilted if enabled
            if (tilt_enabled) {
                translate([0, plate_height + bridge_length + plate_height, 0])
                mirror([0, 1, 0])
                translate([0, plate_height, 0])
                rotate([tilt_angle, 0, 0])
                translate([0, -plate_height, 0])
                cube([plate_width, plate_height, case_height - case_wall_thickness]);
            } else {
                translate([0, plate_height + bridge_length, 0])
                cube([plate_width, plate_height, case_height - case_wall_thickness]);
            }
        }

        sphere(r = plate_gap);
    }

    // Plate-shaped opening at top (aligned with base cubes)
    translate([0, 0, case_wall_thickness])
    minkowski() {
        union() {
            // Left half opening - tilted if enabled
            if (tilt_enabled) {
                translate([0, plate_height, 0])
                rotate([tilt_angle, 0, 0])
                translate([0, -plate_height, 0])
                cube([plate_width, plate_height, case_height]);
            } else {
                cube([plate_width, plate_height, case_height]);
            }

            // Bridge opening
            translate([(plate_width - bridge_height) / 2, plate_height, 0])
            case_bridge_piece();

            // Right half opening - tilted if enabled
            if (tilt_enabled) {
                translate([0, plate_height + bridge_length + plate_height, 0])
                mirror([0, 1, 0])
                translate([0, plate_height, 0])
                rotate([tilt_angle, 0, 0])
                translate([0, -plate_height, 0])
                cube([plate_width, plate_height, case_height]);
            } else {
                translate([0, plate_height + bridge_length, 0])
                cube([plate_width, plate_height, case_height]);
            }
        }

        sphere(r = plate_gap);
    }
}
