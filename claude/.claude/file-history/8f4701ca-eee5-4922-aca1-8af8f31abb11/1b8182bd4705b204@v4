include <keyboard_config.scad>

// Case configuration
plate_gap = 0.2;  // Gap around the plate
case_wall_thickness = 2;  // Thickness of case walls
case_height = 10;  // Height of the case

// X-axis bridge (tilt forward/back) - sloped top
module x_tilt_case_bridge() {
    front_width = bridge_height;
    back_width = bridge_height;
    top_front_width = bridge_height * cos(x_tilt_angle);
    top_back_width = bridge_height * cos(x_tilt_angle);

    hull() {
        // Front face
        translate([0, 0, 0])
        cylinder(r=0.01, h=case_height);
        translate([front_width, 0, 0])
        cylinder(r=0.01, h=case_height);
        translate([(bridge_height - top_front_width) / 2, 0, 0])
        cylinder(r=0.01, h=case_height);
        translate([(bridge_height + top_front_width) / 2, 0, 0])
        cylinder(r=0.01, h=case_height);

        // Back face
        translate([0, bridge_length, 0])
        cylinder(r=0.01, h=case_height);
        translate([back_width, bridge_length, 0])
        cylinder(r=0.01, h=case_height);
        translate([(bridge_height - top_back_width) / 2, bridge_length, 0])
        cylinder(r=0.01, h=case_height);
        translate([(bridge_height + top_back_width) / 2, bridge_length, 0])
        cylinder(r=0.01, h=case_height);
    }
}

// Z-axis bridge (rotate inward) - trapezoid shape
module z_tilt_case_bridge() {
    left_offset = -plate_height * sin(z_tilt_angle);
    right_offset = -plate_height * sin(z_tilt_angle);

    hull() {
        // Front left corners
        translate([0, 0, 0])
        cylinder(r=0.01, h=case_height);
        translate([bridge_height, 0, 0])
        cylinder(r=0.01, h=case_height);

        // Front right corners (angled)
        translate([left_offset, 0, 0])
        cylinder(r=0.01, h=case_height);
        translate([bridge_height + right_offset, 0, 0])
        cylinder(r=0.01, h=case_height);

        // Back left corners
        translate([0, bridge_length, 0])
        cylinder(r=0.01, h=case_height);
        translate([bridge_height, bridge_length, 0])
        cylinder(r=0.01, h=case_height);

        // Back right corners (angled)
        translate([left_offset, bridge_length, 0])
        cylinder(r=0.01, h=case_height);
        translate([bridge_height + right_offset, bridge_length, 0])
        cylinder(r=0.01, h=case_height);
    }
}

// Bridge module matching the plate
module case_bridge_piece() {
    if (z_tilt_enabled) {
        z_tilt_case_bridge();
    } else if (x_tilt_enabled) {
        x_tilt_case_bridge();
    } else {
        cube([bridge_height, bridge_length, case_height]);
    }
}

// Left half footprint with tilt
module left_half_footprint() {
    if (z_tilt_enabled) {
        translate([0, plate_height, 0])
        translate([plate_width, 0, 0])
        rotate([0, 0, -z_tilt_angle])
        translate([-plate_width, -plate_height, 0])
        cube([plate_width, plate_height, case_height]);
    } else if (x_tilt_enabled) {
        translate([0, plate_height, 0])
        rotate([x_tilt_angle, 0, 0])
        translate([0, -plate_height, 0])
        cube([plate_width, plate_height, case_height]);
    } else {
        cube([plate_width, plate_height, case_height]);
    }
}

// Right half footprint with tilt
module right_half_footprint() {
    if (z_tilt_enabled) {
        translate([0, plate_height + bridge_length + plate_height, 0])
        mirror([0, 1, 0])
        translate([0, plate_height, 0])
        translate([0, 0, 0])
        rotate([0, 0, -z_tilt_angle])
        translate([0, -plate_height, 0])
        cube([plate_width, plate_height, case_height]);
    } else if (x_tilt_enabled) {
        translate([0, plate_height + bridge_length + plate_height, 0])
        mirror([0, 1, 0])
        translate([0, plate_height, 0])
        rotate([x_tilt_angle, 0, 0])
        translate([0, -plate_height, 0])
        cube([plate_width, plate_height, case_height]);
    } else {
        translate([0, plate_height + bridge_length, 0])
        cube([plate_width, plate_height, case_height]);
    }
}

// Case (follows plate shape with gap)
difference() {
    // Outer case shell
    minkowski() {
        union() {
            left_half_footprint();
            translate([(plate_width - bridge_height) / 2, plate_height, 0])
            case_bridge_piece();
            right_half_footprint();
        }
        sphere(r = plate_gap + case_wall_thickness);
    }

    // Hollow out interior (plate gap only) - side walls
    translate([0, 0, case_wall_thickness])
    minkowski() {
        union() {
            left_half_footprint();
            translate([(plate_width - bridge_height) / 2, plate_height, 0])
            case_bridge_piece();
            right_half_footprint();
        }
        sphere(r = plate_gap);
    }

    // Plate-shaped opening at top (aligned with base cubes)
    translate([0, 0, case_wall_thickness])
    minkowski() {
        union() {
            left_half_footprint();
            translate([(plate_width - bridge_height) / 2, plate_height, 0])
            case_bridge_piece();
            right_half_footprint();
        }
        sphere(r = plate_gap);
    }
}
