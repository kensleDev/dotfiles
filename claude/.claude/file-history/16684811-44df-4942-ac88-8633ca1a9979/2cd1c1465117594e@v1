import { Hono } from 'hono';
import * as v from 'valibot';
import { getDB, cameras, printers } from '../lib/db';
import { eq, desc } from 'drizzle-orm';
import { tryPromise } from '@julian-i/try-error';
import { createLogger } from '../lib/shared/utils/logger';
import { mqttManager } from '../lib/printer/services/mqtt-manager';
import type { CameraType } from '../lib/printer/types/printer';
import { createCameraSource } from '../lib/shared/services/camera-sources';
import type { Camera } from '../types/camera';

const logger = createLogger('routes:cameras');
const app = new Hono();

// GET /api/cameras/:printerId - Get cameras for printer
app.get('/:printerId', async (c) => {
  const printerId = parseInt(c.req.param('printerId'));
  if (isNaN(printerId)) {
    return c.json({ error: 'Invalid printer ID', status: 'error' }, 400);
  }

  const db = getDB();
  const [result, error] = await tryPromise(
    db
      .select()
      .from(cameras)
      .where(eq(cameras.printer_id, printerId))
      .orderBy(desc(cameras.is_default), desc(cameras.created_at))
  );

  if (error) {
    logger.error('Failed to get cameras', { printerId, error: error.message });
    return c.json({ error: 'Failed to get cameras', status: 'error' }, 500);
  }

  // Find default camera
  const defaultCamera = result.find((c) => c.is_default);
  const defaultCameraId = defaultCamera ? defaultCamera.id : null;

  return c.json({
    cameras: result,
    defaultCameraId
  });
});

// POST /api/cameras - Create camera
const CreateCameraSchema = v.object({
  printer_id: v.number(),
  name: v.string(),
  type: v.union([v.literal('builtin'), v.literal('tapo_c110'), v.literal('rtsp_generic')]),
  ip_address: v.optional(v.string()),
  stream_url: v.optional(v.string()),
  camera_account_username: v.optional(v.string()),
  camera_account_password: v.optional(v.string()),
  is_default: v.optional(v.boolean()),
  enabled: v.optional(v.boolean())
});

app.post('/', async (c) => {
  const body = await c.req.json();
  const [parsed, parseError] = v.safeParse(CreateCameraSchema, body);

  if (!parsed.success) {
    return c.json({ error: 'Invalid input', issues: parseError.issues, status: 'error' }, 400);
  }

  const input = parsed.output;
  const db = getDB();

  const [result, insertError] = await tryPromise(
    db
      .insert(cameras)
      .values({
        printer_id: input.printer_id,
        name: input.name,
        type: input.type,
        ip_address: input.ip_address ?? null,
        stream_url: input.stream_url ?? null,
        camera_account_username: input.camera_account_username ?? null,
        camera_account_password: input.camera_account_password ?? null,
        is_default: input.is_default ?? false,
        enabled: input.enabled ?? true
      })
      .returning()
  );

  if (insertError) {
    logger.error('Failed to create camera', { error: insertError.message });
    return c.json({ error: 'Failed to create camera', status: 'error' }, 500);
  }

  return c.json(result[0], 201);
});

// PUT /api/cameras/:id - Update camera
const UpdateCameraSchema = v.object({
  name: v.optional(v.string()),
  enabled: v.optional(v.boolean()),
  is_default: v.optional(v.boolean()),
  ip_address: v.optional(v.string()),
  stream_url: v.optional(v.string()),
  camera_account_username: v.optional(v.string()),
  camera_account_password: v.optional(v.string())
});

app.put('/:id', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid camera ID', status: 'error' }, 400);
  }

  const body = await c.req.json();
  const [parsed, parseError] = v.safeParse(UpdateCameraSchema, body);

  if (!parsed.success) {
    return c.json({ error: 'Invalid input', issues: parseError.issues, status: 'error' }, 400);
  }

  const input = parsed.output;
  const db = getDB();

  const updateData: Record<string, unknown> = {
    updated_at: new Date()
  };

  if (input.name !== undefined) updateData.name = input.name;
  if (input.enabled !== undefined) updateData.enabled = input.enabled;
  if (input.is_default !== undefined) updateData.is_default = input.is_default;
  if (input.ip_address !== undefined) updateData.ip_address = input.ip_address;
  if (input.stream_url !== undefined) updateData.stream_url = input.stream_url;
  if (input.camera_account_username !== undefined)
    updateData.camera_account_username = input.camera_account_username;
  if (input.camera_account_password !== undefined)
    updateData.camera_account_password = input.camera_account_password;

  const [result, updateError] = await tryPromise(
    db.update(cameras).set(updateData).where(eq(cameras.id, id)).returning()
  );

  if (updateError) {
    logger.error('Failed to update camera', { cameraId: id, error: updateError.message });
    return c.json({ error: 'Failed to update camera', status: 'error' }, 500);
  }

  if (result.length === 0) {
    return c.json({ error: 'Camera not found', status: 'error' }, 404);
  }

  return c.json(result[0]);
});

// DELETE /api/cameras/:id - Delete camera
app.delete('/:id', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid camera ID', status: 'error' }, 400);
  }

  const db = getDB();
  const [result, deleteError] = await tryPromise(db.delete(cameras).where(eq(cameras.id, id)));

  if (deleteError) {
    logger.error('Failed to delete camera', { cameraId: id, error: deleteError.message });
    return c.json({ error: 'Failed to delete camera', status: 'error' }, 500);
  }

  return c.json({ success: true });
});

