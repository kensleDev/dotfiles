import { Hono } from 'hono';
import * as v from 'valibot';
import { getDB, printers, cameras } from '../lib/db';
import { eq, desc, asc } from 'drizzle-orm';
import { mqttManager } from '../lib/printer/services/mqtt-manager';
import type { Printer } from '../lib/printer/types/printer';
import { tryPromise } from '@julian-i/try-error';
import { createLogger } from '../lib/shared/utils/logger';

const logger = createLogger('routes:printers');
const app = new Hono();

// GET /api/printers - List all printers
app.get('/', async (c) => {
  const db = getDB();
  const [result, error] = await tryPromise(
    db.select().from(printers).orderBy(desc(printers.created_at))
  );

  if (error) {
    logger.error('Failed to list printers', { error: error.message });
    return c.json({ error: 'Failed to list printers', status: 'error' }, 500);
  }

  // Add connection status
  const printersWithStatus = result.map((printer) => ({
    ...printer,
    connected: mqttManager.isConnected(printer.id),
    connecting: mqttManager.isConnecting(printer.id),
    connectionError: mqttManager.getConnectionError(printer.id)
  }));

  return c.json(printersWithStatus);
});

// GET /api/printers/:id - Get single printer
app.get('/:id', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid printer ID', status: 'error' }, 400);
  }

  const db = getDB();
  const [result, error] = await tryPromise(
    db.select().from(printers).where(eq(printers.id, id)).limit(1)
  );

  if (error) {
    logger.error('Failed to get printer', { printerId: id, error: error.message });
    return c.json({ error: 'Failed to get printer', status: 'error' }, 500);
  }

  if (result.length === 0) {
    return c.json({ error: 'Printer not found', status: 'error' }, 404);
  }

  const printer = result[0];
  const printerWithStatus = {
    ...printer,
    connected: mqttManager.isConnected(printer.id),
    connecting: mqttManager.isConnecting(printer.id),
    connectionError: mqttManager.getConnectionError(printer.id),
    state: mqttManager.getPrinterStatus(printer.id)
  };

  return c.json(printerWithStatus);
});

// POST /api/printers - Create printer
const CreatePrinterSchema = v.object({
  name: v.string(),
  serial: v.string(),
  ip: v.string(),
  access_code: v.string(),
  model_type: v.union([v.literal('A1_MINI'), v.literal('A1'), v.literal('P1S')]),
  actuator_id: v.optional(v.number()),
  custom_gcode: v.optional(v.string()),
  cooldown_time: v.optional(v.number()),
  enabled: v.optional(v.boolean())
});

app.post('/', async (c) => {
  const body = await c.req.json();
  const [parsed, parseError] = v.safeParse(CreatePrinterSchema, body);

  if (!parsed.success) {
    return c.json({ error: 'Invalid input', issues: parseError.issues, status: 'error' }, 400);
  }

  const input = parsed.output;
  const db = getDB();

  const [result, insertError] = await tryPromise(
    db
      .insert(printers)
      .values({
        name: input.name,
        serial: input.serial,
        ip: input.ip,
        access_code: input.access_code,
        model_type: input.model_type,
        actuator_id: input.actuator_id ?? null,
        custom_gcode: input.custom_gcode ?? null,
        cooldown_time: input.cooldown_time ?? 300,
        enabled: input.enabled ?? true
      })
      .returning()
  );

  if (insertError) {
    logger.error('Failed to create printer', { error: insertError.message });
    return c.json({ error: 'Failed to create printer', status: 'error' }, 500);
  }

  return c.json(result[0], 201);
});

// PUT /api/printers/:id - Update printer
const UpdatePrinterSchema = v.object({
  name: v.optional(v.string()),
  serial: v.optional(v.string()),
  ip: v.optional(v.string()),
  access_code: v.optional(v.string()),
  model_type: v.optional(v.union([v.literal('A1_MINI'), v.literal('A1'), v.literal('P1S')])),
  actuator_id: v.optional(v.nullable(v.number())),
  custom_gcode: v.optional(v.nullable(v.string())),
  cooldown_time: v.optional(v.number()),
  enabled: v.optional(v.boolean()),
  home_assistant_entity_id: v.optional(v.nullable(v.string())),
  auto_shutdown_enabled: v.optional(v.boolean()),
  shutdown_delay_minutes: v.optional(v.number()),
  power_threshold_watts: v.optional(v.number()),
  power_verification_seconds: v.optional(v.number())
});

app.put('/:id', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid printer ID', status: 'error' }, 400);
  }

  const body = await c.req.json();
  const [parsed, parseError] = v.safeParse(UpdatePrinterSchema, body);

  if (!parsed.success) {
    return c.json({ error: 'Invalid input', issues: parseError.issues, status: 'error' }, 400);
  }

  const input = parsed.output;
  const db = getDB();

  const updateData: Record<string, unknown> = {
    updated_at: new Date()
  };

  if (input.name !== undefined) updateData.name = input.name;
  if (input.serial !== undefined) updateData.serial = input.serial;
  if (input.ip !== undefined) updateData.ip = input.ip;
  if (input.access_code !== undefined) updateData.access_code = input.access_code;
  if (input.model_type !== undefined) updateData.model_type = input.model_type;
  if (input.actuator_id !== undefined) updateData.actuator_id = input.actuator_id;
  if (input.custom_gcode !== undefined) updateData.custom_gcode = input.custom_gcode;
  if (input.cooldown_time !== undefined) updateData.cooldown_time = input.cooldown_time;
  if (input.enabled !== undefined) updateData.enabled = input.enabled;
  if (input.home_assistant_entity_id !== undefined)
    updateData.home_assistant_entity_id = input.home_assistant_entity_id;
  if (input.auto_shutdown_enabled !== undefined)
    updateData.auto_shutdown_enabled = input.auto_shutdown_enabled;
  if (input.shutdown_delay_minutes !== undefined)
    updateData.shutdown_delay_minutes = input.shutdown_delay_minutes;
  if (input.power_threshold_watts !== undefined)
    updateData.power_threshold_watts = input.power_threshold_watts;
  if (input.power_verification_seconds !== undefined)
    updateData.power_verification_seconds = input.power_verification_seconds;

  const [result, updateError] = await tryPromise(
    db.update(printers).set(updateData).where(eq(printers.id, id)).returning()
  );

  if (updateError) {
    logger.error('Failed to update printer', { printerId: id, error: updateError.message });
    return c.json({ error: 'Failed to update printer', status: 'error' }, 500);
  }

  if (result.length === 0) {
    return c.json({ error: 'Printer not found', status: 'error' }, 404);
  }

  return c.json(result[0]);
});

// DELETE /api/printers/:id - Delete printer
app.delete('/:id', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid printer ID', status: 'error' }, 400);
  }

  const db = getDB();
  const [result, deleteError] = await tryPromise(db.delete(printers).where(eq(printers.id, id)));

  if (deleteError) {
    logger.error('Failed to delete printer', { printerId: id, error: deleteError.message });
    return c.json({ error: 'Failed to delete printer', status: 'error' }, 500);
  }

  if (result.rowsAffected === 0) {
    return c.json({ error: 'Printer not found', status: 'error' }, 404);
  }

  return c.json({ success: true });
});

// POST /api/printers/test-connection - Test MQTT connection
const TestConnectionSchema = v.object({
  ip: v.string(),
  access_code: v.string(),
  serial: v.string()
});

app.post('/test-connection', async (c) => {
  const body = await c.req.json();
  const [parsed, parseError] = v.safeParse(TestConnectionSchema, body);

  if (!parsed.success) {
    return c.json({ error: 'Invalid input', issues: parseError.issues, status: 'error' }, 400);
  }

  const input = parsed.output;

  // Create temporary printer object for testing
  const testPrinter: Printer = {
    id: 0,
    name: 'Test',
    serial: input.serial,
    ip: input.ip,
    access_code: input.access_code,
    model_type: 'A1_MINI',
    actuator_id: null,
    custom_gcode: null,
    cooldown_time: 300,
    enabled: true,
    created_at: new Date(),
    updated_at: new Date()
  };

  const [success] = await tryPromise(mqttManager.connectPrinter(testPrinter));

  if (success) {
    mqttManager.disconnectPrinter(0);
    return c.json({ success: true, message: 'Connection successful' });
  } else {
    return c.json({ success: false, message: 'Connection failed' });
  }
});

// POST /api/printers/:id/command - Send command to printer
const CommandSchema = v.object({
  type: v.union([
    v.literal('pause'),
    v.literal('resume'),
    v.literal('stop'),
    v.literal('start'),
    v.literal('gcode')
  ]),
  gcode: v.optional(v.string()),
  fileName: v.optional(v.string())
});

app.post('/:id/command', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid printer ID', status: 'error' }, 400);
  }

  const body = await c.req.json();
  const [parsed, parseError] = v.safeParse(CommandSchema, body);

  if (!parsed.success) {
    return c.json({ error: 'Invalid input', issues: parseError.issues, status: 'error' }, 400);
  }

  const input = parsed.output;
  const [success] = await tryPromise(mqttManager.sendCommand(id, input));

  if (!success) {
    return c.json({ error: 'Failed to send command', status: 'error' }, 500);
  }

  return c.json({ success: true });
});

// GET /api/printers/:id/status - Get printer status
app.get('/:id/status', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid printer ID', status: 'error' }, 400);
  }

  const state = mqttManager.getPrinterStatus(id);

  if (!state) {
    return c.json({ error: 'Printer status not available', status: 'error' }, 404);
  }

  return c.json(state);
});

// POST /api/printers/:id/connect - Connect to printer
app.post('/:id/connect', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid printer ID', status: 'error' }, 400);
  }

  const db = getDB();
  const [result, error] = await tryPromise(
    db.select().from(printers).where(eq(printers.id, id)).limit(1)
  );

  if (error || result.length === 0) {
    return c.json({ error: 'Printer not found', status: 'error' }, 404);
  }

  const [success] = await tryPromise(mqttManager.connectPrinter(result[0]));

  if (!success) {
    return c.json({ error: 'Failed to connect to printer', status: 'error' }, 500);
  }

  return c.json({ success: true });
});

// POST /api/printers/:id/disconnect - Disconnect from printer
app.post('/:id/disconnect', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid printer ID', status: 'error' }, 400);
  }

  mqttManager.disconnectPrinter(id);
  return c.json({ success: true });
});

export default app;
