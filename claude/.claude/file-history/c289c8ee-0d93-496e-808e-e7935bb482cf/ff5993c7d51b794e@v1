/**
 * Prompt file operations
 * This module handles creating, reading, and moving prompt files
 */

import { promises as fs } from 'fs';
import { join, dirname, basename } from 'path';
import { getNextPromptNumber } from './numbers.js';

const AGENT_DIR = '.agent';
const PROMPTS_BASE_DIR = join(AGENT_DIR, 'prompts');

/**
 * Sanitize a string for use in a filename
 * @param str - The string to sanitize
 * @returns A filename-safe string
 */
export function sanitizeForFilename(str: string): string {
  return str
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .substring(0, 50); // Limit length
}

/**
 * Get the prompts directory for a specific branch
 * @param repoRoot - Repository root directory
 * @param branch - Git branch name
 * @returns Absolute path to the branch's prompts directory
 */
export function getPromptsDir(repoRoot: string, branch: string): string {
  return join(repoRoot, PROMPTS_BASE_DIR, branch);
}

/**
 * Get the completed directory for a specific branch
 * @param repoRoot - Repository root directory
 * @param branch - Git branch name
 * @returns Absolute path to the branch's completed directory
 */
export function getCompletedDir(repoRoot: string, branch: string): string {
  return join(repoRoot, PROMPTS_BASE_DIR, branch, 'completed');
}

/**
 * Ensure the prompts directory exists for a branch
 * @param repoRoot - Repository root directory
 * @param branch - Git branch name
 */
export async function ensurePromptsDir(repoRoot: string, branch: string): Promise<void> {
  const promptsDir = getPromptsDir(repoRoot, branch);
  await fs.mkdir(promptsDir, { recursive: true });
}

