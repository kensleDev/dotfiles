/**
 * Create a research prompt file
 * @param repoRoot - Repository root directory
 * @param branch - Git branch name
 * @param task - Research task description
 * @param priority - Optional priority level
 * @param context - Optional additional context
 * @returns Object with file path and prompt number
 */
export async function createResearchPrompt(
  repoRoot: string,
  branch: string,
  task: string,
  priority?: string,
  context?: string
): Promise<{ filePath: string; promptNumber: string }> {
  await ensurePromptsDir(repoRoot, branch);
  const promptsDir = getPromptsDir(repoRoot, branch);
  const promptNumber = await getNextPromptNumber(promptsDir);
  const sanitizedTopic = sanitizeForFilename(task);
  const filename = `${promptNumber}-research-${sanitizedTopic}.md`;
  const filePath = join(promptsDir, filename);

  const content = generateResearchPromptContent(task, priority, context);
  await fs.writeFile(filePath, content, 'utf-8');

  return { filePath, promptNumber };
}

/**
 * Create an implementation prompt file
 * @param repoRoot - Repository root directory
 * @param branch - Git branch name
 * @param task - Implementation task description
 * @param researchFindings - Optional research findings
 * @param requirements - Optional specific requirements
 * @returns Object with file path and prompt number
 */
export async function createImplementationPrompt(
  repoRoot: string,
  branch: string,
  task: string,
  researchFindings?: string,
  requirements?: string
): Promise<{ filePath: string; promptNumber: string }> {
  await ensurePromptsDir(repoRoot, branch);
  const promptsDir = getPromptsDir(repoRoot, branch);
  const promptNumber = await getNextPromptNumber(promptsDir);
  const sanitizedName = sanitizeForFilename(task);
  const filename = `${promptNumber}-${sanitizedName}.md`;
  const filePath = join(promptsDir, filename);

  const content = generateImplementationPromptContent(task, researchFindings, requirements);
  await fs.writeFile(filePath, content, 'utf-8');

  return { filePath, promptNumber };
}

/**
 * List all prompts in a branch directory
 * @param repoRoot - Repository root directory
 * @param branch - Git branch name
 * @returns Array of prompt metadata
 */
export async function listPrompts(
  repoRoot: string,
  branch: string
): Promise<
  Array<{
    number: string;
    title: string;
    type: string;
    status: string;
    filePath: string;
  }>
> {
  const promptsDir = getPromptsDir(repoRoot, branch);

  try {
    const entries = await fs.readdir(promptsDir, { withFileTypes: true });
    const prompts: Array<{
      number: string;
      title: string;
      type: string;
      status: string;
      filePath: string;
    }> = [];

    for (const entry of entries) {
      if (entry.isFile() && entry.name.endsWith('.md')) {
        const match = entry.name.match(/^(\d+)-(?:research-)?(.+?)\.md$/);
        if (match) {
          const [, number, title] = match;
          const type = entry.name.includes('-research-') ? 'research' : 'implementation';
          prompts.push({
            number: number ?? '',
            title: title ?? '',
            type,
            status: 'pending',
            filePath: join(promptsDir, entry.name),
          });
        }
      }
    }

    return prompts.sort((a, b) => parseInt(a.number) - parseInt(b.number));
  } catch {
    return [];
  }
}

/**
 * Get prompt content and metadata
 * @param promptFilePath - Absolute path to the prompt file
 * @returns Object with content and metadata
 */
export async function getPrompt(
  promptFilePath: string
): Promise<{ content: string; metadata: { number: string; title: string; type: string } }> {
  const content = await fs.readFile(promptFilePath, 'utf-8');
  const filename = basename(promptFilePath);
  const match = filename.match(/^(\d+)-(?:research-)?(.+?)\.md$/);

  if (!match) {
    throw new Error(`Invalid prompt filename format: ${filename}`);
  }

  const [, number, title] = match;
  const type = filename.includes('-research-') ? 'research' : 'implementation';

  return { content, metadata: { number: number ?? '', title: title ?? '', type } };
}

/**
 * Move a prompt to the completed folder
 * @param promptFilePath - Absolute path to the prompt file
 * @returns New file path
 */
export async function movePromptToCompleted(promptFilePath: string): Promise<string> {
  const filename = basename(promptFilePath);
  const dir = dirname(promptFilePath);
  const completedDir = join(dir, 'completed');

  // Ensure completed directory exists
  await fs.mkdir(completedDir, { recursive: true });

  // Move file
  const newFilePath = join(completedDir, filename);
  await fs.rename(promptFilePath, newFilePath);

  return newFilePath;
}

