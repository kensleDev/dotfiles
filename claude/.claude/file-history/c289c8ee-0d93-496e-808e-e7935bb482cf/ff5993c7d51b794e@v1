/**
 * Create a workflow orchestrator prompt file
 * @param repoRoot - Repository root directory
 * @param branch - Git branch name
 * @param task - Workflow task description
 * @param invocationMethod - How the orchestrator was invoked
 * @param autoMode - Whether auto mode is enabled
 * @returns Object with file path and prompt number
 */
export async function createWorkflowPrompt(
  repoRoot: string,
  branch: string,
  task: string,
  invocationMethod?: string,
  autoMode?: boolean
): Promise<{ filePath: string; promptNumber: string }> {
  await ensurePromptsDir(repoRoot, branch);
  const promptsDir = getPromptsDir(repoRoot, branch);
  const promptNumber = await getNextPromptNumber(promptsDir);
  const sanitizedTopic = sanitizeForFilename(task);
  const filename = `${promptNumber}-workflow-${sanitizedTopic}.md`;
  const filePath = join(promptsDir, filename);

  const content = generateWorkflowPromptContent(task, invocationMethod, autoMode);
  await fs.writeFile(filePath, content, 'utf-8');

  return { filePath, promptNumber };
}

/**
 * Validate that a file path is within the .agent directory
 * @param filePath - The file path to validate
 * @param repoRoot - Repository root directory
 * @throws Error if path is outside .agent directory
 */
export function validateAgentPath(filePath: string, repoRoot: string): void {
  const agentDir = join(repoRoot, AGENT_DIR);
  const resolvedPath = filePath.startsWith('/') ? filePath : join(repoRoot, filePath);
  const resolvedAgentDir = agentDir.startsWith('/') ? agentDir : join(repoRoot, agentDir);

  if (!resolvedPath.startsWith(resolvedAgentDir)) {
    throw new Error('File path must be within the .agent directory');
  }
}
