/**
 * Tool registration and routing
 * This module registers all MCP tools and routes incoming requests
 */

import type { Server } from '@modelcontextprotocol/sdk/server/index.js';
import {
  CallToolRequestSchema,
  ListToolsRequestSchema,
} from '@modelcontextprotocol/sdk/types.js';
import { handleCreateResearchTask } from './create-research-task.js';
import { handleCreateImplementationTask } from './create-implementation-task.js';
import { handleCreateWorkflow } from './create-workflow.js';
import { handleListPrompts } from './list-prompts.js';
import { handleGetPrompt } from './get-prompt.js';
import { handleMovePromptToCompleted } from './move-prompt-to-completed.js';
import {
  createResearchTaskJsonSchema,
  createImplementationTaskJsonSchema,
  createWorkflowJsonSchema,
  listPromptsJsonSchema,
  getPromptJsonSchema,
  movePromptToCompletedJsonSchema,
} from '../schemas/tools.js';

/**
 * Register all tools with the MCP server
 * @param server - The MCP server instance
 */
export function registerTools(server: Server): void {
  // Register tool call handler
  server.setRequestHandler(CallToolRequestSchema, async (request) => {
    const { name, arguments: args } = request.params;
    const repoRoot = process.cwd();

    switch (name) {
      case 'create_research_task':
        return handleCreateResearchTask(args, repoRoot);

      case 'create_implementation_task':
        return handleCreateImplementationTask(args, repoRoot);

      case 'create_workflow':
        return handleCreateWorkflow(args, repoRoot);

      case 'list_prompts':
        return handleListPrompts(args, repoRoot);

      case 'get_prompt':
        return handleGetPrompt(args, repoRoot);

      case 'move_prompt_to_completed':
        return handleMovePromptToCompleted(args, repoRoot);

      default:
        return {
          content: [
            {
              type: 'text',
              text: JSON.stringify({
                error: 'Unknown tool',
                tool: name,
              }),
            },
          ],
          isError: true,
        };
    }
  });

  // Register tool list handler
  server.setRequestHandler(ListToolsRequestSchema, async () => {
    return {
      tools: [
        {
          name: 'create_research_task',
          description: 'Create a research task prompt file. This generates a structured prompt for research tasks and returns instructions for spawning a researcher agent.',
          inputSchema: createResearchTaskJsonSchema,
        },
        {
          name: 'create_implementation_task',
          description: 'Create an implementation task prompt file. This generates a structured prompt for implementation tasks and returns instructions for spawning a developer agent.',
          inputSchema: createImplementationTaskJsonSchema,
        },
        {
          name: 'create_workflow',
          description: 'Create a workflow orchestrator prompt that guides users through the entire prompt creation process from initial request through research, implementation, and completion while maintaining 100% user agency.',
          inputSchema: createWorkflowJsonSchema,
        },
        {
          name: 'list_prompts',
          description: 'List all existing prompts in the current branch (or a specified branch). Returns metadata for each prompt including number, title, type, and status.',
          inputSchema: listPromptsJsonSchema,
        },
        {
          name: 'get_prompt',
          description: 'Retrieve the content and metadata of a specific prompt file. Returns the full prompt content with structured metadata.',
          inputSchema: getPromptJsonSchema,
        },
        {
          name: 'move_prompt_to_completed',
          description: 'Move a prompt file to the completed folder. Use this after an agent has successfully completed a task.',
          inputSchema: movePromptToCompletedJsonSchema,
        },
      ],
    };
  });
}
