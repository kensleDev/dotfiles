import { Hono } from 'hono';
import { tryPromise } from '@julian-i/try-error';
import { createLogger } from '../lib/shared/utils/logger';
import { sseManager } from '../lib/shared/services/sse-manager';
import { eventBus } from '../lib/shared/services/event-bus';
import { mqttManager } from '../lib/printer/services/mqtt-manager';
import type {
	PrinterState,
	PrinterError,
	FilamentState
} from '../lib/printer/types/printer';
import type { Job } from '../lib/job/types/job';

const logger = createLogger('routes:events');
const app = new Hono();

// GET /api/events - SSE stream for real-time updates
app.get('/', async (c) => {
	const clientId = Math.random().toString(36).substring(2);

	logger.info(`SSE client connected: ${clientId}`);

	// Create a readable stream for SSE
	const stream = new ReadableStream({
		start(controller) {
			const encoder = new TextEncoder();

			// Track closed state
			let closed = false;

			// Helper to send SSE messages (checks closed state)
			const sendEvent = (event: string, data: unknown) => {
				if (closed) return;
				try {
					const message = `event: ${event}\ndata: ${JSON.stringify(data)}\n\n`;
					controller.enqueue(encoder.encode(message));
				} catch (e) {
					// Controller closed, mark as closed and clean up
					closed = true;
					clearInterval(keepaliveInterval);
					sseManager.removeClient(clientId);
				}
			};

			// Add client to SSE manager with a wrapper that uses the controller
			sseManager.addClient(clientId, controller as unknown as ReadableStreamDefaultController);

			// Send initial connection message
			sendEvent('connected', { clientId, timestamp: Date.now() });

			// Send current state of all connected printers
			const connectedStates = mqttManager.getAllConnectedPrinters();
			for (const [printerId, state] of connectedStates) {
				sendEvent('printer:state', state);
			}

			// Keepalive interval
			const keepaliveInterval = setInterval(() => {
				sendEvent('keepalive', { timestamp: Date.now() });
			}, 15000); // 15 seconds

			// Cleanup function
			const close = () => {
				if (closed) return;
				closed = true;
				clearInterval(keepaliveInterval);
				sseManager.removeClient(clientId);
				try {
					controller.close();
				} catch {
					// Already closed
				}
			};

			// Set up cleanup on stream close/cancel
			return () => close();
		}
	});

	// Return SSE response with proper headers
	return new Response(stream, {
		headers: {
			'Content-Type': 'text/event-stream',
			'Cache-Control': 'no-cache',
			'Connection': 'keep-alive',
			'X-Accel-Buffering': 'no' // Disable nginx buffering
		}
	});
});

export default app;
