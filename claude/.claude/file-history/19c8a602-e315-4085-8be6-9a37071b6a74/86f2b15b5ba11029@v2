function ensureDirectories(): void {
  [THREE_MF_DIR, THUMBNAILS_DIR].forEach((dir) => {
    const [exists, checkError] = tryCatch(() => fs.existsSync(dir));
    if (checkError) {
      logger.warn('Failed to check directory existence', { dir, error: checkError.message });
      return;
    }
    if (!exists) {
      const [_, mkdirError] = tryCatch(() => fs.mkdirSync(dir, { recursive: true }));
      if (mkdirError) {
        logger.error('Failed to create directory', { dir, error: mkdirError.message });
      }
    }
  });
}

function validateFileType(filename: string): boolean {
  const lower = filename.toLowerCase();
  return lower.endsWith('.3mf') || lower.endsWith('.gcode.3mf');
}

function validate3MF(zipBuffer: Buffer): boolean {
  const [result] = tryCatch(() => {
    const zip = new AdmZip(zipBuffer);
    const entries = zip.getEntries();

    const hasContentTypes = entries.some(
      (e) => e.entryName === '[Content_Types].xml' || e.entryName.endsWith('/[Content_Types].xml')
    );

    const has3DModel = entries.some(
      (e) => e.entryName.includes('3D/') || e.entryName.endsWith('.model')
    );

    return hasContentTypes || has3DModel;
  });

  return result ?? false;
}

function extractThumbnail(zipBuffer: Buffer): Buffer | null {
  const [result, error] = tryCatch(() => {
    const zip = new AdmZip(zipBuffer);
    const entries = zip.getEntries();

    // Priority order for thumbnails (best quality/aspect ratio first)
    const thumbnailPriority = [
      // Plate preview - 512x512 square, best for UI display
      (e: string) => e.match(/metadata\/plate_\d+\.png$/) !== null,
      // Bambu Studio middle thumbnail - 680x510, good quality
      (e: string) => e.includes('auxiliaries/.thumbnails/thumbnail_middle'),
      // Bambu Studio 3MF thumbnail - 240x180, smaller but decent
      (e: string) => e.includes('auxiliaries/.thumbnails/thumbnail_3mf'),
      // Fallback thumbnails
      (e: string) => e.includes('auxiliaries/.thumbnails/'),
      (e: string) => e.includes('metadata/') && e.match(/plate_\d+/)
    ];

    for (const matcher of thumbnailPriority) {
      const entry = entries.find(
        (e) =>
          matcher(e.entryName.toLowerCase()) &&
          (e.entryName.toLowerCase().endsWith('.png') || e.entryName.toLowerCase().endsWith('.jpg'))
      );
      if (entry) {
        return entry.getData();
      }
    }

    // Last resort: any image in metadata
    const anyMetadataImage = entries.find(
      (e) =>
        e.entryName.toLowerCase().includes('metadata/') &&
        (e.entryName.toLowerCase().endsWith('.png') || e.entryName.toLowerCase().endsWith('.jpg'))
    );

    if (anyMetadataImage) {
      return anyMetadataImage.getData();
    }

    return null;
  });

  if (error) {
    logger.error('Error extracting thumbnail', {
      error: error.message,
      stack: error.stack
    });
    return null;
  }

  return result ?? null;
}

function generateThumbnailPath(): string {
  const uuid = crypto.randomUUID();
  return path.join(THUMBNAILS_DIR, `${uuid}.png`);
}

function saveThumbnail(thumbnailBuffer: Buffer): string {
  const thumbnailPath = generateThumbnailPath();
  const [_, error] = tryCatch(() => fs.writeFileSync(thumbnailPath, thumbnailBuffer));
  if (error) {
    logger.error('Failed to save thumbnail', {
      thumbnailPath,
      error: error.message,
      stack: error.stack
    });
    throw new Error('Failed to save thumbnail file');
  }
  return thumbnailPath;
}

function detectSlicer(content: string): { type: string; version?: string } {
  const normalizedContent = content.toLowerCase();

  if (normalizedContent.includes('bambu') || normalizedContent.includes('orcaslicer')) {
    const versionMatch = content.match(/version["\s:=]+([0-9.]+)/i);
    return {
      type: 'Bambu',
      version: versionMatch ? versionMatch[1] : undefined
    };
  }

  if (
    normalizedContent.includes('prusa') ||
    normalizedContent.includes('prusa3d') ||
    normalizedContent.includes('slic3r') ||
    normalizedContent.includes('prusaslicer')
  ) {
    const versionMatch = content.match(/version["\s:=]+([0-9.]+)/i);
    return {
      type: 'Prusa',
      version: versionMatch ? versionMatch[1] : undefined
    };
  }

  if (normalizedContent.includes('cura') || normalizedContent.includes('ultimaker')) {
    const versionMatch = content.match(/version["\s:=]+([0-9.]+)/i);
    return {
      type: 'Cura',
      version: versionMatch ? versionMatch[1] : undefined
    };
  }

  if (normalizedContent.includes('simplify3d')) {
    const versionMatch = content.match(/version["\s:=]+([0-9.]+)/i);
    return {
      type: 'Simplify3D',
      version: versionMatch ? versionMatch[1] : undefined
    };
  }

  return { type: 'Unknown' };
}

function isSliced(content: string): boolean {
  const normalizedContent = content.toLowerCase();

  const sliceIndicators = [
    /<slicestack/i,
    /<sliceref/i,
    /<slice\s+ztop/i,
    /layer_height/,
    /print_speed/,
    /infill/,
    /support\s*=/i,
    /slice_info/,
    /print_settings/,
    /3mf.*slice/i,
    /s:requiredextensions/i,
    /slic3r/i,
    /prusaslicer/i,
    /orcaslicer/i
  ];

  return sliceIndicators.some((indicator) => indicator.test(normalizedContent));
}

function extractPrintSettings(content: string, metadata: ThreeMFMetadata): void {
  const normalizedContent = content.toLowerCase();

  if (normalizedContent.includes('{') && normalizedContent.includes('}')) {
    const [jsonContent, parseError] = tryCatch(() => JSON.parse(content));
    if (!parseError && jsonContent) {
      extractFromJSON(jsonContent, metadata);
      return;
    }
    if (parseError) {
      logger.error('Failed to parse JSON, falling back to regex extraction', {
        error: parseError.message,
        stack: parseError.stack
      });
    }
  }

  const nozzleMatch =
    content.match(/nozzle_diameter["\s:=]+([0-9.]+)/i) ||
    content.match(/nozzle_diameters["\s:=]+([0-9.]+)/i);
  if (nozzleMatch) metadata.nozzle_diameter = parseFloat(nozzleMatch[1]);

  const printTempMatch =
    content.match(/print_temperature["\s:=]+([0-9.]+)/i) ||
    content.match(/print_temp["\s:=]+([0-9.]+)/i);
  if (printTempMatch) metadata.print_temp = parseFloat(printTempMatch[1]);

  const bedTempMatch =
    content.match(/bed_temperature["\s:=]+([0-9.]+)/i) ||
    content.match(/bed_temp["\s:=]+([0-9.]+)/i);
  if (bedTempMatch) metadata.bed_temp = parseFloat(bedTempMatch[1]);

  const layerHeightMatch = content.match(/layer_height["\s:=]+([0-9.]+)/i);
  if (layerHeightMatch) metadata.layer_height = parseFloat(layerHeightMatch[1]);

  const initialLayerHeightMatch = content.match(/initial_layer_height["\s:=]+([0-9.]+)/i);
  if (initialLayerHeightMatch)
    metadata.initial_layer_height = parseFloat(initialLayerHeightMatch[1]);

  const infillMatch =
    content.match(/infill_density["\s:=]+([0-9.]+)%?/i) ||
    content.match(/infill["\s:=]+([0-9.]+)%?/i);
  if (infillMatch) metadata.infill_percentage = parseFloat(infillMatch[1]);

  const supportsMatch =
    content.match(/support_enable["\s:=]+(true|false|1|0)/i) ||
    content.match(/supports["\s:=]+(true|false|1|0)/i);
  if (supportsMatch) {
    metadata.supports_enabled = supportsMatch[1] === 'true' || supportsMatch[1] === '1';
  }

  const printSpeedMatch =
    content.match(/outer_wall_speed["\s:=]+([0-9.]+)/i) ||
    content.match(/print_speed["\s:=]+([0-9.]+)/i);
  if (printSpeedMatch) metadata.print_speed = parseFloat(printSpeedMatch[1]);

  const adhesionMatch =
    content.match(/plate_type["\s:=]+(\w+)/i) ||
    content.match(/build_plate_adhesion["\s:=]+(\w+)/i);
  if (adhesionMatch) metadata.build_plate_adhesion = adhesionMatch[1];

  const brimWidthMatch = content.match(/brim_width["\s:=]+([0-9.]+)/i);
  if (brimWidthMatch) metadata.brim_width = parseFloat(brimWidthMatch[1]);

  const raftLayersMatch = content.match(/raft_layers["\s:=]+([0-9]+)/i);
  if (raftLayersMatch) metadata.raft_layers = parseInt(raftLayersMatch[1], 10);

  const skirtLoopsMatch = content.match(/skirt_loops["\s:=]+([0-9]+)/i);
  if (skirtLoopsMatch) metadata.skirt_loops = parseInt(skirtLoopsMatch[1], 10);

  const topLayersMatch =
    content.match(/top_shell_layers["\s:=]+([0-9]+)/i) ||
    content.match(/top_layers["\s:=]+([0-9]+)/i);
  if (topLayersMatch) metadata.top_layers = parseInt(topLayersMatch[1], 10);

  const bottomLayersMatch =
    content.match(/bottom_shell_layers["\s:=]+([0-9]+)/i) ||
    content.match(/bottom_layers["\s:=]+([0-9]+)/i);
  if (bottomLayersMatch) metadata.bottom_layers = parseInt(bottomLayersMatch[1], 10);

  const retractionEnabledMatch = content.match(/retraction_enable["\s:=]+(true|false|1|0)/i);
  if (retractionEnabledMatch) {
    metadata.retraction_enabled =
      retractionEnabledMatch[1] === 'true' || retractionEnabledMatch[1] === '1';
  }

  const retractionDistMatch =
    content.match(/retraction_length["\s:=]+([0-9.]+)/i) ||
    content.match(/retraction_distance["\s:=]+([0-9.]+)/i);
  if (retractionDistMatch) metadata.retraction_distance = parseFloat(retractionDistMatch[1]);

  const retractionSpeedMatch = content.match(/retraction_speed["\s:=]+([0-9.]+)/i);
  if (retractionSpeedMatch) metadata.retraction_speed = parseFloat(retractionSpeedMatch[1]);

  const fanSpeedMatch =
    content.match(/part_cooling_fan_speed["\s:=]+([0-9.]+)/i) ||
    content.match(/fan_speed["\s:=]+([0-9.]+)/i);
  if (fanSpeedMatch) metadata.fan_speed = parseFloat(fanSpeedMatch[1]);

  const outerWallSpeedMatch =
    content.match(/outer_wall_speed["\s:=]+([0-9.]+)/i) ||
    content.match(/outer_perimeter_speed["\s:=]+([0-9.]+)/i);
  if (outerWallSpeedMatch) metadata.outer_wall_speed = parseFloat(outerWallSpeedMatch[1]);

  const innerWallSpeedMatch =
    content.match(/inner_wall_speed["\s:=]+([0-9.]+)/i) ||
    content.match(/inner_perimeter_speed["\s:=]+([0-9.]+)/i);
  if (innerWallSpeedMatch) metadata.inner_wall_speed = parseFloat(innerWallSpeedMatch[1]);

  const topSurfaceSpeedMatch =
    content.match(/top_surface_speed["\s:=]+([0-9.]+)/i) ||
    content.match(/solid_infill_speed["\s:=]+([0-9.]+)/i);
  if (topSurfaceSpeedMatch) metadata.top_surface_speed = parseFloat(topSurfaceSpeedMatch[1]);

  const bottomSurfaceSpeedMatch = content.match(/bottom_surface_speed["\s:=]+([0-9.]+)/i);
  if (bottomSurfaceSpeedMatch)
    metadata.bottom_surface_speed = parseFloat(bottomSurfaceSpeedMatch[1]);

  const travelSpeedMatch = content.match(/travel_speed["\s:=]+([0-9.]+)/i);
  if (travelSpeedMatch) metadata.travel_speed = parseFloat(travelSpeedMatch[1]);

  const initialLayerSpeedMatch = content.match(/initial_layer_speed["\s:=]+([0-9.]+)/i);
  if (initialLayerSpeedMatch) metadata.initial_layer_speed = parseFloat(initialLayerSpeedMatch[1]);

  const timeMatch =
    content.match(/estimated_print_time["\s:=]+(\d+)/i) ||
    content.match(/print_time["\s:=]+(\d+)/i) ||
    content.match(/<print_time>(\d+)<\/print_time>/i);
  if (timeMatch) metadata.print_time_estimate = parseInt(timeMatch[1], 10);

  const materialTypeMatch =
    content.match(/material_type["\s:=]+([^\s"]+)/i) ||
    content.match(/filament_type["\s:=]+([^\s"]+)/i);
  if (materialTypeMatch) metadata.material_type = materialTypeMatch[1];

  const materialColorMatch =
    content.match(/material_color["\s:=]+([#\w]+)/i) ||
    content.match(/filament_colour["\s:=]+([#\w]+)/i);
  if (materialColorMatch) metadata.material_color = materialColorMatch[1];
}

type SlicerSettings = Record<string, string | number | boolean | string[] | number[]>;

function extractFromJSON(settings: SlicerSettings, metadata: ThreeMFMetadata): void {
  if (!settings) return;

  const getValue = (key: string): SlicerSettings[keyof SlicerSettings] | undefined => {
    if (Array.isArray(settings[key])) {
      return settings[key][0];
    }
    return settings[key];
  };

  const parseNumber = (key: string, fallback?: number): number | undefined => {
    const val = getValue(key);
    if (val === undefined || val === null) return fallback;
    const num = parseFloat(String(val));
    return isNaN(num) ? fallback : num;
  };

  const parseIntNumber = (key: string, fallback?: number): number | undefined => {
    const val = getValue(key);
    if (val === undefined || val === null) return fallback;
    const num = parseInt(String(val), 10);
    return isNaN(num) ? fallback : num;
  };

  const parseBoolean = (key: string): boolean | undefined => {
    const val = getValue(key);
    if (val === undefined || val === null) return undefined;
    if (typeof val === 'boolean') return val;
    if (val === '1' || val === 'true' || val === 1) return true;
    if (val === '0' || val === 'false' || val === 0) return false;
    return undefined;
  };

  const nozzleDiameter = parseNumber('nozzle_diameter') || parseNumber('nozzle_diameters');
  if (nozzleDiameter) metadata.nozzle_diameter = nozzleDiameter;

  metadata.layer_height = parseNumber('layer_height');
  metadata.initial_layer_height = parseNumber('initial_layer_height');
  metadata.print_temp = parseNumber('print_temperature') || parseNumber('print_temp');
  metadata.bed_temp = parseNumber('bed_temperature') || parseNumber('bed_temp');

  const infillDensity = parseNumber('infill_density');
  if (infillDensity) metadata.infill_percentage = infillDensity;

  metadata.supports_enabled = parseBoolean('support_enable') || parseBoolean('support_generate');
  metadata.print_speed = parseNumber('print_speed') || parseNumber('outer_wall_speed');

  const plateType = getValue('plate_type');
  if (plateType) metadata.build_plate_adhesion = String(plateType);

  metadata.brim_width = parseNumber('brim_width');
  metadata.raft_layers = parseIntNumber('raft_layers');
  metadata.skirt_loops = parseIntNumber('skirt_loops');

  const topLayers = parseIntNumber('top_shell_layers') || parseIntNumber('top_layers');
  if (topLayers) metadata.top_layers = topLayers;

  const bottomLayers = parseIntNumber('bottom_shell_layers') || parseIntNumber('bottom_layers');
  if (bottomLayers) metadata.bottom_layers = bottomLayers;

  metadata.retraction_enabled = parseBoolean('retraction_enable');
  metadata.retraction_distance =
    parseNumber('retraction_length') || parseNumber('retraction_distance');
  metadata.retraction_speed = parseNumber('retraction_speed');

  const fanSpeed = parseNumber('part_cooling_fan_speed') || parseNumber('fan_speed');
  if (fanSpeed) metadata.fan_speed = fanSpeed;

  metadata.fan_min_speed = parseNumber('fan_min_speed');
  metadata.fan_max_speed = parseNumber('fan_max_speed');

  const outerWallSpeed = parseNumber('outer_wall_speed') || parseNumber('outer_perimeter_speed');
  if (outerWallSpeed) metadata.outer_wall_speed = outerWallSpeed;

  const innerWallSpeed = parseNumber('inner_wall_speed') || parseNumber('inner_perimeter_speed');
  if (innerWallSpeed) metadata.inner_wall_speed = innerWallSpeed;

  metadata.top_surface_speed =
    parseNumber('top_surface_speed') || parseNumber('solid_infill_speed');
  metadata.bottom_surface_speed = parseNumber('bottom_surface_speed');
  metadata.travel_speed = parseNumber('travel_speed');

  const sparseInfillSpeed = parseNumber('sparse_infill_speed');
  if (sparseInfillSpeed) metadata.sparse_infill_speed = sparseInfillSpeed;

  const supportSpeed = parseNumber('support_speed');
  if (supportSpeed) metadata.support_speed = supportSpeed;

  const bridgeSpeed = parseNumber('bridge_speed');
  if (bridgeSpeed) metadata.bridge_speed = bridgeSpeed;

  const topSurfacePattern = getValue('top_surface_pattern');
  if (topSurfacePattern) metadata.top_surface_pattern = String(topSurfacePattern);

  const bottomSurfacePattern = getValue('bottom_surface_pattern');
  if (bottomSurfacePattern) metadata.bottom_surface_pattern = String(bottomSurfacePattern);

  const sparseInfillPattern = getValue('sparse_infill_pattern');
  if (sparseInfillPattern) metadata.infill_pattern = String(sparseInfillPattern);

  const supportType = getValue('support_type');
  if (supportType) metadata.support_type = String(supportType);

  const supportThresholdAngle = parseNumber('support_threshold_angle');
  if (supportThresholdAngle) metadata.support_threshold_angle = supportThresholdAngle;

  const skirtDistance = parseNumber('skirt_distance');
  if (skirtDistance) metadata.skirt_distance = skirtDistance;

  const wipeDistance = parseNumber('wipe_distance');
  if (wipeDistance) metadata.wipe_distance = wipeDistance;

  const wallLoops = parseIntNumber('wall_loops');
  if (wallLoops) metadata.wall_loops = wallLoops;

  const wallSequence = getValue('wall_sequence');
  if (wallSequence) metadata.wall_sequence = String(wallSequence);

  const seamPosition = getValue('seam_position');
  if (seamPosition) metadata.seam_position = String(seamPosition);

  metadata.z_hop = parseNumber('z_hop');

  const pressureAdvance = parseNumber('pressure_advance');
  if (pressureAdvance) metadata.pressure_advance = pressureAdvance;

  metadata.initial_layer_speed = parseNumber('initial_layer_speed');
}

function parseXMLMetadata(zipBuffer: Buffer): ThreeMFMetadata {
  const metadata: ThreeMFMetadata = {};

  const [_, error] = tryCatch(() => {
    const zip = new AdmZip(zipBuffer);
    const entries = zip.getEntries();

    const modelEntry = entries.find(
      (e) => e.entryName.includes('3D/') && e.entryName.endsWith('.model')
    );

    let combinedContent = '';

    if (modelEntry) {
      const content = modelEntry.getData().toString('utf-8');
      combinedContent += content;

      const appMatch = content.match(/<application[^>]*>([^<]+)<\/application>/i);
      if (appMatch) {
        metadata.application = appMatch[1];
      }

      const versionMatch = content.match(/<application[^>]*version="([^"]+)"/i);
      if (versionMatch) {
        metadata.application_version = versionMatch[1];
      }

      const authorMatch = content.match(/<author[^>]*>([^<]+)<\/author>/i);
      if (authorMatch) {
        metadata.author = authorMatch[1];
      }

      const titleMatch = content.match(/<title[^>]*>([^<]+)<\/title>/i);
      if (titleMatch) {
        metadata.title = titleMatch[1];
      }

      const descriptionMatch = content.match(/<description[^>]*>([^<]+)<\/description>/i);
      if (descriptionMatch) {
        metadata.description = descriptionMatch[1];
      }

      const widthMatch = content.match(/<model[^>]*width="([^"]+)"/i);
      if (widthMatch) {
        metadata.width = parseFloat(widthMatch[1]);
      }

      const heightMatch = content.match(/<model[^>]*height="([^"]+)"/i);
      if (heightMatch) {
        metadata.height = parseFloat(heightMatch[1]);
      }

      const depthMatch = content.match(/<model[^>]*depth="([^"]+)"/i);
      if (depthMatch) {
        metadata.depth = parseFloat(depthMatch[1]);
      }

      const slicerInfo = detectSlicer(content);
      if (slicerInfo.type !== 'Unknown') {
        metadata.application = slicerInfo.type;
        if (slicerInfo.version) {
          metadata.application_version = slicerInfo.version;
        }
      }
    }

    const configEntries = entries.filter(
      (e) =>
        e.entryName.toLowerCase().includes('slice_info') ||
        e.entryName.toLowerCase().includes('project_settings') ||
        e.entryName.toLowerCase().includes('print_settings') ||
        e.entryName.toLowerCase() === 'metadata/slic3r_pe_model.config' ||
        e.entryName.toLowerCase().endsWith('.config') ||
        e.entryName.toLowerCase().endsWith('.ini')
    );

    for (const configEntry of configEntries) {
      const configContent = configEntry.getData().toString('utf-8');
      combinedContent += '\n' + configContent;

      extractPrintSettings(configContent, metadata);

      if (!metadata.application) {
        const slicerInfo = detectSlicer(configContent);
        if (slicerInfo.type !== 'Unknown') {
          metadata.application = slicerInfo.type;
          if (slicerInfo.version) {
            metadata.application_version = slicerInfo.version;
          }
        }
      }
    }

    if (modelEntry) {
      const content = modelEntry.getData().toString('utf-8');
      extractPrintSettings(content, metadata);
    }
  });

  if (error) {
    logger.error('Error parsing 3MF metadata', {
      error: error.message,
      stack: error.stack
    });
  }

  return metadata;
}

function generateFilePath(): string {
  const uuid = crypto.randomUUID();
  const timestamp = Date.now();
  return path.join(THREE_MF_DIR, `${uuid}_${timestamp}.3mf`);
}

