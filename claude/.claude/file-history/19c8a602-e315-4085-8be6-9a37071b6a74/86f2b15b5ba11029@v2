export async function upload3MF(file: File): Promise<ThreeMFUploadResult | ThreeMFValidationError> {
  if (!validateFileType(file.name)) {
    return {
      error: 'Invalid file type. Only .3mf files are accepted.',
      code: 'INVALID_TYPE'
    };
  }

  if (file.size > MAX_FILE_SIZE) {
    return {
      error: `File too large. Maximum size is ${MAX_FILE_SIZE / 1024 / 1024}MB.`,
      code: 'TOO_LARGE'
    };
  }

  // Ensure directories exist
  const [, dirError] = tryCatch(() => ensureDirectories());
  if (dirError) {
    logger.error('Failed to create upload directories', {
      error: dirError.message,
      stack: dirError.stack
    });
    return {
      error: 'Failed to initialize upload directories.',
      code: 'IO_ERROR'
    };
  }

  // Read file content
  const [arrayBuffer, readError] = await tryPromise(file.arrayBuffer());
  if (readError) {
    logger.error('Error reading uploaded file', {
      error: readError.message,
      stack: readError.stack,
      fileName: file.name
    });
    return {
      error: 'Failed to read uploaded file.',
      code: 'IO_ERROR'
    };
  }

  let buffer = Buffer.from(arrayBuffer);

  if (!validate3MF(buffer)) {
    return {
      error: 'Invalid 3MF file structure.',
      code: 'INVALID_3MF'
    };
  }

  // Extract G-code and remove purge line for automated printing
  const extractedGcode = extractGcodeFrom3mf(buffer);

  // Remove purge line if present
  if (extractedGcode) {
    const processedGcode = removePurgeLine(extractedGcode);
    // Only recreate the 3MF if the G-code was actually modified
    if (processedGcode !== extractedGcode) {
      const processedBuffer = create3mfFromGcode(processedGcode, buffer);
      buffer = Buffer.from(processedBuffer);
      logger.info('Removed purge line from 3MF file', { filename: file.name });
    }
  }

  const metadata = parseXMLMetadata(buffer);

  // Detect printer type from GCode (after metadata is initialized)
  if (extractedGcode) {
    const detectedPrinterType = detectPrinterTypeFromGcode(extractedGcode);

    // Store detected type in metadata
    if (detectedPrinterType) {
      metadata.printer_type = detectedPrinterType;
      logger.info('Detected printer type from GCode', {
        filename: file.name,
        printer_type: detectedPrinterType
      });
    }
  }

  const thumbnailBuffer = extractThumbnail(buffer);
  let thumbnailPath: string | null = null;
  let thumbnailData: string | null = null;

  if (thumbnailBuffer) {
    thumbnailPath = saveThumbnail(thumbnailBuffer);
    thumbnailData = `data:image/png;base64,${thumbnailBuffer.toString('base64')}`;
  }

  const filePath = generateFilePath();
  const [, writeError] = tryCatch(() => fs.writeFileSync(filePath, buffer));
  if (writeError) {
    logger.error('Error saving 3MF file', {
      error: writeError.message,
      stack: writeError.stack,
      filePath
    });
    return {
      error: 'Failed to save file.',
      code: 'IO_ERROR'
    };
  }

  const [id, dbError] = await tryPromise(
    saveToDatabase(file.name, filePath, thumbnailPath, file.size, metadata, thumbnailData)
  );

  if (dbError) {
    logger.error('Error saving to database', {
      error: dbError.message,
      stack: dbError.stack,
      fileName: file.name
    });
    return {
      error: 'Failed to save file record.',
      code: 'DB_ERROR'
    };
  }

  return {
    id: id!,
    fileName: file.name,
    filePath,
    thumbnailPath: thumbnailPath ?? undefined,
    fileSize: file.size,
    metadata
  };
}

export function parse3MF(filePath: string): ThreeMFMetadata {
  const [buffer, readError] = tryCatch(() => fs.readFileSync(filePath));
  if (readError) {
    logger.error('Error parsing 3MF file', {
      error: readError.message,
      stack: readError.stack,
      filePath
    });
    return {};
  }
  return parseXMLMetadata(buffer);
}

export async function generateThumbnail(
  filePath: string,
  outputPath?: string
): Promise<string | null> {
  const [buffer, readError] = tryCatch(() => fs.readFileSync(filePath));
  if (readError) {
    logger.error('Error reading file for thumbnail generation', {
      error: readError.message,
      stack: readError.stack,
      filePath
    });
    return null;
  }

  const thumbnailBuffer = extractThumbnail(buffer);

  if (!thumbnailBuffer) {
    return null;
  }

  const targetPath = outputPath || generateThumbnailPath();
  const [_, writeError] = tryCatch(() => fs.writeFileSync(targetPath, thumbnailBuffer));
  if (writeError) {
    logger.error('Error writing thumbnail file', {
      error: writeError.message,
      stack: writeError.stack,
      targetPath
    });
    return null;
  }

  return targetPath;
}

export async function delete3MF(id: number): Promise<void> {
  const [files, fetchError] = await tryPromise(
    getDB().select().from(modelFiles).where(eq(modelFiles.id, id)).limit(1)
  );

  if (fetchError) {
    logger.error('Failed to fetch 3MF file for deletion', {
      fileId: id,
      error: fetchError.message,
      stack: fetchError.stack
    });
    throw new Error('Failed to fetch file for deletion');
  }

  if (files.length === 0) {
    throw new Error('File not found');
  }

  const file = files[0];

  // Delete files from disk - best effort
  if (file.file_path) {
    const filePath = file.file_path;
    const [exists, statError] = tryCatch(() => fs.existsSync(filePath));
    if (!statError && exists) {
      const [, unlinkError] = tryCatch(() => fs.unlinkSync(filePath));
      if (unlinkError) {
        logger.warn('Failed to delete 3MF file from disk', {
          filePath,
          error: unlinkError.message
        });
      }
    }
  }

  if (file.thumbnail_path) {
    const thumbnailPath = file.thumbnail_path;
    const [exists, statError] = tryCatch(() => fs.existsSync(thumbnailPath));
    if (!statError && exists) {
      const [, unlinkError] = tryCatch(() => fs.unlinkSync(thumbnailPath));
      if (unlinkError) {
        logger.warn('Failed to delete thumbnail from disk', {
          thumbnailPath,
          error: unlinkError.message
        });
      }
    }
  }

  const [, deleteError] = await tryPromise(getDB().delete(modelFiles).where(eq(modelFiles.id, id)));
  if (deleteError) {
    logger.error('Failed to delete 3MF from database', {
      fileId: id,
      error: deleteError.message,
      stack: deleteError.stack
    });
    throw new Error('Failed to delete file from database');
  }
}

export async function getAllFiles(): Promise<(typeof modelFiles.$inferSelect)[]> {
  const [result, error] = await tryPromise(
    getDB().select().from(modelFiles).orderBy(desc(modelFiles.created_at))
  );
  if (error) {
    logger.error('Error fetching all 3MF files', {
      error: error.message,
      stack: error.stack
    });
    return [];
  }
  return result;
}

export async function getFileById(id: number): Promise<typeof modelFiles.$inferSelect | null> {
  const [result, error] = await tryPromise(
    getDB().select().from(modelFiles).where(eq(modelFiles.id, id)).limit(1)
  );

  if (error) {
    logger.error('Error fetching 3MF file', {
      fileId: id,
      error: error.message,
      stack: error.stack
    });
    return null;
  }

  return result.length > 0 ? result[0] : null;
}

export async function updateFileMetadata(
  id: number,
  metadata: Partial<ThreeMFMetadata>
): Promise<void> {
  const updateData: Partial<NewModelFile> = {};

  if (metadata.title !== undefined) updateData.title = metadata.title;
  if (metadata.description !== undefined) updateData.description = metadata.description;
  if (metadata.material_type !== undefined) updateData.material_type = metadata.material_type;
  if (metadata.material_color !== undefined) updateData.material_color = metadata.material_color;
  if (metadata.author !== undefined) updateData.author = metadata.author;

  const [_, error] = await tryPromise(
    getDB().update(modelFiles).set(updateData).where(eq(modelFiles.id, id))
  );

  if (error) {
    logger.error('Error updating file metadata', {
      fileId: id,
      error: error.message,
      stack: error.stack
    });
    throw new Error('Failed to update file metadata');
  }
}

export function isValidationError(
  result: ThreeMFUploadResult | ThreeMFValidationError
): result is ThreeMFValidationError {
  return 'error' in result;
}
