// GET /api/model-files/:id - Get single model file
app.get('/:id', async (c) => {
  const id = parseInt(c.req.param('id'));
  if (isNaN(id)) {
    return c.json({ error: 'Invalid model file ID', status: 'error' }, 400);
  }

  const [result, error] = await tryPromise(modelManager.getModelFile(id));

  if (error) {
    logger.error('Failed to get model file', { modelFileId: id, error: error.message });
    return c.json({ error: 'Failed to get model file', status: 'error' }, 500);
  }

  if (!result) {
    return c.json({ error: 'Model file not found', status: 'error' }, 404);
  }

  return c.json(result);
});

