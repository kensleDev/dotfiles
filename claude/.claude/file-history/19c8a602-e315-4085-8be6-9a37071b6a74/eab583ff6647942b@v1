const logger = createLogger('routes:model-files');
const app = new Hono();

// GET /api/model-files - List model files
app.get('/', async (c) => {
  const db = getDB();
  const [result, error] = await tryPromise(
    db.select().from(modelFiles).orderBy(desc(modelFiles.created_at))
  );

  if (error) {
    logger.error('Failed to get model files', { error: error.message });
    return c.json({ error: 'Failed to get model files', status: 'error' }, 500);
  }

  return c.json(result);
});

