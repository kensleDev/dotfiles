<script lang="ts">
	import { onMount } from 'svelte';
	import { IconPlus } from '@tabler/icons-svelte';
	import { QueueList, BulkActions } from '@/queue';
	import CurrentJobDisplay from '@/queue/components/CurrentJobDisplay.svelte';
	import JobModal from '@/job/components/JobModal.svelte';
	import JobDetail from '@/job/components/JobDetail.svelte';
	import { jobsStore } from '@/job';
	import { printersStore } from '@/printer';
	import type { JobWithPrinter } from '@/job';
	import type { PrinterWithStatus } from '@/printer/stores/printers.svelte';
	import { jobs, printers, queue } from '@/api';
	import { createSseClient } from '@/api';
	import { createLogger } from '@/shared/utils/logger';

	const logger = createLogger('queue-page');
	let jobsList = $derived(jobsStore.jobs);
	let printersList = $derived(printersStore.printers);

	// Derive the currently printing job (from queue)
	let currentPrintingJob = $derived(
		jobs.find(
			(j) =>
				j.status === 'printing' ||
				j.status === 'uploading' ||
				j.status === 'cooling' ||
				j.status === 'clearing'
		) || null
	);

	// Find any printer that's actively printing (even without a job in queue)
	// Check multiple indicators: status, currentFile, layerCount, or significant progress
	function isActivePrint(printer: PrinterWithStatus): boolean {
		const state = printer.status;
		if (!state) return false;

		// Check if printer status indicates printing
		if (state.status === 'PRINTING' || state.status === 'PAUSED' || state.status === 'PREPARE') {
			return true;
		}

		// Check if printer has an active file with progress
		if (state.currentFile && (state.layerCount > 0 || state.progress > 0)) {
			return true;
		}

		return false;
	}

	// Get the active printing printer (either from job or detected from printer state)
	let activePrintingPrinter = $derived.by(() => {
		// First, try to get printer from current job
		if (currentPrintingJob?.assigned_printer) {
			return printersStore.getPrinter(currentPrintingJob.assigned_printer) || null;
		}

		// Otherwise, find any printer that's actively printing
		return printers.find(isActivePrint) || null;
	});

	let currentPrinterState = $derived(activePrintingPrinter?.status ?? null);
	let currentPrinterName = $derived(activePrintingPrinter?.name ?? null);

	let showAddModal = $state(false);
	let showDetailModal = $state(false);
	let selectedJobId = $state<number | null>(null);
	let statusFilter = $state<
		'all' | 'pending' | 'running' | 'paused' | 'completed' | 'failed' | 'cancelled'
	>('all');
	let printerFilter = $state<string>('all');
	let error = $state('');

	let selectedJob = $derived(jobs.find((j) => j.id === selectedJobId) || null);

	let filteredJobs = $derived.by(() => {
		let result = jobs;

		if (statusFilter !== 'all') {
			result = result.filter((j) => j.status === statusFilter);
		}

		if (printerFilter !== 'all') {
			const printerId = parseInt(printerFilter, 10);
			result = result.filter((j) => j.assigned_printer === printerId);
		}

		return result;
	});

	// TanStack Query
	const jobsQuery = jobs.useJobs();
	const printersQuery = printers.usePrinters(true);

	// Mutations
	const cancelMutation = jobs.useCancelJob();
	const updateMutation = jobs.useUpdateJob();
	const deleteMutation = jobs.useDeleteJob();
	const reorderMutation = queue.useReorderJobs();
	const clearCompletedMutation = queue.useClearCompleted();
	const clearFailedMutation = queue.useClearFailed();
	const cancelAllPendingMutation = queue.useCancelAllPending();

	onMount(async () => {
		await Promise.all([loadJobs(), loadPrinters()]);
		setupEventSource();
	});

	async function loadJobs() {
		try {
			const data = await jobsQuery.refetch();
			jobsStore.set(data.data || []);
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to load jobs';
		}
	}

	async function loadPrinters() {
		try {
			const data = await printersQuery.refetch();
			printersStore.set(data.data || []);
		} catch (err) {
			// Silently fail - printers may already be loaded from dashboard
			logger.error('Failed to load printers', {
				error: err instanceof Error ? err.message : 'Unknown error'
			});
		}
	}

	function setupEventSource() {
		const sseClient = createSseClient();

		// Job events
		sseClient.on('job:created', (job) => {
			jobsStore.addJob(job);
		});

		sseClient.on('job:updated', (job) => {
			jobsStore.updateJob(job);
		});

		sseClient.on('job:deleted', ({ jobId }) => {
			jobsStore.removeJob(jobId);
		});

		sseClient.on('job:reordered', ({ jobIds }) => {
			jobsStore.reorderJobs(jobIds);
		});

		// Printer events - needed for real-time current job display
		sseClient.on('printer:state', (data) => {
			printersStore.updatePrinterStatus(data.printerId, data);
		});

		sseClient.on('printer:connected', (data) => {
			printersStore.setConnected(data.printerId, true);
			printersStore.setConnecting(data.printerId, false);
		});

		sseClient.on('printer:disconnected', (data) => {
			printersStore.setConnected(data.printerId, false);
		});

		return () => {
			sseClient.disconnect();
		};
	}

	async function handleJobCreated() {
		await loadJobs();
		showAddModal = false;
	}

	function handleJobClick(jobId: number) {
		selectedJobId = jobId;
		showDetailModal = true;
	}

	async function handleReorder(jobIds: number[]) {
		try {
			await reorderMutation.mutateAsync({ jobIds });
			jobsStore.reorderJobs(jobIds);
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to reorder jobs';
		}
	}

	async function handleCancelJob(job: JobWithPrinter) {
		try {
			await cancelMutation.mutateAsync(job.id);
			await loadJobs();
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to cancel job';
		}
	}

	async function handleRetryJob(job: JobWithPrinter) {
		try {
			await updateMutation.mutateAsync({ id: job.id, status: 'pending', error_message: null });
			await loadJobs();
			showDetailModal = false;
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to retry job';
		}
	}

	async function handleDeleteJob(job: JobWithPrinter) {
		try {
			await deleteMutation.mutateAsync(job.id);
			await loadJobs();
			showDetailModal = false;
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to delete job';
		}
	}

	async function handleCancelPending() {
		try {
			await cancelAllPendingMutation.mutateAsync();
			await loadJobs();
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to cancel jobs';
		}
	}

	async function handleClearCompleted() {
		try {
			await clearCompletedMutation.mutateAsync();
			await loadJobs();
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to clear jobs';
		}
	}

	async function handleClearFailed() {
		try {
			await clearFailedMutation.mutateAsync();
			await loadJobs();
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to clear jobs';
		}
	}
</script>

<svelte:head>
	<title>Queue - BambuFarm</title>
</svelte:head>

<div class="space-y-6">
	<div class="flex items-center justify-between">
		<div>
			<h1 class="text-3xl font-bold text-foreground">Queue</h1>
			<p class="mt-2 text-muted-foreground">Manage print jobs and configure loop settings.</p>
		</div>
		<button
			type="button"
			onclick={() => (showAddModal = true)}
			class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90"
		>
			<IconPlus class="mr-2 h-5 w-5" />
			Add Job
		</button>
	</div>

	{#if error}
		<div class="rounded-md border border-destructive bg-destructive/10 p-4">
			<p class="text-sm text-destructive">{error}</p>
		</div>
	{/if}

	<div class="rounded-lg border border-border bg-card p-4">
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			<div>
				<label for="status-filter" class="block text-sm font-medium text-muted-foreground"
					>Status</label
				>
				<select
					id="status-filter"
					bind:value={statusFilter}
					class="mt-1 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-primary focus:ring-primary focus:ring-offset-background"
				>
					<option value="all">All Jobs</option>
					<option value="pending">Pending</option>
					<option value="running">Running</option>
					<option value="paused">Paused</option>
					<option value="completed">Completed</option>
					<option value="failed">Failed</option>
					<option value="cancelled">Cancelled</option>
				</select>
			</div>

			<div>
				<label for="printer-filter" class="block text-sm font-medium text-muted-foreground"
					>Printer</label
				>
				<select
					id="printer-filter"
					bind:value={printerFilter}
					class="mt-1 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-primary focus:ring-primary focus:ring-offset-background"
				>
					<option value="all">All Printers</option>
					{#each printers as printer (printer.id)}
						<option value={printer.id}>{printer.name}</option>
					{/each}
				</select>
			</div>

			<div class="flex items-end">
				<div class="text-sm text-muted-foreground">
					Showing <span class="font-medium text-foreground">{filteredJobs.length}</span> of
					<span class="font-medium text-foreground">{jobs.length}</span> jobs
				</div>
			</div>
		</div>
	</div>

	<CurrentJobDisplay
		currentJob={currentPrintingJob}
		printerState={currentPrinterState}
		printerName={currentPrinterName}
	/>

	<BulkActions
		oncancel={handleCancelPending}
		onclearcompleted={handleClearCompleted}
		onclearfailed={handleClearFailed}
	/>

	<QueueList jobs={filteredJobs} onselectjob={handleJobClick} onreorder={handleReorder} />
</div>

{#if showAddModal}
	<JobModal bind:open={showAddModal} {printers} onsuccess={handleJobCreated} />
{/if}

{#if showDetailModal && selectedJob}
	<JobDetail
		bind:open={showDetailModal}
		job={selectedJob}
		oncancel={handleCancelJob}
		onretry={handleRetryJob}
		ondelete={handleDeleteJob}
	/>
{/if}
