<script lang="ts">
	import { IconDownload } from '@tabler/icons-svelte';
	import { Alert, AlertDescription } from '@/components/ui/alert';
	import { Button, buttonVariants } from '@/components/ui/button';
	import * as Dialog from '@/components/ui/dialog';
	import { Input } from '@/components/ui/input';
	import { Label } from '@/components/ui/label';
	import * as RadioGroup from '@/components/ui/radio-group';
	import * as Select from '@/components/ui/select';
	import Spinner from '@/components/ui/spinner/spinner.svelte';
	import { FileUpload } from '@/shared';
	import type { Printer } from '@/types/printer';
	import type { ModelFile } from '@/model';
	import { jobs, library, printers } from '@/api';
	import type { CreateJobInput } from '@/api/jobs';
	import GcodeProcessingOptions from './GcodeProcessingOptions.svelte';

	let {
		open = $bindable(false),
		printers: printersList = [],
		onsuccess,
		preselectedFile = null
	}: {
		open?: boolean;
		printers?: Printer[];
		onsuccess?: () => void;
		preselectedFile?: ModelFile | null;
	} = $props();

	let file = $state<File | null>(null);
	let displayName = $state('');
	let lastProcessedFileName = $state<string | null>(null); // Track last processed file to prevent infinite loops
	let assignedPrinter = $state<string>('null');
	let loopCount = $state(1);
	let cooldownTime = $state<string>('');
	let clearingMethod = $state<'actuator' | 'gcode'>('actuator');
	let processingOptions = $state<string[]>(['process_gcode']);
	let scheduleForLater = $state(false);
	let scheduledTime = $state<string>('');
	let scheduledTimeError = $state('');
	let error = $state('');

	// Printer type detection state
	let detectedPrinterType = $state<string | null>(null);
	let compatiblePrinters = $state<Printer[]>([]);
	let showPrinterWarning = $state(false);

	// New state for library tab
	let activeTab = $state<'upload' | 'library'>('upload');
	let selectedLibraryFile = $state<ModelFile | null>(null);

	// TanStack Query for library files
	const libraryQuery = library.useLibraryFiles({
		sort: 'date',
		order: 'desc'
	});

	// TanStack Query mutations
	const createMutation = jobs.useCreateJob();
	const detectTypeMutation = jobs.useDetectPrinterType();

	$effect(() => {
		if (open) {
			resetForm();
			// Handle preselected file from library
			if (preselectedFile) {
				activeTab = 'library';
				selectedLibraryFile = preselectedFile;
				displayName = preselectedFile.title || preselectedFile.file_name.replace(/\.3mf$/i, '');
			}
		}
	});

	function resetForm() {
		file = null;
		displayName = '';
		assignedPrinter = 'null';
		loopCount = 1;
		cooldownTime = '';
		clearingMethod = 'actuator';
		processingOptions = ['process_gcode'];
		scheduleForLater = false;
		scheduledTime = '';
		scheduledTimeError = '';
		error = '';
		activeTab = 'upload';
		selectedLibraryFile = null;
		detectedPrinterType = null;
		compatiblePrinters = [];
		showPrinterWarning = false;
	}

	/**
	 * Get the default scheduled time based on printer state
	 */
	function getDefaultScheduledTime(): string {
		const now = new Date();

		// Format current time as datetime-local (YYYY-MM-DDTHH:mm)
		const year = now.getFullYear();
		const month = String(now.getMonth() + 1).padStart(2, '0');
		const day = String(now.getDate()).padStart(2, '0');
		const hours = String(now.getHours()).padStart(2, '0');
		const minutes = String(now.getMinutes()).padStart(2, '0');

		return `${year}-${month}-${day}T${hours}:${minutes}`;
	}

	/**
	 * Validate scheduled time - must not be in the past
	 */
	function validateScheduledTime(timeStr: string): boolean {
		if (!timeStr) return true; // Optional field

		scheduledTimeError = '';
		const scheduled = new Date(timeStr);
		const now = new Date();

		if (scheduled <= now) {
			scheduledTimeError = 'Scheduled time must be in the future';
			return false;
		}

		return true;
	}

	// Update display name when file changes (side effect is intentional here)
	$effect(() => {
		if (file && !displayName) {
			displayName = file.name.replace(/\.3mf$/i, '');
		}

		// Detect printer type from uploaded file
		// Only process if we haven't already processed this specific file
		if (file && file.name !== lastProcessedFileName) {
			detectPrinterTypeFromUploadedFile(file);
			lastProcessedFileName = file.name;
		}
	});

	// Initialize scheduled time when schedule checkbox is enabled
	$effect(() => {
		if (scheduleForLater && !scheduledTime) {
			scheduledTime = getDefaultScheduledTime();
		}
	});

	// Automatically enable process_gcode when loop_count > 1
	$effect(() => {
		if (loopCount > 1 && !processingOptions.includes('process_gcode')) {
			processingOptions = [...processingOptions, 'process_gcode'];
		}
	});

	// Filter printers based on detected type and auto-select if single match
	$effect(() => {
		if (!printersList || printersList.length === 0) {
			compatiblePrinters = [];
			return;
		}

		if (!detectedPrinterType) {
			// No printer type detected - show all printers
			compatiblePrinters = printersList;
			return;
		}

		// Filter to only compatible printers
		const compatible = printersList.filter((p) => p.model_type === detectedPrinterType);
		compatiblePrinters = compatible;

		// Auto-select if only one compatible printer
		if (compatible.length === 1 && assignedPrinter === 'null') {
			assignedPrinter = String(compatible[0].id);
		}

		// Show warning if no compatible printers
		showPrinterWarning = compatible.length === 0;
	});

	async function detectPrinterTypeFromUploadedFile(file: File) {
		try {
			// Convert File to base64 string for serialization
			const arrayBuffer = await file.arrayBuffer();
			const uint8Array = new Uint8Array(arrayBuffer);

			// Convert Uint8Array to base64 without using spread (handles large files)
			let binary = '';
			const len = uint8Array.byteLength;
			for (let i = 0; i < len; i++) {
				binary += String.fromCharCode(uint8Array[i]);
			}
			const base64 = btoa(binary);

			const result = await detectTypeMutation.mutateAsync({
				fileDataBase64: base64,
				fileName: file.name
			});
			detectedPrinterType = result.printer_type;
		} catch (error) {
			console.error('Failed to detect printer type:', error);
			detectedPrinterType = null;
		}
	}

	function selectLibraryFile(modelFile: ModelFile) {
		selectedLibraryFile = modelFile;
		// Auto-populate display name from title or file name
		if (!displayName) {
			displayName = modelFile.title || modelFile.file_name.replace(/\.3mf$/i, '');
		}
		// Clear file from upload tab
		file = null;

		// Use printer type from library metadata
		detectedPrinterType = modelFile.printer_type || null;
	}

	function switchTab(tab: 'upload' | 'library') {
		activeTab = tab;
		if (tab === 'upload') {
			selectedLibraryFile = null;
		} else if (tab === 'library') {
			file = null;
		}
	}

	function formatFileSize(bytes: number): string {
		if (bytes === 0) return '0 B';
		const k = 1024;
		const sizes = ['B', 'KB', 'MB', 'GB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
	}

	function formatDate(date: Date | string): string {
		const d = new Date(date);
		return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
	}

	async function handleSubmit() {
		error = '';

		// Validate file selection
		if (!file && !selectedLibraryFile) {
			error = 'Please select a file';
			return;
		}

		// Check if compatible printers available
		if (detectedPrinterType && compatiblePrinters.length === 0) {
			error = `No compatible printers available (requires ${detectedPrinterType})`;
			return;
		}

		// Validate scheduled time if set
		if (scheduleForLater && scheduledTime) {
			if (!validateScheduledTime(scheduledTime)) {
				return;
			}
		}

		try {
			const input: CreateJobInput = {
				display_name: displayName,
				loop_count: loopCount,
				cooldown_time: cooldownTime ? parseInt(cooldownTime) : undefined,
				clearing_method: clearingMethod,
				processing_options: processingOptions,
				scheduled_at: scheduleForLater && scheduledTime ? new Date(scheduledTime) : undefined,
				assigned_printer_id:
					assignedPrinter !== 'null' ? parseInt(assignedPrinter) : undefined
			};

			// Handle file upload vs library selection
			if (file) {
				// Upload file and create job
				await createMutation.mutateAsync({
					...input,
					file
				});
			} else if (selectedLibraryFile) {
				// Create job from library file
				await createMutation.mutateAsync({
					...input,
					library_file_path: selectedLibraryFile.file_path
				});
			}

			open = false;
			onsuccess?.();
		} catch (err) {
			error = err instanceof Error ? err.message : 'Failed to create job';
		}
	}

	async function handleExportOnly() {
		if (!file && !selectedLibraryFile) {
			error = 'Please select a file to export';
			return;
		}

		error = '';

		try {
			let filePath: string;
			if (file) {
				// For uploaded files, save first
				const uploadResult = await library.useUploadModelFile().mutateAsync({ file });
				filePath = uploadResult.file_path;
			} else {
				filePath = selectedLibraryFile!.file_path;
			}

			const response = await fetch('/api/export', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					file_path: filePath,
					loop_count: loopCount,
					cooldown_time: cooldownTime ? parseInt(cooldownTime) : null,
					clearing_method: clearingMethod,
					processing_options: processingOptions
				})
			});

			if (!response.ok) throw new Error('Failed to export');
			const blob = await response.blob();
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = '';
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);

			open = false;
			onsuccess?.();
		} catch (err) {
			error = err instanceof Error ? err.message : 'Export failed';
		}
	}
</script>

<Dialog.Root
	{open}
	onOpenChange={(open) => {
		if (!createMutation.isPending) {
			open = open;
		}
	}}
>
	<Dialog.Content
		class="max-h-[90vh] w-[95vw] max-w-lg overflow-y-auto"
		oninteractoutside={(e: Event) => createMutation.isPending && e.preventDefault()}
	>
		<Dialog.Header>
			<Dialog.Title>Add New Job</Dialog.Title>
			<Dialog.Description>
				{activeTab === 'upload'
					? 'Upload a 3MF file and configure print settings'
					: 'Select a 3MF file from your library'}
			</Dialog.Description>
		</Dialog.Header>

		<div class="mb-6 flex gap-2 px-2 sm:px-0">
			<Button
				type="button"
				variant={activeTab === 'upload' ? 'default' : 'outline'}
				size="sm"
				onclick={() => switchTab('upload')}
				disabled={createMutation.isPending}
				class="flex-1 sm:flex-none"
			>
				Upload File
			</Button>
			<Button
				type="button"
				variant={activeTab === 'library' ? 'default' : 'outline'}
				size="sm"
				onclick={() => switchTab('library')}
				disabled={createMutation.isPending}
				class="flex-1 sm:flex-none"
			>
				Library
			</Button>
		</div>

		<form onsubmit={(e) => e.preventDefault()} class="space-y-6 px-2 sm:px-0">
			<!-- Upload Tab -->
			{#if activeTab === 'upload'}
				<div class="space-y-2">
					<Label for="file-upload">File</Label>
					<FileUpload bind:file disabled={createMutation.isPending} name="file" />
				</div>
			{/if}

			<!-- Library Tab -->
			{#if activeTab === 'library'}
				<div class="space-y-4">
					{#if libraryQuery.isLoading}
						<div class="flex items-center justify-center py-8">
							<Spinner />
						</div>
					{:else if libraryQuery.error}
						<Alert variant="destructive">
							<AlertDescription>{libraryQuery.error.message}</AlertDescription>
						</Alert>
						<Button
							type="button"
							variant="outline"
							onclick={() => libraryQuery.refetch()}
							disabled={createMutation.isPending}
						>
							Retry
						</Button>
					{:else if !libraryQuery.data || libraryQuery.data.length === 0}
						<div class="py-8 text-center">
							<p class="mb-4 text-sm text-muted-foreground">No files in library</p>
							<p class="text-xs text-muted-foreground">
								Upload a file using the Upload tab to get started
							</p>
						</div>
					{:else}
						<div
							class="max-h-48 space-y-2 overflow-y-auto rounded-md border p-2 sm:max-h-80 sm:p-3"
						>
							{#each libraryQuery.data as modelFile (modelFile.id)}
								<div
									class="flex cursor-pointer gap-2 rounded-md border p-2 transition-colors sm:gap-3 sm:p-3 {selectedLibraryFile?.id ===
									modelFile.id
										? 'border-primary bg-primary/5'
										: 'border-transparent hover:bg-muted'}"
									onclick={() => selectLibraryFile(modelFile)}
									role="button"
									tabindex="0"
									onkeydown={(e) => {
										if (e.key === 'Enter' || e.key === ' ') {
											e.preventDefault();
											selectLibraryFile(modelFile);
										}
									}}
								>
									<!-- Thumbnail -->
									<div
										class="h-12 w-12 flex-shrink-0 overflow-hidden rounded-md bg-muted sm:h-16 sm:w-16"
									>
										{#if modelFile.thumbnail_data}
											<img
												src={modelFile.thumbnail_data}
												alt={modelFile.file_name}
												class="h-full w-full object-cover"
											/>
										{:else}
											<div
												class="flex h-full w-full items-center justify-center text-xs text-muted-foreground"
											>
												No thumbnail
											</div>
										{/if}
									</div>

									<!-- File Info -->
									<div class="min-w-0 flex-1">
										<p class="truncate text-xs font-medium sm:text-sm">
											{modelFile.title || modelFile.file_name}
										</p>
										<p class="line-clamp-2 text-xs text-muted-foreground">
											{formatFileSize(modelFile.file_size)} · {formatDate(modelFile.uploaded_at)}
										</p>
										{#if modelFile.width && modelFile.height && modelFile.depth}
											<p class="text-xs text-muted-foreground">
												{Math.round(modelFile.width)}x{Math.round(modelFile.height)}x{Math.round(
													modelFile.depth
												)}mm
											</p>
										{/if}
										{#if modelFile.print_time_estimate}
											<p class="text-xs text-muted-foreground">
												Est. {Math.round(modelFile.print_time_estimate / 60)} min
											</p>
										{/if}
									</div>
								</div>
							{/each}
						</div>
					{/if}
				</div>
			{/if}

			<div class="space-y-2">
				<Label for="display-name">Display Name</Label>
				<Input
					id="display-name"
					bind:value={displayName}
					disabled={createMutation.isPending}
					placeholder="Job name"
				/>
			</div>

			<div class="space-y-2">
				<Label for="printer">
					Assign to Printer
					{#if detectedPrinterType}
						<span class="ml-2 text-xs font-normal text-muted-foreground">
							(Detected: {detectedPrinterType})
						</span>
					{/if}
				</Label>

				{#if showPrinterWarning}
					<Alert variant="destructive">
						<AlertDescription>
							No compatible printers found for this file (requires {detectedPrinterType}).
						</AlertDescription>
					</Alert>
				{:else if detectedPrinterType && compatiblePrinters.length > 0}
					<!-- Printer type detected - show only compatible printers -->
					<Select.Root
						bind:value={assignedPrinter}
						disabled={createMutation.isPending || compatiblePrinters.length === 1}
					>
						<Select.Trigger>
							<span class="data-[placeholder]:text-muted-foreground" slot="value">
								{compatiblePrinters.length === 1
									? compatiblePrinters[0].name + ' (Auto-selected)'
									: 'Select compatible printer'}
							</span>
						</Select.Trigger>
						<Select.Content>
							{#each compatiblePrinters as printer (printer.id)}
								<Select.Item value={String(printer.id)}
									>{printer.name} ({printer.model_type})</Select.Item
								>
							{/each}
						</Select.Content>
					</Select.Root>
				{:else}
					<!-- No printer type detected - show all printers -->
					<Select.Root bind:value={assignedPrinter} disabled={createMutation.isPending}>
						<Select.Trigger>
							<span class="data-[placeholder]:text-muted-foreground" slot="value">
								Any Available Printer
							</span>
						</Select.Trigger>
						<Select.Content>
							<Select.Item value="null">Any Available Printer</Select.Item>
							{#each printersList as printer (printer.id)}
								<Select.Item value={String(printer.id)}>{printer.name}</Select.Item>
							{/each}
						</Select.Content>
					</Select.Root>
				{/if}

				{#if detectedPrinterType && compatiblePrinters.length > 1}
					<p class="text-xs text-muted-foreground">
						{compatiblePrinters.length} compatible printer{compatiblePrinters.length === 1
							? ''
							: 's'} available
					</p>
				{/if}
			</div>

			<div class="space-y-2">
				<Label for="loop-count">Loop Count</Label>
				<Input
					id="loop-count"
					type="number"
					bind:value={loopCount}
					min="1"
					max="100"
					disabled={createMutation.isPending}
				/>
				<p class="text-xs text-muted-foreground">Number of times to repeat this print (1-100)</p>
			</div>

			<div class="space-y-2">
				<Label for="cooldown-time">Cooldown Time (seconds)</Label>
				<Input
					id="cooldown-time"
					type="number"
					bind:value={cooldownTime}
					min="0"
					disabled={createMutation.isPending}
					placeholder="Use default (300s)"
				/>
				<p class="text-xs text-muted-foreground">
					Time to wait after print before clearing (leave empty for default)
				</p>
			</div>

			<fieldset class="space-y-4">
				<legend class="text-sm font-medium">Schedule for Later</legend>
				<div class="flex items-center space-x-2">
					<input
						type="checkbox"
						id="schedule-for-later"
						bind:checked={scheduleForLater}
						disabled={createMutation.isPending}
						class="h-4 w-4 rounded border-input"
					/>
					<Label for="schedule-for-later" class="font-normal">
						Queue this job for later manual start
					</Label>
				</div>

				{#if scheduleForLater}
					<div class="ml-6 space-y-2">
						<Label for="scheduled-time">Scheduled Start Time</Label>
						<Input
							id="scheduled-time"
							type="datetime-local"
							bind:value={scheduledTime}
							disabled={createMutation.isPending}
							onchange={() => validateScheduledTime(scheduledTime)}
							placeholder={getDefaultScheduledTime()}
						/>
						{#if scheduledTimeError}
							<p class="text-xs text-destructive">{scheduledTimeError}</p>
						{/if}
						<p class="text-xs text-muted-foreground">
							This job will be marked as pending until this time is reached
						</p>
					</div>
				{/if}
			</fieldset>

			<fieldset class="space-y-4">
				<legend class="text-sm font-medium">Clearing Method</legend>
				<RadioGroup.Root bind:value={clearingMethod} disabled={createMutation.isPending}>
					<div class="flex items-center space-x-2">
						<RadioGroup.Item value="actuator" id="actuator" />
						<Label for="actuator" class="font-normal">GPIO Actuator (physical bed clearing)</Label>
					</div>
					<div class="flex items-center space-x-2">
						<RadioGroup.Item value="gcode" id="gcode" />
						<Label for="gcode" class="font-normal">G-code only (custom clearing G-code)</Label>
					</div>
				</RadioGroup.Root>
			</fieldset>

			<GcodeProcessingOptions
				bind:selectedOptions={processingOptions}
				disabled={createMutation.isPending}
				{loopCount}
			/>

			{#if error}
				<Alert variant="destructive">
					<AlertDescription>{error}</AlertDescription>
				</Alert>
			{/if}

			<Dialog.Footer class="flex flex-col-reverse gap-2 sm:flex-row">
				<Dialog.Close
					class={buttonVariants({ variant: 'outline' })}
					disabled={createMutation.isPending}
				>
					Cancel
				</Dialog.Close>
				<Button
					type="button"
					variant="outline"
					onclick={handleExportOnly}
					disabled={createMutation.isPending || (!file && !selectedLibraryFile)}
					class="w-full sm:w-auto"
				>
					<IconDownload class="mr-2 h-4 w-4" />
					Export Only
				</Button>
				<Button
					type="button"
					onclick={handleSubmit}
					disabled={createMutation.isPending || (!file && !selectedLibraryFile)}
					class="w-full sm:w-auto"
				>
					{createMutation.isPending ? 'Adding...' : 'Add Job'}
				</Button>
			</Dialog.Footer>
		</form>
	</Dialog.Content>
</Dialog.Root>
